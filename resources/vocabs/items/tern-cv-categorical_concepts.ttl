<https://linked.data.gov.au/def/tern-cv/070dc685-5a1e-48b6-afd6-61df35b924df>
    a skos:Concept ;
    dcterms:created "2024-09-26"^^xsd:date ;
    dcterms:description "Coarse-grained banded crystalline rock formed during high-grade regional metamorphism; most have a granitic composition with minerals separating into schistose bands of micas and amphiboles and granulose bands of quartz and feldspar." ;
