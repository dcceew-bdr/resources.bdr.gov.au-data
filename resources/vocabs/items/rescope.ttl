PREFIX : <https://linked.data.gov.au/dataset/bdr/rescope/>
PREFIX cs: <https://linked.data.gov.au/dataset/bdr/rescope>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:abis
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Resources scoped to the Australian Biodiversity Information Standard"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ABIS"@en ;
    skos:topConceptOf cs: ;
.

:bdr
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Resources scoped to the Biodiversity Data Repository"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "BDR"@en ;
    skos:topConceptOf cs: ;
.

:national
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Resources of national scope, not specifically for the BDR or ABIS"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "National"@en ;
    skos:topConceptOf cs: ;
.

:tern
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Resources created by TERN for general use"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "TERN"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition "A vocabulary of the scope that a resource in the BDR's resources.bdr.gov.au catalogue has"@en ;
    skos:hasTopConcept
        :abis ,
        :bdr ,
        :national ,
        :tern ;
    skos:historyNote "This vocabulary was developed to assist organising the BDR catalogues at resources.bdr.gov.au" ;
    skos:prefLabel "BDR Resources Scope"@en ;
    schema:creator <https://linked.data.gov.au/org/dcceew> ;
    schema:dateCreated "2026-08-31"^^xsd:date ;
    schema:dateModified "2026-09-03"^^xsd:date ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:publisher <https://linked.data.gov.au/org/dcceew> ;
    schema:version "2" ;
.
