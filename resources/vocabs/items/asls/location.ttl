    skos:topConceptOf cs: ;
.

:easting-northing-zone
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition """Record easting and northing UTM projected coordinates, when reading from a topographic map. Give a 6-figure easting, a 7-figure northing and a 2-figure grid zone (49–56 in Australia), to as high a degree of accuracy as map scale permits. Location of the central point of a site on a map is unlikely to be much more accurate than 1 mm on the map, that is, 10 m on a 1:10 000 scale map, or 100 m on a 1:100 000 scale map. Example:
Zone  Easting	Northing
55	692084	6094905"""@en ;
    skos:prefLabel "Easting, northing, zone"@en ;
    skos:topConceptOf cs: ;
.

:film-number
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Film number on photo"@en ;
    skos:prefLabel "Film number on photo"@en ;
    skos:topConceptOf cs: ;
.

:frame-number
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "number of individual photo"@en ;
    skos:prefLabel "number of individual photo"@en ;
    skos:topConceptOf cs: ;
.

:gps-method-D
    a
        skos:Concept ,
        sosa:Procedure ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Differential GPS"@en ;
    skos:notation "D" ;
    skos:prefLabel "Differential GPS"@en ;
    skos:topConceptOf cs: ;
.

:gps-method-S
    a
        skos:Concept ,
        sosa:Procedure ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Single unit GPS"@en ;
    skos:notation "S" ;
    skos:prefLabel "Single unit GPS"@en ;
    skos:topConceptOf cs: ;
.

:latitude-longitude
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition """Coordinates may be given in degrees, minutes and seconds (DMS) where a location is read from a small-scale (regional) map. When locating with a GPS, record the coordinates in decimal degrees (DD) to five places to obtain a precision to the metre. Latitudes (giving the north/south part of the coordinate) will be negative in Australia.
Example:
Latitude	Longitude
–35.27058	149.11181"""@en ;
    skos:prefLabel "Latitude, longitude"@en ;
    skos:topConceptOf cs: ;
.

:map-sheet
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition """Give number and name on map, for example:
Map scale	 8	7	6
Map sheet number 	SH 50-15	8525	8727-III
Map sheet name	Kellerberrin	Kosciuszko	Canberra."""@en ;
    skos:prefLabel "Map sheet"@en ;
    skos:topConceptOf cs: ;
.

:method-G
    a
        skos:Concept ,
        sosa:Procedure ;
    rdfs:isDefinedBy cs: ;
    skos:definition "GPS"@en ;
    skos:notation "G" ;
    skos:prefLabel "GPS"@en ;
    skos:topConceptOf cs: ;
.

:method-R
    a
        skos:Concept ,
        sosa:Procedure ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Map reference"@en ;
    skos:notation "R" ;
    skos:prefLabel "Map reference"@en ;
    skos:topConceptOf cs: ;
.

:method-S
    a
        skos:Concept ,
        sosa:Procedure ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Survey"@en ;
    skos:notation "S" ;
    skos:prefLabel "Survey"@en ;
    skos:topConceptOf cs: ;
.

:projection-L
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "When using a GPS or a regional map, record coordinates in latitude and longitude. Record southern hemisphere latitudes as negative. "@en ;
    skos:notation "L" ;
    skos:prefLabel "Geographic (latitude and longitude)"@en ;
    skos:topConceptOf cs: ;
.

:projection-M
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Most topographic map sheets are projected onto the Universal Transverse Mercator (UTM) coordinate system. In Australia, this will be called the Australian Map Grid (AMG) or the Map Grid of Australia (MGA) depending on the datum used. The easting and northing coordinates taken from these sheets will have 6 digits and 7 digits respectively. The zone will also be required (49-56 in Australia). Do not use the Universal Grid Reference notation.3 "@en ;
    skos:notation "M" ;
    skos:prefLabel "Projected by Universal Transverse Mercator system"@en ;
    skos:topConceptOf cs: ;
.

:run-number
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "number of run"@en ;
    skos:prefLabel "number of run"@en ;
    skos:topConceptOf cs: ;
.

