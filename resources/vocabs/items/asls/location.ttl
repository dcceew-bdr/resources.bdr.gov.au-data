    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Australian Geodetic Datum 1966"@en ;
    skos:notation "AGD66" ;
    skos:prefLabel "Australian Geodetic Datum 1966"@en ;
    skos:topConceptOf cs: ;
.

