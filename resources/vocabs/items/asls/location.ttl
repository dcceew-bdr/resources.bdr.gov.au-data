    skos:notation "4" ;
    skos:prefLabel "1:10 000"@en ;
.

:scale-5
    a skos:Concept ;
    skos:notation "5" ;
    skos:prefLabel "1:25 000"@en ;
.

:scale-6
    a skos:Concept ;
    skos:notation "6" ;
    skos:prefLabel "1:50 000"@en ;
.

:scale-7
    a skos:Concept ;
    skos:notation "7" ;
    skos:prefLabel "1:100 000"@en ;
.

:scale-8
    a skos:Concept ;
    skos:notation "8" ;
    skos:prefLabel "1:250 000"@en ;
.

:site-reference
    a skos:Concept ;
    skos:prefLabel "east (mm), north (mm)"@en ;
.

