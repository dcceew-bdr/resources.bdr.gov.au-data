:accuracy-1
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "<1 m"@en ;
    skos:notation "1" ;
    skos:prefLabel "<1 m"@en ;
    skos:topConceptOf cs: ;
.

:accuracy-2
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "1-5 m"@en ;
    skos:notation "2" ;
    skos:prefLabel "1-5 m"@en ;
    skos:topConceptOf cs: ;
.

:accuracy-3
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "5-15 m"@en ;
    skos:notation "3" ;
    skos:prefLabel "5-15 m"@en ;
    skos:topConceptOf cs: ;
.

:accuracy-4
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "15-30 m"@en ;
    skos:notation "4" ;
    skos:prefLabel "15-30 m"@en ;
    skos:topConceptOf cs: ;
.

:accuracy-5
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition ">30 m"@en ;
    skos:notation "5" ;
    skos:prefLabel ">30 m"@en ;
    skos:topConceptOf cs: ;
.

