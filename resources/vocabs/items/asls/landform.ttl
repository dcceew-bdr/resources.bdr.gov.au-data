        :landform-element-HSL ;
    skos:prefLabel "Typical elements of Escarpment"@en ;
    skos:related :landform-pattern-ESC ;
.

:landform-pattern-KAR
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-KAR-common-elements ,
        :landform-pattern-KAR-occasional-elements ,
        :landform-pattern-KAR-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """landform pattern of unspecified relief and slope (for specification use the terms in Table 4, for example ‘Karst rolling hills’) typically with fixed, deep, erosional stream channels forming a non-directional, disintegrated tributary pattern and many closed depressions without stream channels. It is eroded by continuously active solution and rarely active collapse, the products being removed through underground channels. 
Typical elements: hillcrest, hillslope (dominant), doline.
Common elements: summit surface, valley flat, plain, alcove, drainage depression, stream channel, scarp, footslope, landslide.
Occasional element: talus."""@en ;
    skos:inScheme cs: ;
    skos:notation "KAR" ;
    skos:prefLabel "Karst"@en ;
    skos:topConceptOf cs: ;
.

