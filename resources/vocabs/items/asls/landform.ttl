    skos:inScheme cs: ;
    skos:member
        :landform-element-DUN ,
        :landform-element-STC ;
    skos:prefLabel "Occasional elements of Marine plain"@en ;
    skos:related :landform-pattern-MAR ;
.

:landform-pattern-MOU-occasional-elements
