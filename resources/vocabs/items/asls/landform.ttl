:slope
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Always observe and record the slope as precisely as the chosen survey method permits. The observation should span no less than 20 m so as not to be influenced too much by features of the microrelief that occurs within the landform element."@en ;
    skos:inScheme cs: ;
    skos:member
        :Slope-class ,
        :Slope-procedure ,
        :slope-value ;
    skos:prefLabel "Slope of landform element - enumeration"@en ;
.

:slope-class-CL
    a
        skos:Concept ,
        :Slope-class ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A slope tangent boundary of > 300% (72°) with average slope 500% (80°)"@en ;
    skos:inScheme cs: ;
    skos:notation "CL" ;
    skos:prefLabel "Cliffed"@en ;
    skos:topConceptOf cs: ;
.

