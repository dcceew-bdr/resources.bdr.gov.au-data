        :landform-element-PED ,
        :landform-element-PLA ,
        :landform-element-STB ;
    skos:prefLabel "Typical elements of Pediment"@en ;
    skos:related :landform-pattern-PED ;
.

:landform-pattern-PNP-typical-elements
    a skos:Collection ;
