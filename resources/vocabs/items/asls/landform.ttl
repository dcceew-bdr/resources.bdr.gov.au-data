:element-dimension-height
    a
        skos:Concept ,
        :element-dimensions ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Depth of landform element"@en ;
    skos:definition "difference in elevation between the upper and lower margins of the element, measured along any slope line. Height can mean quite different things and must be carefully defined. For crests, ridges and hillocks, define the upper margin as the point where the selected slope line coalesces with others to form the ridge line. For depressions, define the lower margin as the point where the selected slope line coalesces with others to form the course line."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Height of landform element"@en ;
    skos:topConceptOf cs: ;
.

:element-dimension-length
    a
        skos:Concept ,
        :element-dimensions ;
    rdfs:isDefinedBy cs: ;
    skos:definition "horizontal distance between the upper and lower margins of the element, measured down a slope line. For crests, the slope line to be used is the ridge line; for depressions, the course line (see Figure 2a). By this definition, many crests and open depressions become very long."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Length of landform element"@en ;
    skos:topConceptOf cs: ;
.

:element-dimension-width
    a
        skos:Concept ,
        :element-dimensions ;
    rdfs:isDefinedBy cs: ;
    skos:definition "horizontal distance between the lateral margins of the element, measured perpendicularly to the length."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Width of landform element"@en ;
    skos:topConceptOf cs: ;
.

