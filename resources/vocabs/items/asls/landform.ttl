    skos:broader :morphological-type-F ;
    skos:definition "small flat aggraded or eroded by channelled or over-bank stream flow, standing above a scarp and no longer frequently inundated; a former valley flat or part of a former flood plain."@en ;
    skos:inScheme cs: ;
    skos:notation "TEF" ;
    skos:prefLabel "Terrace flat"@en ;
