    skos:prefLabel "Typical elements of Rises"@en ;
    skos:related :landform-pattern-RIS ;
.

:landform-pattern-STA-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Stagnant alluvial plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAR ,
        :landform-element-BKP ,
        :landform-element-LEV ,
        :landform-element-SCR ,
        :landform-element-SWP ;
    skos:prefLabel "Common elements of Stagnant alluvial plain"@en ;
    skos:related :landform-pattern-STA ;
.

:landform-pattern-TEL-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Terraced land"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-SCA ,
        :landform-element-SRP ,
        :landform-element-STC ,
        :landform-element-TEF ,
        :landform-element-TEP ;
    skos:prefLabel "Typical elements of Terraced land"@en ;
    skos:related :landform-pattern-TEL ;
.

:landform-pattern-TER
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-TER-occasional-elements ,
        :landform-pattern-TER-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """former flood plain on which erosion and aggradation by channelled and over-bank stream flow is barely active or inactive because deepening or enlargement of the stream channel has lowered the level of flooding. A pattern that has both a former flood plain and a significant, active flood plain, or that has former flood plains at more than one level, becomes terraced land. 
Typical elements: terrace plain (dominant), scarp, channel bench.
Occasional elements: stream channel, scroll, levee."""@en ;
    skos:inScheme cs: ;
    skos:notation "TER" ;
    skos:prefLabel "Terrace (alluvial)"@en ;
    skos:topConceptOf cs: ;
.

:Channel-directionality
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This attribute combines two simpler attributes: the degree of lineation, that is, the degree to which the channels tend to align in an organised way; and the degree of convergence or divergence of channels in the downstream direction. The latter is distinct from tributary/distributary behaviour, which refers to the combining and splitting of stream channels, rather than their directionality."@en ;
    skos:inScheme cs: ;
    skos:member
        :stream-channel-network-directionality-B ,
        :stream-channel-network-directionality-C ,
        :stream-channel-network-directionality-D ,
        :stream-channel-network-directionality-F ,
        :stream-channel-network-directionality-N ,
        :stream-channel-network-directionality-P ,
        :stream-channel-network-directionality-U ;
    skos:prefLabel "Stream channel network directionality - enumeration"@en ;
.

:landform-element-ALC
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-ESC-common-elements ,
        :landform-pattern-HIL-common-elements ,
        :landform-pattern-KAR-common-elements ,
        :landform-pattern-LOW-common-elements ,
        :landform-pattern-MOU-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-V ;
    skos:definition "moderately inclined to very steep, short open depression with concave cross-section, eroded by collapse, landslides, creep or surface wash."@en ;
    skos:inScheme cs: ;
    skos:notation "ALC" ;
    skos:prefLabel "Alcove"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-BRI
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-BEA-typical-elements ,
        :landform-pattern-CHE-typical-elements ,
        :landform-pattern-COR-common-elements ,
        :landform-pattern-DEL-common-elements ,
        :landform-pattern-TID-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-R ;
    skos:definition "very long, nearly straight, low ridge, built up by waves and usually modified by wind. A beach ridge is often a relict feature remote from the beach."@en ;
    skos:inScheme cs: ;
    skos:notation "BRI" ;
    skos:prefLabel "Beach ridge"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DDE
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-HIL-typical-elements ,
        :landform-pattern-KAR-common-elements ,
        :landform-pattern-LOW-typical-elements ,
        :landform-pattern-PLT-common-elements ,
        :landform-pattern-RIS-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-V ;
    skos:definition "level to gently inclined, long, narrow, shallow open depression with smoothly concave cross-section, rising to moderately inclined side slopes, eroded or aggraded by sheet wash."@en ;
    skos:inScheme cs: ;
    skos:notation "DDE" ;
    skos:prefLabel "Drainage depression"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-EMB
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MAD-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader
        :morphological-type-L ,
        :morphological-type-M ,
        :morphological-type-R ,
        :morphological-type-S ,
        :morphological-type-U ;
    skos:definition "ridge or slope built up by human activity."@en ;
    skos:inScheme cs: ;
    skos:notation "EMB" ;
    skos:prefLabel "Embankment"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-SUS
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-BAD-occasional-elements ,
        :landform-pattern-HIL-occasional-elements ,
        :landform-pattern-KAR-common-elements ,
        :landform-pattern-LOW-occasional-elements ,
        :landform-pattern-PLT-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-C ;
    skos:definition "very wide, level to gently inclined crest with abrupt margins, commonly eroded by water-aided mass movement or sheet wash."@en ;
    skos:inScheme cs: ;
    skos:notation "SUS" ;
    skos:prefLabel "Summit surface"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-SWL
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-BEA-typical-elements ,
        :landform-pattern-DEL-common-elements ,
        :landform-pattern-DUN-typical-elements ,
        :landform-pattern-LON-typical-elements ,
        :landform-pattern-PAR-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-V ;
    skos:definition "(i) linear, level-floored open depression excavated by wind, or left relict between ridges built up by wind or waves, or built up to a lesser height than them. (ii) long, curved open or closed depression left relict between scrolls built up by channelled stream flow."@en ;
    skos:inScheme cs: ;
    skos:notation "SWL" ;
    skos:prefLabel "Swale"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-VLF
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-HIL-common-elements ,
        :landform-pattern-KAR-common-elements ,
        :landform-pattern-LOW-common-elements ,
        :landform-pattern-MOU-common-elements ,
        :landform-pattern-RIS-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "small, gently inclined to level flat, aggraded or sometimes eroded by channelled or over-bank stream flow, typically enclosed by hillslopes; a miniature alluvial plain landform pattern."@en ;
    skos:inScheme cs: ;
    skos:notation "VLF" ;
    skos:prefLabel "Valley flat"@en ;
    skos:topConceptOf cs: ;
.

