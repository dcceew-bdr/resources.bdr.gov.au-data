    skos:member
        :landform-element-PLA ,
        :landform-element-STC ;
    skos:prefLabel "Typical elements of Peneplain"@en ;
    skos:related :landform-pattern-PNP ;
.

:landform-pattern-RIS-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Rises"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-STC ,
        :landform-element-VLF ;
    skos:prefLabel "Common elements of Rises"@en ;
    skos:related :landform-pattern-RIS ;
.

:landform-pattern-SAN
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-SAN-occasional-elements ,
        :landform-pattern-SAN-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level to gently undulating landform pattern of extremely low relief and without channels; formed possibly by sheet flow or stream flow, but now relict and modified by wind action. 
Typical element: plain.
Occasional elements: dune, playa, lunette."""@en ;
    skos:inScheme cs: ;
    skos:notation "SAN" ;
    skos:prefLabel "Sand plain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-SHF-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Sheet-flood fan"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-PLA ,
        :landform-element-STB ;
    skos:prefLabel "Typical elements of Sheet-flood fan"@en ;
    skos:related :landform-pattern-SHF ;
.

:landform-pattern-TEL-occasional-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Occasional elements of Terraced land"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-LEV ,
        :landform-element-SCR ;
    skos:prefLabel "Occasional elements of Terraced land"@en ;
    skos:related :landform-pattern-TEL ;
.

:landform-pattern-TID
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-TID-occasional-elements ,
        :landform-pattern-TID-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level landform pattern with extremely low relief and slowly migrating, deep alluvial stream channels, which form non-directional, integrated tributary patterns; it is aggraded by frequently active tides. 
Typical elements: plain (dominant), intertidal flat, supratidal flat, stream channel.
Occasional elements: lagoon, dune, beach ridge, beach."""@en ;
    skos:inScheme cs: ;
    skos:notation "TID" ;
    skos:prefLabel "Tidal flat (pattern)"@en ;
    skos:related :relief-class-P ;
    skos:topConceptOf cs: ;
.

:landform-pattern-VOL-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Volcano"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-CON ,
        :landform-element-CRA ;
    skos:prefLabel "Typical elements of Volcano"@en ;
    skos:related :landform-pattern-VOL ;
.

:Channel-depth-width
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition """Channel depth and width refer to the dimensions of a landform that is dominated by channelled stream flow. The limit of channelled stream flow dominance must be identified before width or depth can be estimated. Depth is taken from the top of the stream bank down to the average height of the line following the deepest part of the channel.
The distinction between stream bank and hillslope or scarp according to dominant process requires particular care where streams are incised, especially if they are cut into terraces that could be mistaken for flood plains.
 
For detailed studies, keep records of width and depth measurements. In other surveys, use the following classes of relative depth."""@en ;
    skos:inScheme cs: ;
    skos:member
        :stream-channel-relative-depth-width-D ,
        :stream-channel-relative-depth-width-M ,
        :stream-channel-relative-depth-width-S ,
        :stream-channel-relative-depth-width-V ;
    skos:prefLabel "Stream channel depth relative to width - enumeration"@en ;
.

:Channel-development
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The degree of development of stream channels."@en ;
    skos:inScheme cs: ;
    skos:member
        :stream-channel-development-A ,
        :stream-channel-development-E ,
        :stream-channel-development-I ,
        :stream-channel-development-O ;
    skos:prefLabel "Stream channel development - enumeration"@en ;
.

:Channel-pattern
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "In a traverse downstream, it may happen that tributaries enter the stream at frequent intervals, or that the stream splits into distributaries, or that these tendencies are absent (the non-tributary case) or are in balance with each other (the braided or anastomotic case called here reticulated) giving four classes of stream-wise channel pattern."@en ;
    skos:inScheme cs: ;
    skos:member
        :streamwise-channel-pattern-D ,
        :streamwise-channel-pattern-N ,
        :streamwise-channel-pattern-R ,
        :streamwise-channel-pattern-T ;
    skos:prefLabel "Stream-wise channel pattern - enumeration"@en ;
.

:Geomorphology-agent-precipitation
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Geomorphological agents - precipitation - enumeration"@en ;
    skos:inScheme cs: ;
    skos:member
        :geomorphological-agent-SH ,
        :geomorphological-agent-SM ,
        :geomorphological-agent-SO ,
        :geomorphological-agent-WM ;
    skos:prefLabel "Geomorphological agents - precipitation - enumeration"@en ;
.

:Relative-inclination
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Although lower slopes are often gentler than upper slopes, they need not be so (Figure 1i). A separate morphological attribute expresses the relative inclination of adjacent landform elements in a toposequence."@en ;
    skos:inScheme cs: ;
    skos:member
        :relative-inclination-of-slope-elements-A ,
        :relative-inclination-of-slope-elements-I ,
        :relative-inclination-of-slope-elements-N ,
        :relative-inclination-of-slope-elements-X ;
    skos:prefLabel "Relative inclination of slope elements - enumeration"@en ;
.

:Slope-procedure
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Means of evaluation of slope"@en ;
    skos:inScheme cs: ;
    skos:member
        :slope-evaluation-A ,
        :slope-evaluation-E ,
        :slope-evaluation-P ,
        :slope-evaluation-T ;
    skos:prefLabel "Means of evaluation of slope - enumeration"@en ;
.

:landform-element-CFS
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-ESC-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader
        :morphological-type-L ,
        :morphological-type-M ;
    skos:definition "slope situated below a cliff, with its contours generally parallel to the line of the cliff, eroded by sheet wash or water-aided mass movement, and aggraded locally by collapsed material from above."@en ;
    skos:inScheme cs: ;
    skos:notation "CFS" ;
    skos:prefLabel "Cliff-footslope"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-CIR
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MOU-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader
        :morphological-type-D ,
        :morphological-type-V ;
    skos:definition "precipitous to gently inclined, typically closed depression of concave contour and profile excavated by ice. The closed part of the depression may be shallow, the larger part being an open depression like an alcove."@en ;
    skos:inScheme cs: ;
    skos:notation "CIR" ;
    skos:prefLabel "Cirque"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-CON
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-CAL-occasional-elements ,
        :landform-pattern-VOL-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-H ;
    skos:definition "hillock with a circular symmetry built up by volcanism. The crest may form a ring around a crater."@en ;
    skos:inScheme cs: ;
    skos:notation "CON" ;
    skos:prefLabel "Cone (volcanic)"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-CRA
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MET-typical-elements ,
        :landform-pattern-VOL-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "steep to precipitous closed depression excavated by explosions due to vulcanism, human action, or impact of an extraterrestrial object."@en ;
    skos:inScheme cs: ;
    skos:notation "CRA" ;
    skos:prefLabel "Crater"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-FOR
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-BEA-common-elements ,
        :landform-pattern-CHE-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-R ;
    skos:definition "very long, nearly straight, moderately inclined to very steep ridge built up by the wind from material from an adjacent beach."@en ;
    skos:inScheme cs: ;
    skos:notation "FOR" ;
    skos:prefLabel "Foredune"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-ITF
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-TID-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "large flat subject to inundation by water that is usually salt or brackish, aggraded by tides. An intertidal flat (ITF) is frequently inundated."@en ;
    skos:inScheme cs: ;
    skos:notation "ITF" ;
    skos:prefLabel "Intertidal flat"@en ;
    skos:related :landform-element-TDF ;
    skos:topConceptOf cs: ;
.

:landform-element-LUN
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-PLY-typical-elements ,
        :landform-pattern-SAN-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-R ;
    skos:definition "elongated, gently curved, low ridge built up by wind on the margin of a playa, typically with a moderate, wave-modified slope towards the playa and a gentle outer slope."@en ;
    skos:inScheme cs: ;
    skos:notation "LUN" ;
    skos:prefLabel "Lunette"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-PED
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-PED-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader
        :morphological-type-F ,
        :morphological-type-L ;
    skos:definition "large, gently inclined to level (<1%) waning lower slope, with slope lines inclined in a single direction, or somewhat convergent or divergent, eroded or sometimes slightly aggraded by sheet flow (cf. footslope). It is underlain by bedrock."@en ;
    skos:inScheme cs: ;
    skos:notation "PED" ;
    skos:prefLabel "Pediment"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-PLY
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-PLY-typical-elements ,
        :landform-pattern-SAN-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Pan"@en ;
    skos:broader :morphological-type-D ;
    skos:definition "large, shallow, level-floored closed depression, intermittently water-filled, but mainly dry due to evaporation, bounded as a rule by flats aggraded by sheet flow and channelled stream flow."@en ;
    skos:inScheme cs: ;
    skos:notation "PLY" ;
    skos:prefLabel "Playa"@en ;
    skos:topConceptOf cs: ;
.

