:simple-erosional-landform-pattern-B
    a
        skos:Concept ,
        :Landform-pattern-erosional ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The Badlands simple erosional landform pattern is defined by various combinations of high slope values and low relief values. These combinations imply extremely close spacing of streams or valleys. Specifically, if one assumes a sawtooth terrain profile, the valley spacing implied is less than 100 m in areas with 50 m relief and less than 30 m in areas with 5 m relief; these values appear to accord with usage."@en ;
    skos:inScheme cs: ;
    skos:notation "B" ;
    skos:prefLabel "Badlands (simple erosional pattern)"@en ;
    skos:related :landform-pattern-BAD ;
    skos:topConceptOf cs: ;
.

:simple-erosional-landform-pattern-GP
    a
        skos:Concept ,
        :Landform-pattern-erosional ;
    rdfs:isDefinedBy cs: ;
    skos:definition """<p>Gently undulating plain is a simple type of erosional landform pattern characterised by Extremely low relief and Very gently inclined modal slope.</p>
<p>Relief is Extremely low < 9m (~5m)</p>
<p>Modal terrain slope is Very gently inclined 1-3% (~2%)</p>"""@en ;
    skos:inScheme cs: ;
    skos:notation "GP" ;
    skos:prefLabel "Gently undulating plain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:simple-erosional-landform-pattern-GR
    a
        skos:Concept ,
        :Landform-pattern-erosional ;
    rdfs:isDefinedBy cs: ;
    skos:definition """<p>Gently undulating rises is a simple type of erosional landform pattern characterised by Very low relief and Very gently inclined modal slope.</p>
<p>Relief is Very low < 9-30m (~15m)</p>
<p>Modal terrain slope is Very gently inclined 1-3% (~2%)</p>"""@en ;
    skos:inScheme cs: ;
    skos:notation "GR" ;
    skos:prefLabel "Gently undulating rises"@en ;
    skos:related
        :relief-class-R ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:simple-erosional-landform-pattern-LP
    a
        skos:Concept ,
        :Landform-pattern-erosional ;
    rdfs:isDefinedBy cs: ;
    skos:definition """<p>Level plain is a simple type of erosional landform pattern characterised by Extremely low relief and Level modal slope.</p>
<p>Relief is Extremely low < 9m (~5m)</p>
<p>Modal terrain slope is Level < 1% (~1:300)</p>"""@en ;
    skos:inScheme cs: ;
    skos:notation "LP" ;
    skos:prefLabel "Level plain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ;
    skos:topConceptOf cs: ;
.

:simple-erosional-landform-pattern-PH
    a
        skos:Concept ,
        :Landform-pattern-erosional ;
    rdfs:isDefinedBy cs: ;
    skos:definition """<p>Precipitous hills is a simple type of erosional landform pattern characterised by High relief and Precipitous modal slope.</p>
<p>Relief is High 90-300m (~150m)</p>
<p>Modal terrain slope is Precipitous >100% (~150%)</p>"""@en ;
    skos:inScheme cs: ;
    skos:notation "PH" ;
    skos:prefLabel "Precipitous hills"@en ;
    skos:related
        :relief-class-H ,
        :slope-class-PR ;
    skos:topConceptOf cs: ;
.

:simple-erosional-landform-pattern-PM
    a
        skos:Concept ,
        :Landform-pattern-erosional ;
    rdfs:isDefinedBy cs: ;
    skos:definition """<p>Precipitous mountains is a simple type of erosional landform pattern characterised by Very high relief and Precipitous modal slope.</p>
<p>Relief is Very high >300m (~500m)</p>
<p>Modal terrain slope is Precipitous >100% (~150%)</p>"""@en ;
    skos:inScheme cs: ;
    skos:notation "PM" ;
    skos:prefLabel "Precipitous mountains"@en ;
    skos:related
        :relief-class-M ,
        :slope-class-PR ;
    skos:topConceptOf cs: ;
.

:simple-erosional-landform-pattern-RH
    a
        skos:Concept ,
        :Landform-pattern-erosional ;
    rdfs:isDefinedBy cs: ;
    skos:definition """<p>Rolling hills is a simple type of erosional landform pattern characterised by High relief and Moderately inclined modal slope.</p>
<p>Relief is High 90-300m (~150m)</p>
<p>Modal terrain slope is Moderately inclined 10-32% (~20%)</p>"""@en ;
    skos:inScheme cs: ;
    skos:notation "RH" ;
    skos:prefLabel "Rolling hills"@en ;
    skos:related
        :relief-class-H ,
        :slope-class-MO ;
    skos:topConceptOf cs: ;
.

:simple-erosional-landform-pattern-RL
    a
        skos:Concept ,
        :Landform-pattern-erosional ;
    rdfs:isDefinedBy cs: ;
