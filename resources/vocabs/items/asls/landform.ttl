        :landform-pattern-HIL-occasional-elements ,
        :landform-pattern-KAR-typical-elements ,
        :landform-pattern-LOW-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "steep-sided, circular or elliptical closed depression, commonly funnel-shaped, characterised by subsurface drainage and formed by collapse of underlying caves within bedrock."@en ;
    skos:inScheme cs: ;
    skos:notation "DOC" ;
    skos:prefLabel "Collapse doline"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DUC
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-DUN-typical-elements ,
        :landform-pattern-LON-typical-elements ,
        :landform-pattern-PAR-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-C ;
    skos:definition "crest built up or eroded by the wind (see dune)."@en ;
    skos:inScheme cs: ;
    skos:notation "DUC" ;
    skos:prefLabel "Dunecrest"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DUS
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-DUN-typical-elements ,
        :landform-pattern-LON-typical-elements ,
        :landform-pattern-PAR-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-S ;
    skos:definition "slope built up or eroded by the wind (see dune)."@en ;
    skos:inScheme cs: ;
    skos:notation "DUS" ;
    skos:prefLabel "Duneslope"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-FLD
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-ALP-occasional-elements ,
        :landform-pattern-FLO-occasional-elements ,
        :landform-pattern-STA-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "flat inclined radially away from a point on the margin or at the end of a stream channel, aggraded by over-bank stream flow, or by channelled stream flow associated with channels developed within the over-bank flow; part of a covered plain landform pattern."@en ;
    skos:inScheme cs: ;
    skos:notation "FLD" ;
    skos:prefLabel "Flood-out"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-LAG
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-COR-typical-elements ,
        :landform-pattern-DEL-typical-elements ,
        :landform-pattern-TID-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "closed depression filled with water that is typically salt or brackish, bounded at least in part by forms aggraded or built up by waves or reef-building organisms."@en ;
    skos:inScheme cs: ;
    skos:notation "LAG" ;
    skos:prefLabel "Lagoon"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-TDC
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-BEA-common-elements ,
        :landform-pattern-CHE-common-elements ,
        :landform-pattern-DEL-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-V ;
    skos:definition "intermittently water-filled open depression in parts eroded, excavated, built up and aggraded by channelled tide-water flow; type of stream channel characterised by a rapid increase in width downstream."@en ;
    skos:inScheme cs: ;
    skos:notation "TDC" ;
    skos:prefLabel "Tidal creek"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-TDF
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-CHE-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "large flat subject to inundation by water that is usually salt or brackish, aggraded by tides. An intertidal flat (ITF) is frequently inundated; a supratidal flat (STF) is seldom inundated."@en ;
    skos:inScheme cs: ;
    skos:notation "TDF" ;
    skos:prefLabel "Tidal flat"@en ;
    skos:related
        :landform-element-ITF ,
        :landform-element-STF ;
    skos:topConceptOf cs: ;
.

:landform-element-TOR
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-HIL-occasional-elements ,
        :landform-pattern-LOW-occasional-elements ,
        :landform-pattern-RIS-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-H ;
    skos:definition "steep to precipitous hillock, typically convex, with a surface mainly of bare rock, either coherent or comprising subangular to rounded, large boulders (exhumed core-stones, also themselves called tors) separated by open fissures; eroded by sheet wash or water-aided mass movement."@en ;
    skos:inScheme cs: ;
    skos:notation "TOR" ;
    skos:prefLabel "Tor"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-ALP-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of an Alluvial plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAN ,
        :landform-element-PLA ,
        :landform-element-STB ,
        :landform-element-STC ;
    skos:prefLabel "Typical elements of an Alluvial plain"@en ;
    skos:related :landform-pattern-ALP ;
.

:landform-pattern-BAD
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-BAD-comparewith-patterns ,
        :landform-pattern-BAD-occasional-elements ,
        :landform-pattern-BAD-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """landform pattern of low to extremely low relief (less than 90 m) and steep to precipitous slopes, typically with numerous fixed, erosional stream channels which form a non-directional, integrated tributary network. There is continuously active erosion by collapse, landslide, sheet flow, creep and channelled stream flow. 
Typical elements: ridge (dominant), stream bed or gully.
Occasional elements: summit surface, hillcrest, hillslope, talus.
Compare with mountains, hills, low hills, rises and plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "BAD" ;
    skos:prefLabel "Badlands"@en ;
    skos:related
        :relief-class-L ,
        :relief-class-P ,
        :relief-class-R ,
        :slope-class-PR ,
        :slope-class-ST ,
        :slope-class-VS ;
    skos:topConceptOf cs: ;
.

:landform-pattern-BAD-occasional-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Occasional elements of Badlands"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-HCR ,
        :landform-element-HSL ,
        :landform-element-SUS ,
        :landform-element-TAL ;
    skos:prefLabel "Occasional elements of Badlands"@en ;
    skos:related :landform-pattern-BAD ;
.

:landform-pattern-BAR
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-BAR-comparewith-patterns ,
        :landform-pattern-BAR-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """flood plain with numerous rapidly migrating, shallow alluvial channels forming a unidirectional, integrated reticulated network. There is frequently active aggradation and erosion by channelled stream flow. (Described by Melton 1936.) 
Typical elements: stream bed, bar (dominant).
Compare with other types under alluvial plain and flood plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "BAR" ;
    skos:prefLabel "Bar plain"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-BEA
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-BEA-common-elements ,
        :landform-pattern-BEA-comparewith-patterns ,
        :landform-pattern-BEA-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level to gently undulating landform pattern of extremely low relief on which stream channels are absent or very rare; it consists of relict, parallel beach ridges. 
Typical elements: beach ridge (co-dominant), swale (co-dominant).
Common elements: beach, foredune, tidal creek.
Compare with chenier plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "BEA" ;
    skos:prefLabel "Beach ridge plain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-CHE-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Chenier plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BEA ,
        :landform-element-FOR ,
        :landform-element-SWP ,
        :landform-element-TDC ;
    skos:prefLabel "Common elements of Chenier plain"@en ;
    skos:related :landform-pattern-CHE ;
.

:landform-pattern-DEL
    a skos:Concept ;
    dcterms:relation
        :landform-pattern-DEL-common-elements ,
        :landform-pattern-DEL-comparewith-patterns ,
        :landform-pattern-DEL-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """flood plain projecting into a sea or lake, with slowly migrating, deep alluvial channels, usually moderately spaced, typically forming a divergent, integrated distributary network. This landform is aggraded by frequently active over-bank and channelled stream flow that is modified by tides. 
Typical elements: stream channel (stream bed and bank), levee, backplain (co-dominant), swamp (co-dominant), lagoon (co-dominant).
Common elements: beach ridge, swale, beach, estuary, tidal creek.
Compare with other types under alluvial plain, flood plain and chenier plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "DEL" ;
    skos:prefLabel "Delta"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-DUN-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Dunefield"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-DUB ,
        :landform-element-DUF ,
        :landform-element-DUH ,
        :landform-element-DUP ;
    skos:prefLabel "Common elements of Dunefield"@en ;
    skos:related :landform-pattern-DUN ;
.

:landform-pattern-FLO-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Flood plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAN ,
        :landform-element-PLA ,
        :landform-element-STB ,
        :landform-element-STC ;
    skos:prefLabel "Typical elements of Flood plain"@en ;
    skos:related :landform-pattern-FLO ;
.

:landform-pattern-HIL-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Hills"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-ALC ,
        :landform-element-FOO ,
        :landform-element-GUL ,
        :landform-element-VLF ;
    skos:prefLabel "Common elements of Hills"@en ;
    skos:related :landform-pattern-HIL ;
.

:landform-pattern-HIL-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Hills"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-DDE ,
        :landform-element-HCR ,
        :landform-element-HSL ,
        :landform-element-STB ;
    skos:prefLabel "Typical elements of Hills"@en ;
    skos:related :landform-pattern-HIL ;
.

:landform-pattern-LON
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-LON-comparewith-patterns ,
        :landform-pattern-LON-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """dunefield characterised by long, narrow sand dunes and wide, flat swales. The dunes are oriented parallel with the direction of the prevailing wind, and in cross-section one slope is typically steeper than the other. 
Typical elements: dune or dunecrest, duneslope, swale, blow-out.
Compare with parabolic dunefield."""@en ;
    skos:inScheme cs: ;
    skos:notation "LON" ;
    skos:prefLabel "Longitudinal dunefield"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-LOW-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Low hills"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-ALC ,
        :landform-element-FOO ,
        :landform-element-GUL ,
        :landform-element-VLF ;
    skos:prefLabel "Common elements of Low hills"@en ;
    skos:related :landform-pattern-LOW ;
.

:landform-pattern-LOW-occasional-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Occasional elements of Low hills"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-DOC ,
        :landform-element-LDS ,
        :landform-element-SUS ,
        :landform-element-TOR ;
    skos:prefLabel "Occasional elements of Low hills"@en ;
    skos:related :landform-pattern-LOW ;
.

:landform-pattern-LOW-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Low hills"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-DDE ,
        :landform-element-HCR ,
        :landform-element-HSL ,
        :landform-element-STB ;
    skos:prefLabel "Typical elements of Low hills"@en ;
    skos:related :landform-pattern-LOW ;
.

:landform-pattern-PAR
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-PAR-comparewith-patterns ,
        :landform-pattern-PAR-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """dunefield characterised by sand dunes with a long, scoop-shaped form, convex in the downwind direction so that its trailing arms point upwind; the ground plan, when developed, approximates the form of a parabola. Where many parabolic dunes have been active, the trailing arms give the impression of a longitudinal dunefield. 
Typical elements: dune or dunecrest, duneslope, swale, blow-out.
Compare with longitudinal dunefield."""@en ;
    skos:inScheme cs: ;
    skos:notation "PAR" ;
    skos:prefLabel "Parabolic dunefield"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-PED
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-PAR-comparewith-patterns ,
        :landform-pattern-PAR-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """gently inclined to level (less than 1%) landform pattern of extremely low relief, typically with numerous rapidly migrating, very shallow incipient stream channels, which form a centrifugal to diverging, integrated reticulated pattern. It is underlain by bedrock, eroded, and locally aggraded, by frequently active channelled stream flow or sheet flow, with subordinate wind erosion. Pediments characteristically lie downslope from adjacent hills with markedly steeper slopes. 
Typical elements: pediment, plain, stream bed(?).
Compare with sheet-flood fan and alluvial fan."""@en ;
    skos:inScheme cs: ;
    skos:notation "PED" ;
    skos:prefLabel "Pediment (pattern)"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-GE ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-SHF
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-SHF-comparewith-patterns ,
        :landform-pattern-SHF-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level (less than 1% slope) to very gently inclined landform pattern of extremely low relief with numerous rapidly migrating, very shallow incipient stream channels forming a divergent to unidirectional, integrated or interrupted reticulated pattern. The pattern is aggraded by frequently active sheet flow and channelled stream flow, with subordinate wind erosion. 
Typical elements: plain, stream bed.
Compare with alluvial fan and pediment."""@en ;
    skos:inScheme cs: ;
    skos:notation "SHF" ;
    skos:prefLabel "Sheet-flood fan"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-STA-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Stagnant alluvial plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAN ,
        :landform-element-PLA ,
        :landform-element-STB ,
        :landform-element-STC ;
    skos:prefLabel "Typical elements of Stagnant alluvial plain"@en ;
    skos:related :landform-pattern-STA ;
.

:landform-pattern-TEL
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-TEL-occasional-elements ,
        :landform-pattern-TEL-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """landform pattern including one or more terraces and often a flood plain. Relief is low or very low (9–90 m). Terrace plains or terrace flats occur at stated heights above the top of the stream bank. 
Typical elements: terrace plains, terrace flats, scarps, scroll plain, stream channel.
Occasional elements: stream channel, scroll, levee."""@en ;
    skos:inScheme cs: ;
    skos:notation "TEL" ;
    skos:prefLabel "Terraced land (alluvial)"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-TID-occasional-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Occasional elements of Tidal flat"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BEA ,
        :landform-element-BRI ,
        :landform-element-DUN ,
        :landform-element-LAG ;
    skos:prefLabel "Occasional elements of Tidal flat"@en ;
    skos:related :landform-pattern-TID ;
.

:landform-pattern-TID-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Tidal flat"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-ITF ,
        :landform-element-PLA ,
        :landform-element-STC ,
        :landform-element-STF ;
    skos:prefLabel "Typical elements of Tidal flat"@en ;
    skos:related :landform-pattern-TID ;
.

:morphological-type-C
    a
        skos:Concept ,
        :Landform-element-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Landform element that stands above all, or almost all, points in the adjacent terrain. It is characteristically smoothly convex upwards in downslope profile or in contour, or both. The margin of a crest element should be drawn at the limit of observed curvature."@en ;
    skos:inScheme cs: ;
    skos:narrower
        :landform-element-DUC ,
        :landform-element-HCR ,
        :landform-element-REC ,
        :landform-element-SUS ;
    skos:notation "C" ;
    skos:prefLabel "Crest"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-CUT
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MAD-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader
        :morphological-type-L ,
        :morphological-type-M ,
        :morphological-type-S ,
        :morphological-type-U ;
    skos:definition "slope eroded by human activity."@en ;
    skos:inScheme cs: ;
    skos:notation "CUT" ;
    skos:prefLabel "Cut face"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-GUL
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-BAD-typical-elements ,
        :landform-pattern-HIL-common-elements ,
        :landform-pattern-LOW-common-elements ,
        :landform-pattern-RIS-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-V ;
    skos:definition "open depression with short, precipitous walls and moderately inclined to very gently inclined floor or small stream channel, eroded by channelled stream flow and consequent collapse and water-aided mass movement."@en ;
    skos:inScheme cs: ;
    skos:notation "GUL" ;
    skos:prefLabel "Gully"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-LAK
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-ALP-occasional-elements ,
        :landform-pattern-CAL-typical-elements ,
        :landform-pattern-STA-occasional-elements ,
        :landform-pattern-VOL-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "large, water-filled closed depression."@en ;
    skos:inScheme cs: ;
    skos:notation "LAK" ;
    skos:prefLabel "Lake"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-OXB
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-ALP-occasional-elements ,
        :landform-pattern-FLO-occasional-elements ,
        :landform-pattern-MEA-common-elements ,
        :landform-pattern-STA-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "long, curved, commonly water-filled closed depression eroded by channelled stream flow but closed as a result of aggradation by channelled or over-bank stream flow during the formation of a meander plain landform pattern. The floor of an ox-bow may be more or less aggraded by over-bank stream flow, wind, and biological (peat) accumulation."@en ;
    skos:inScheme cs: ;
    skos:notation "OXB" ;
    skos:prefLabel "Ox-bow"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-ALF
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:references
        :relief-class-P ,
        :slope-class-LE ,
        :slope-class-VG ;
    dcterms:relation
        :landform-pattern-ALF-common-elements ,
        :landform-pattern-ALF-comparewith-patterns ,
        :landform-pattern-ALF-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """<p>level (less than 1% slope) to very gently inclined, complex landform pattern of extremely low relief. The rapidly migrating alluvial stream channels are shallow to moderately deep, locally numerous, but elsewhere widely spaced. The channels form a centrifugal to divergent, integrated, reticulated to distributary pattern. The landform pattern includes areas that are bar plains, being aggraded or eroded by frequently active channelled stream flow, and other areas comprising terraces or stagnant alluvial plains with slopes that are greater than usual, formed by channelled stream flow but now relict. Incision in the upslope area may give rise to an erosional stream bed between scarps. </p>
<p>Typical elements: stream bed, bar, plain.</p>
<p>Common element: scarp.</p>
<p>Compare with sheet-flood fan and pediment. """@en ;
    skos:inScheme cs: ;
    skos:notation "ALF" ;
    skos:prefLabel "Alluvial fan"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-ALP-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of an Alluvial plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAR ,
        :landform-element-BKP ,
        :landform-element-LEV ,
        :landform-element-SCR ,
        :landform-element-SWP ;
    skos:prefLabel "Common elements of an Alluvial plain"@en ;
    skos:related :landform-pattern-ALP ;
.

:landform-pattern-ANA
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-ANA-common-elements ,
        :landform-pattern-ANA-comparewith-patterns ,
        :landform-pattern-ANA-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """<p>flood plain with slowly migrating, deep alluvial channels, usually moderately spaced, forming a divergent to unidirectional, integrated reticulated network. There is frequently active aggradation by over-bank and channelled stream flow. </p>
<p>Typical elements: stream channel (stream bed and bank), levee, backplain (dominant).</p>
<p>Common element: swamp.</p>
<p>Compare with other types under alluvial plain and flood plain. """@en ;
    skos:inScheme cs: ;
    skos:notation "ANA" ;
    skos:prefLabel "Anastomotic plain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ;
    skos:topConceptOf cs: ;
.

:landform-pattern-ANA-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of an Anastomotic plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAN ,
        :landform-element-BKP ,
        :landform-element-LEV ,
        :landform-element-STB ,
        :landform-element-STC ;
    skos:prefLabel "Typical elements of an Anastomotic plain"@en ;
    skos:related :landform-pattern-ANA ;
.

:landform-pattern-CHE
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-CHE-common-elements ,
        :landform-pattern-CHE-comparewith-patterns ,
        :landform-pattern-CHE-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level to gently undulating landform pattern of extremely low relief on which stream channels are very rare. The pattern consists of relict, parallel, linear ridges built up by waves, separated by, and built over, flats (mud flats) aggraded by tides or over-bank stream flow. 
Typical elements: beach ridge (co-dominant), flat (co-dominant).
Common elements: tidal flat, swamp, beach, foredune, tidal creek.
Compare with beach ridge plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "CHE" ;
    skos:prefLabel "Chenier plain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-GE ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-COV
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-COV-common-elements ,
        :landform-pattern-COV-comparewith-patterns ,
        :landform-pattern-COV-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """flood plain with slowly migrating, deep alluvial channels, usually widely spaced and forming a unidirectional, integrated non-tributary network. There is frequently active aggradation by over-bank stream flow. (Described by Melton 1936.) 
Typical elements: stream channel (stream bed and bank), levee, backplain (dominant).
Common element: swamp.
Compare with other types under alluvial plain and flood plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "COV" ;
    skos:prefLabel "Covered plain"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-COV-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Covered plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAN ,
        :landform-element-BKP ,
        :landform-element-LEV ,
        :landform-element-STB ,
        :landform-element-STC ;
    skos:prefLabel "Typical elements of Covered plain"@en ;
    skos:related :landform-pattern-COV ;
.

:landform-pattern-DEL-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Delta"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BEA ,
        :landform-element-BRI ,
        :landform-element-EST ,
        :landform-element-SWL ,
        :landform-element-TDC ;
    skos:prefLabel "Common elements of Delta"@en ;
    skos:related :landform-pattern-DEL ;
.

:landform-pattern-FLO-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Flood plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAR ,
        :landform-element-BKP ,
        :landform-element-LEV ,
        :landform-element-SCR ,
        :landform-element-SWP ;
    skos:prefLabel "Common elements of Flood plain"@en ;
    skos:related :landform-pattern-FLO ;
.

:landform-pattern-LAC
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-LAC-common-elements ,
        :landform-pattern-LAC-comparewith-patterns ,
        :landform-pattern-LAC-occasional-elements ,
        :landform-pattern-LAC-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level landform pattern with extremely low relief formerly occupied by a lake but now partly or completely dry. It is relict after aggradation by waves and by deposition of material from suspension and solution in standing water. The pattern is usually bounded by wave-formed features such as cliffs, rock platforms, beaches, berms and lunettes. These may be included or excluded. 
Typical element: plain.
Common elements: beach, cliff.
Occasional elements: rock platform, berm.
Compare with playa plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "LAC" ;
    skos:prefLabel "Lacustrine plain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ;
    skos:topConceptOf cs: ;
.

:landform-pattern-LON-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Longitudinal dunefield"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BOU ,
        :landform-element-DUC ,
        :landform-element-DUN ,
        :landform-element-DUS ,
        :landform-element-SWL ;
    skos:prefLabel "Typical elements of Longitudinal dunefield"@en ;
    skos:related :landform-pattern-LON ;
.

:landform-pattern-MEA
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-MEA-common-elements ,
        :landform-pattern-MEA-comparewith-patterns ,
        :landform-pattern-MEA-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """flood plain with widely spaced, rapidly migrating, moderately deep alluvial stream channels which form a unidirectional, integrated non-tributary network. There is frequently active aggradation and erosion by channelled stream flow with subordinate aggradation by over-bank stream flow. (Described by Melton 1936.) 
Typical elements: stream channel (stream bed, bank and bar), scroll, scroll plain (dominant).
Common element: ox-bow.
Compare with other types under alluvial plain and flood plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "MEA" ;
    skos:prefLabel "Meander plain"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-MOU
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-MOU-common-elements ,
        :landform-pattern-MOU-comparewith-patterns ,
        :landform-pattern-MOU-occasional-elements ,
        :landform-pattern-MOU-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """landform pattern of very high relief (greater than 300 m) with moderate to precipitous slopes and fixed, erosional stream channels that are closely to very widely spaced and form a non-directional or diverging, integrated tributary network. There is continuously active erosion by collapse, landslide, sheet flow, creep, and channelled stream flow. 
Typical elements: hillcrest, hillslope (dominant), stream bed.
Common elements: talus, landslide, alcove, valley flat, scarp.
Occasional elements: cirque, footslope.
Compare with hills, low hills, rises and plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "MOU" ;
    skos:prefLabel "Mountains"@en ;
    skos:related
        :relief-class-M ,
        :slope-class-MO ,
        :slope-class-PR ,
        :slope-class-ST ,
        :slope-class-VS ;
    skos:topConceptOf cs: ;
.

:landform-pattern-MOU-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Mountains"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-ALC ,
        :landform-element-LDS ,
        :landform-element-SCA ,
        :landform-element-TAL ,
        :landform-element-VLF ;
    skos:prefLabel "Common elements of Mountains"@en ;
    skos:related :landform-pattern-MOU ;
.

:landform-pattern-PLT-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Plateau"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-DDE ,
        :landform-element-HCR ,
        :landform-element-HSL ,
        :landform-element-RFL ,
        :landform-element-SCA ;
    skos:prefLabel "Common elements of Plateau"@en ;
    skos:related :landform-pattern-PLT ;
.

:landform-pattern-RIS-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Rises"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-DDE ,
        :landform-element-FOO ,
        :landform-element-HCR ,
        :landform-element-HSL ,
