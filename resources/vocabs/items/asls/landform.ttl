        :landform-element-TRE ;
    skos:prefLabel "Typical elements of Made land"@en ;
    skos:related :landform-pattern-MAD ;
.

:landform-pattern-MEA-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Meander plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BAN ,
