    skos:inScheme cs: ;
    skos:member
        :landform-element-BEA ,
        :landform-element-CLI ;
    skos:prefLabel "Common elements of Lacustrine plain"@en ;
    skos:related :landform-pattern-LAC ;
.

:landform-pattern-LAC-occasional-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Occasional elements of Lacustrine plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BER ,
        :landform-element-RPL ;
    skos:prefLabel "Occasional elements of Lacustrine plain"@en ;
    skos:related :landform-pattern-LAC ;
.

:landform-pattern-LAV
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-LAV-common-elements ,
        :landform-pattern-LAV-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level to undulating landform pattern of very low to extremely low relief typically with widely spaced, fixed, erosional stream channels that form a non-directional, integrated or interrupted tributary pattern. The landform pattern is aggraded by volcanism (lava flow) that is generally relict; it is subject to erosion by continuously active sheet flow, creep, and channelled stream flow. 
Typical elements: plain, hillslope, stream bed.
Occasional element: tumulus."""@en ;
    skos:inScheme cs: ;
    skos:notation "LAV" ;
    skos:prefLabel "Lava plain"@en ;
    skos:related
        :relief-class-L ,
        :relief-class-P ,
        :relief-class-R ,
        :slope-class-GE ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-MAD
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-MAD-common-elements ,
        :landform-pattern-MAD-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """landform pattern typically of very low or extremely low relief and with slopes either level or very steep. Sparse, fixed, deep, artificial stream channels form a non-directional, interrupted tributary pattern. The landform pattern is eroded and aggraded, and locally built up or excavated, by rarely active human agency. 
Typical elements: fill-top (dominant), cut-over surface, cut face, embankment, berm, trench.
Common elements: mound, pit, dam."""@en ;
    skos:inScheme cs: ;
    skos:notation "MAD" ;
    skos:prefLabel "Made land"@en ;
    skos:related
        :relief-class-P ,
        :relief-class-R ,
        :slope-class-LE ,
        :slope-class-VS ;
    skos:topConceptOf cs: ;
.

:landform-pattern-MAR
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-MAR-occasional-elements ,
        :landform-pattern-MAR-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """plain eroded or aggraded by waves, tides, or submarine currents, and aggraded by deposition of material from suspension and solution in sea water, elevated above sea level by earth movements or eustasy, and little modified by subaerial agents such as stream flow or wind. 
Typical element: plain.
Occasional elements: dune, stream channel."""@en ;
    skos:inScheme cs: ;
    skos:notation "MAR" ;
    skos:prefLabel "Marine plain"@en ;
    skos:topConceptOf cs: ;
.

