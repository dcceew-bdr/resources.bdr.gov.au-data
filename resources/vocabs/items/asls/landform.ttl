    skos:definition "flat of bare consolidated rock, usually eroded by sheet wash."@en ;
    skos:inScheme cs: ;
    skos:notation "RFL" ;
    skos:prefLabel "Rock flat"@en ;
    skos:topConceptOf cs: ;
