    skos:notation "L" ;
    skos:note """This morphological type is distinguished on its position in the toposequence relative to crests, flats and depressions.
This morphological type requires a relative inclination of slope element modifier."""@en ;
    skos:prefLabel "Lower slope (requires inclination modifier)"@en ;
    skos:topConceptOf cs: ;
.

:morphological-type-M
    a
        skos:Concept ,
        :Landform-element-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "slope element not adjacent below a crest or flat and not adjacent above a flat or depression."@en ;
    skos:inScheme cs: ;
    skos:narrower
        :landform-element-BEN ,
        :landform-element-BER ,
        :landform-element-BRK ,
        :landform-element-CFS ,
        :landform-element-CLI ,
        :landform-element-CUT ,
        :landform-element-EMB ,
        :landform-element-HSL ,
        :landform-element-LDS ,
        :landform-element-SCA ,
        :landform-element-SFS ;
    skos:notation "M" ;
    skos:note """This morphological type is distinguished on its position in the toposequence relative to crests, flats and depressions.
This morphological type requires a relative inclination of slope element modifier."""@en ;
    skos:prefLabel "Mid-slope (requires inclination modifier)"@en ;
    skos:topConceptOf cs: ;
.

:morphological-type-V
    a
        skos:Concept ,
        :Landform-element-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Landform element that stands below all, or almost all, points in the adjacent terrain. An open depression extends at the same elevation, or lower."@en ;
    skos:inScheme cs: ;
    skos:narrower
        :landform-element-ALC ,
        :landform-element-CIR ,
        :landform-element-DDE ,
        :landform-element-EST ,
        :landform-element-GUL ,
        :landform-element-STB ,
        :landform-element-STC ,
        :landform-element-SWL ,
        :landform-element-SWP ,
        :landform-element-TDC ,
        :landform-element-TRE ;
    skos:notation "V" ;
    skos:note "Many depressions are concave upwards and their margins should be drawn at the limit of observed curvature."@en ;
    skos:prefLabel "Open depression (vale)"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-HCR
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-BAD-occasional-elements ,
        :landform-pattern-CAL-occasional-elements ,
        :landform-pattern-ESC-typical-elements ,
        :landform-pattern-HIL-typical-elements ,
        :landform-pattern-KAR-typical-elements ,
        :landform-pattern-LOW-typical-elements ,
        :landform-pattern-MET-typical-elements ,
        :landform-pattern-MOU-typical-elements ,
        :landform-pattern-PLT-common-elements ,
        :landform-pattern-RIS-typical-elements ,
        :landform-pattern-VOL-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-C ;
    skos:definition "very gently inclined to steep crest, smoothly convex, eroded mainly by creep and sheet wash. A typical element of mountains, hills, low hills and rises."@en ;
    skos:inScheme cs: ;
    skos:notation "HCR" ;
    skos:prefLabel "Hillcrest"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-FLO
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation
        :landform-pattern-FLO-common-elements ,
        :landform-pattern-FLO-included-patterns ,
        :landform-pattern-FLO-occasional-elements ,
        :landform-pattern-FLO-related-patterns ,
        :landform-pattern-FLO-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """alluvial plain characterised by frequently active erosion and aggradation by channelled or over-bank stream flow. Unless otherwise specified, ‘frequently active’ is to mean that flow has an Average Recurrence Interval of 50 years or less. 
Typical elements: stream channel (stream bed and bank), plain (dominant).
Common elements: bar, scroll, levee, backplain, swamp.
Occasional elements: ox-bow, flood-out, scroll.
Included types of landform pattern are: bar plain, meander plain, covered plain, anastomotic plain.
Related relict landform patterns are: stagnant alluvial plain, terrace, terraced land (partly relict)."""@en ;
    skos:inScheme cs: ;
    skos:notation "FLO" ;
    skos:prefLabel "Food plain"@en ;
    skos:topConceptOf cs: ;
.

:morphological-type-R
    a
        skos:Concept ,
        :Landform-element-type ,
        :compound-morphological-types ,
        :landform-pattern-BAD-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition "compound landform element comprising a narrow crest and short adjoining slopes, the crest length being greater than the width of the landform element."@en ;
    skos:inScheme cs: ;
    skos:narrower
        :landform-element-BAR ,
        :landform-element-BRI ,
        :landform-element-DAM ,
        :landform-element-DUN ,
        :landform-element-EMB ,
        :landform-element-FOR ,
        :landform-element-LEV ,
        :landform-element-LUN ,
        :landform-element-PST ,
        :landform-element-SCR ;
    skos:notation "R" ;
    skos:prefLabel "Ridge"@en ;
    skos:topConceptOf cs: ;
.

:slope-class-ST
    a
        skos:Concept ,
        :Slope-class ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A slope tangent boundary of 32-56% (30°) with average slope 40% (23°)"@en ;
    skos:inScheme cs: ;
    skos:notation "ST" ;
    skos:prefLabel "Steep"@en ;
    skos:topConceptOf cs: ;
.

:slope-class-VS
    a
        skos:Concept ,
        :Slope-class ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A slope tangent boundary of 56-100% (45°) with average slope 70% (37°)"@en ;
    skos:inScheme cs: ;
    skos:notation "VS" ;
    skos:prefLabel "Very steep"@en ;
    skos:topConceptOf cs: ;
.

:morphological-type-D
    a
        skos:Concept ,
        :Landform-element-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Landform element that stands below all, or almost all, points in the adjacent terrain. A closed depression stands below all such points."@en ;
    skos:inScheme cs: ;
    skos:narrower
        :landform-element-BOU ,
        :landform-element-CIR ,
        :landform-element-CRA ,
