        :landform-element-PLY ,
        :landform-element-SWP ;
    skos:notation "D" ;
    skos:note "Many depressions are concave upwards and their margins should be drawn at the limit of observed curvature."@en ;
    skos:prefLabel "Closed depression"@en ;
    skos:topConceptOf cs: ;
.

:slope-class-GE
    a
        skos:Concept ,
        :Slope-class ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A slope tangent boundary of 3-10% (5°45') with average slope 6% (3°)"@en ;
    skos:inScheme cs: ;
    skos:notation "GE" ;
    skos:prefLabel "Gently inclined"@en ;
    skos:topConceptOf cs: ;
.

:slope-class-MO
    a
        skos:Concept ,
        :Slope-class ;
