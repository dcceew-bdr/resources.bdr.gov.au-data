    a
        skos:Concept ,
        :Relief ,
        :Slope-modal ;
    rdfs:isDefinedBy cs: ;
    skos:definition "High relief, 90-300 m, (~150 m)"@en ;
    skos:inScheme cs: ;
    skos:notation "H" ;
    skos:prefLabel "High"@en ;
    skos:topConceptOf cs: ;
.

