:landform-pattern-BEA-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Beach ridge plain"@en ;
    skos:inScheme cs: ;
    skos:member
        :landform-element-BRI ,
