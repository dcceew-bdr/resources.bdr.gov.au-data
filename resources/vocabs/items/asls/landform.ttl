:morphological-type-L
    a
        skos:Concept ,
        :Landform-element-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "slope element not adjacent below a crest or flat but adjacent above a flat or depression."@en ;
    skos:inScheme cs: ;
