cs:
    a
        owl:Ontology ,
        skos:ConceptScheme ;
    dcterms:title "ASLS Landform classifiers" ;
    rdfs:seeAlso
        <http://www.publish.csiro.au/nid/22/pid/5230.htm> ,
        <https://www.publish.csiro.au/book/5230> ;
    owl:imports dc: ;
    owl:sameAs asls:landform ;
    skos:changeNote
        "2020-09-16 - made asls:landform a skos:ConceptScheme and added skos:inScheme link from all concepts" ,
        "2022-07-26 - removed dcterms:description and rdfs:label - duplicates skos:definition andskos:prefLabel" ,
        "2022-07-27 - relabel collections as XXX-enumeration; remove skos-ext namespace" ,
        "2022-07-29 - replace `sosa:ObservableProperty` type on enumerations with `skos:related` link to the OP in the domain model" ,
        "2022-11-23 - Rename collections for consistency with ANSIS" ,
        "2022-12-07 - remove observable-properties collection" ,
        "2022-12-16 - suppress type=Class on convenience collections" ,
        "2026-09-20 - Updated to be VocPub conformant" ;
    skos:definition """This vocabulary is a machine-readable representation of the classifiers described in chapter 5 Landform, by J.G. Speight in Australian Soil and Land Survey Field Handbook (3rd edn). 
In this technique for describing landforms, the whole land surface is viewed as a mosaic of tiles of odd shapes and sizes. The scheme is intended to produce a record of observations rather than inferences.""" ;
    skos:editorialNote "<p>The data was converted from the print representation to this linked-data form by <a href=\"https://orcid.org/0000-0002-0693-1899\">Linda Gregory</a> and <a href=\"https://orcid.org/0000-0002-3884-3420\">Simon J D Cox</a>"^^rdf:HTML ;
