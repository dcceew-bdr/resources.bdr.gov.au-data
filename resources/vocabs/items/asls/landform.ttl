:compound-morphological-types
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Several types of landform feature have crests and adjoining slopes that are so small that a 20 m radius site would usually include both. Two compound morphological types are distinguished by the relative length of the crest: Hillock and Ridge"@en ;
    skos:inScheme cs: ;
    skos:member
        :morphological-type-H ,
        :morphological-type-R ;
    skos:prefLabel "Compound morphological types - enumeration"@en ;
.

:landform-element-BRK
    a
        skos:Concept ,
        :Landform-element-name ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-M ;
    skos:definition "steep maximal mid-slope or upper slope, generally comprising both a very short scarp (free face) that is often bare rockland, and a stony scarp-footslope (debris slope); often standing above a pediment."@en ;
    skos:inScheme cs: ;
    skos:notation "BRK" ;
    skos:prefLabel "Breakaway"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DBA
    a
        skos:Concept ,
        :Landform-element-name ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "basin excavated by wind erosion which removes loose material, commonly above a resistant or wet layer."@en ;
    skos:inScheme cs: ;
    skos:notation "DBA" ;
    skos:prefLabel "Deflation basin"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DOL
    a
        skos:Concept ,
        :Landform-element-name ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "steep-sided, circular or elliptical closed depression, commonly funnel-shaped, characterised by subsurface drainage and formed by dissolution of the surface or underlying bedrock."@en ;
    skos:inScheme cs: ;
    skos:notation "DOL" ;
    skos:prefLabel "Solution doline"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-PST
    a
        skos:Concept ,
        :Landform-element-name ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-R ;
    skos:definition "long, generally sinuous, low ridge built up from materials originally deposited by stream flow along the line of a former stream channel. The landform element may include a depression marking the old stream bed, and relict levees."@en ;
    skos:inScheme cs: ;
    skos:notation "PST" ;
    skos:prefLabel "Prior stream"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-SCD
    a
        skos:Concept ,
        :Landform-element-name ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "flat, bare of vegetation, from which soil has been eroded or excavated by surface wash or wind."@en ;
    skos:inScheme cs: ;
    skos:notation "SCD" ;
    skos:prefLabel "Scald"@en ;
    skos:topConceptOf cs: ;
.

:landform-pattern-ALF-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of an Alluvial fan"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-SCA ;
    skos:prefLabel "Common elements of an Alluvial fan"@en ;
    skos:related :landform-pattern-ALF ;
.

:landform-pattern-ANA-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of an Anastomotic plain"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-SWP ;
    skos:prefLabel "Common elements of an Anastomotic plain"@en ;
    skos:related :landform-pattern-ANA ;
.

:landform-pattern-COV-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Covered plain"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-SWP ;
    skos:prefLabel "Common elements of Covered plain"@en ;
    skos:related :landform-pattern-COV ;
.

:landform-pattern-ESC-occasional-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Occasional elements of Escarpment"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-STB ;
    skos:prefLabel "Occasional elements of Escarpment"@en ;
    skos:related :landform-pattern-ESC ;
.

:landform-pattern-KAR-occasional-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Occasional elements of Karst"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-TAL ;
    skos:prefLabel "Occasional elements of Karst"@en ;
    skos:related :landform-pattern-KAR ;
.

:landform-pattern-LAC-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Lacustrine plain"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-PLA ;
    skos:prefLabel "Typical elements of Lacustrine plain"@en ;
    skos:related :landform-pattern-LAC ;
.

:landform-pattern-LAV-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Lava plain"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-TUM ;
    skos:prefLabel "Common elements of Lava plain"@en ;
    skos:related :landform-pattern-LAV ;
.

:landform-pattern-MAR-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Marine plain"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-PLA ;
    skos:prefLabel "Typical elements of Marine plain"@en ;
    skos:related :landform-pattern-MAR ;
.

:landform-pattern-MEA-common-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Common elements of Meander plain"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-OXB ;
    skos:prefLabel "Common elements of Meander plain"@en ;
    skos:related :landform-pattern-MEA ;
.

:landform-pattern-MET
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation :landform-pattern-MET-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """rare landform pattern comprising a circular closed depression (see crater landform element) with a raised margin; it is typically of low to high relief and has a large range of slope values, without stream channels, or with a peripheral integrated pattern of centrifugal tributary streams. The pattern is excavated, heaved up and built up by a meteor impact and is now relict. 
Typical elements: crater (scarp, talus, footslope and plain), hillcrest, hillslope."""@en ;
    skos:inScheme cs: ;
    skos:notation "MET" ;
    skos:prefLabel "Meteor crater"@en ;
    skos:related
        :relief-class-H ,
        :relief-class-L ;
    skos:topConceptOf cs: ;
.

:landform-pattern-PAR-comparewith-patterns
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Compare Parabolic dunefields with these patterns"@en ;
    skos:inScheme cs: ;
    skos:member :landform-pattern-LON ;
    skos:prefLabel "Compare Parabolic dunefields with these patterns"@en ;
    skos:related :landform-pattern-PAR ;
.

:landform-pattern-PEP
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation :landform-pattern-PEP-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level to very gently inclined landform pattern with extremely low relief and no stream channels, eroded by barely active sheet flow and wind. Largely relict from more effective erosion by stream flow in incipient stream channels as on a pediment. (Described by King 1953.) 
Typical element: plain."""@en ;
    skos:inScheme cs: ;
    skos:notation "PEP" ;
    skos:prefLabel "Pediplain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-PEP-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Pediplain"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-PLA ;
    skos:prefLabel "Typical elements of Pediplain"@en ;
    skos:related :landform-pattern-PEP ;
.

:landform-pattern-PLT-occasional-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Occasional elements of Plateau"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-STC ;
    skos:prefLabel "Occasional elements of Plateau"@en ;
    skos:related :landform-pattern-PLT ;
.

:landform-pattern-PNP
    a
        skos:Concept ,
        :Landform-pattern-name ;
    dcterms:relation :landform-pattern-PNP-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:definition """level to gently undulating landform pattern with extremely low relief and sparse, slowly migrating alluvial stream channels which form a non-directional, integrated tributary pattern. It is eroded by barely active sheet flow, creep, and channelled and over-bank stream flow. (Described by Davis 1889.) 
Typical elements: plain (dominant), stream channel."""@en ;
    skos:inScheme cs: ;
    skos:notation "PNP" ;
    skos:prefLabel "Peneplain"@en ;
    skos:related
        :relief-class-P ,
        :slope-class-LE ,
        :slope-class-VG ;
    skos:topConceptOf cs: ;
.

:landform-pattern-SAN-typical-elements
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Typical elements of Sand plain"@en ;
    skos:inScheme cs: ;
    skos:member :landform-element-PLA ;
    skos:prefLabel "Typical elements of Sand plain"@en ;
    skos:related :landform-pattern-SAN ;
.

:Channel-integration
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "In an integrated channel network, one can traverse from any point on a stream channel to any other point on a stream channel without passing through any landform elements other than stream channels. The channel network may be interrupted at points where water loss into the ground or the atmosphere is sufficiently large, and in the extreme case, typical of karst terrain, the surface stream network is disintegrated. Classes of channel network integration are:"@en ;
    skos:inScheme cs: ;
    skos:member
        :stream-channel-network-integration-D ,
        :stream-channel-network-integration-I ,
        :stream-channel-network-integration-P ;
    skos:prefLabel "Stream channel network integration - enumeration"@en ;
.

:Channel-migration
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The presence of relict channel landforms or unvegetated, newly formed channel margins or immovable channel margins may permit an assessment of channel migration."@en ;
    skos:inScheme cs: ;
    skos:member
        :stream-channel-migration-F ,
        :stream-channel-migration-R ,
        :stream-channel-migration-S ;
    skos:prefLabel "Stream channel migration - enumeration"@en ;
.

:Geomorphology-agent-stand
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Geomorphological agents - standing water - enumeration"@en ;
    skos:inScheme cs: ;
    skos:member
        :geomorphological-agent-EU ,
        :geomorphological-agent-TI ,
        :geomorphological-agent-WA ;
    skos:prefLabel "Geomorphological agents - standing water - enumeration"@en ;
.

:Location-in-element
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A site chosen to represent a landform element will often be placed centrally within it. For various reasons, a site may not be centrally placed and this should be recorded. The vertical position of the site within the height of the landform element may be the best measure:"@en ;
    skos:inScheme cs: ;
    skos:member
        :location-within-the-landform-element-B ,
        :location-within-the-landform-element-M ,
        :location-within-the-landform-element-T ;
    skos:prefLabel "Location within the landform element - enumeration"@en ;
.

:element-dimensions
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "An occurrence of a landform element extends as far as its attributes remain constant. Its dimensions, which may be much greater than the specified sample area diameter of 40 m, can be significant to land use. Terms referring to dimension appear often in the definitions of landform element types. Three dimensions are distinguished, each to be expressed in metres: Length, Width, Height (or depth)."@en ;
    skos:inScheme cs: ;
    skos:member
        :element-dimension-height ,
        :element-dimension-length ,
        :element-dimension-width ;
    skos:prefLabel "Dimensions of landform element"@en ;
.

:landform-element-BEN
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-HIL-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-M ;
    skos:definition "short, low, very wide slope, gently or moderately inclined, built up or eroded by waves, forming the shore of a lake or sea."@en ;
    skos:inScheme cs: ;
    skos:notation "BEN" ;
    skos:prefLabel "Bench"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-CBE
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-TER-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "flat at the margin of a stream channel aggraded and in part eroded by over-bank and channelled stream flow; an incipient flood plain. Channel benches have been referred to as 'low terraces', but the term terrace should be restricted to landform patterns above the influence of active stream flow."@en ;
    skos:inScheme cs: ;
    skos:notation "CBE" ;
    skos:prefLabel "Channel bench"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-COS
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MAD-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "flat eroded by human activity."@en ;
    skos:inScheme cs: ;
    skos:notation "COS" ;
    skos:prefLabel "Cut-over surface"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DAM
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MAD-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-R ;
    skos:definition "ridge built up by human activity so as to close a depression."@en ;
    skos:inScheme cs: ;
    skos:notation "DAM" ;
    skos:prefLabel "Dam"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DUB
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-DUN-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-H ;
    skos:definition "crescent-shaped dune with tips extending leeward (downwind), making this side concave and the windward (upwind) side convex. Barchan dunes tend to be arranged in chains extending in the dominant wind direction."@en ;
    skos:inScheme cs: ;
    skos:notation "DUB" ;
    skos:prefLabel "Barchan dune"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DUF
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-DUN-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-H ;
    skos:definition "large, sharp-crested, elongated, longitudinal (linear) dune or chain of sand dunes, oriented parallel, rather than transverse (perpendicular), to the prevailing wind. (Not to be confused with the trailing arms of parabolic dunes.)"@en ;
    skos:inScheme cs: ;
    skos:notation "DUF" ;
    skos:prefLabel "Linear or longitudinal (seif) dune"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DUH
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-DUN-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-H ;
    skos:definition "very gently to moderately inclined rises or hillocks built up or eroded by wind and lacking distinct orientation or regular pattern."@en ;
    skos:inScheme cs: ;
    skos:notation "DUH" ;
    skos:prefLabel "Hummocky (weakly oriented) dune"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-DUP
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-DUN-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-H ;
    skos:definition "sand dune with a long, scoop-shaped form, convex in the downwind direction so that its horns point upwind, whose ground plan approximates the form of a parabola. The dunes left behind can be referred to as trailing arms. Where many such dunes have traversed an area, these can give the appearance of linear dunes."@en ;
    skos:inScheme cs: ;
    skos:notation "DUP" ;
    skos:prefLabel "Parabolic dune"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-EST
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-DEL-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-V ;
    skos:definition "stream channel close to its junction with a sea or lake, where the action of channelled stream flow is modified by tide and waves. The width typically increases downstream."@en ;
    skos:inScheme cs: ;
    skos:notation "EST" ;
    skos:prefLabel "Estuary"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-FAN
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-RIS-occasional-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "large, gently inclined to level element with radial slope lines inclined away from a point, resulting from aggradation, or occasionally from erosion, by channelled, often braided, stream flow, or possibly by sheet flow."@en ;
    skos:inScheme cs: ;
    skos:notation "FAN" ;
    skos:prefLabel "Fan"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-FIL
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MAD-typical-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-F ;
    skos:definition "flat aggraded by human activity."@en ;
    skos:inScheme cs: ;
    skos:notation "FIL" ;
    skos:prefLabel "Fill-top"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-MAA
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-VOL-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "elongated, gently curved, low ridge built up by wind on the margin of a playa, typically with a moderate, wave-modified slope towards the playa and a gentle outer slope."@en ;
    skos:inScheme cs: ;
    skos:notation "MAA" ;
    skos:prefLabel "Maar"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-MOU
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MAD-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-H ;
    skos:definition "hillock built up by human activity."@en ;
    skos:inScheme cs: ;
    skos:notation "MOU" ;
    skos:prefLabel "Mound"@en ;
    skos:topConceptOf cs: ;
.

:landform-element-PIT
    a
        skos:Concept ,
        :Landform-element-name ,
        :landform-pattern-MAD-common-elements ;
    rdfs:isDefinedBy cs: ;
    skos:broader :morphological-type-D ;
    skos:definition "closed depression excavated by human activity."@en ;
    skos:inScheme cs: ;
    skos:notation "PIT" ;
    skos:prefLabel "Pit"@en ;
    skos:topConceptOf cs: ;
.

