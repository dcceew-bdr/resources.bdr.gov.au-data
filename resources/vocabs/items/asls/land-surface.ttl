    skos:prefLabel "Levelled from survey datum or estimated from contour plan"@en ;
    skos:topConceptOf cs: ;
.

:elevation-evaluation-means-M
    a
        skos:Concept ,
        sosa:Procedure ,
        :Elevation-evaluation-means ,
        :drainage-height-evaluation-means ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Interpolated from contour map with contour interval of 20 m or less"@en ;
    skos:inScheme cs: ;
    skos:notation "M" ;
    skos:prefLabel "Interpolated from contour map"@en ;
    skos:topConceptOf cs: ;
.

:microrelief
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
