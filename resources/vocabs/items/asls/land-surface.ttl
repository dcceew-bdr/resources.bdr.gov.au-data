ls:Erosion-severity-rill
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-rill"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A rill is a small channel up to 0.3 m deep, which can be largely obliterated by tillage operations (Houghton and Charman 1986)."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-R-0 ,
        ls:erosion-R-1 ,
        ls:erosion-R-2 ,
        ls:erosion-R-3 ;
    skos:notation "R" ;
    skos:prefLabel "Rill erosion - enumeration"@en ;
.

ls:Inundation-depth
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Inundation-depth"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Give likely maximum depth of water in an inundation event (mm). "@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:inundation-depth-1 ,
        ls:inundation-depth-2 ,
        ls:inundation-depth-3 ,
        ls:inundation-depth-4 ,
        ls:inundation-depth-5 ;
    skos:prefLabel "Depth of inundation (annual) - enumeration"@en ;
.

ls:Runoff
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Runoff"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Runoff is the relative rate at which water runs off the soil surface. It is largely determined by slope, surface cover and soil infiltration rate. "@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:runoff-0 ,
        ls:runoff-1 ,
        ls:runoff-2 ,
        ls:runoff-3 ,
        ls:runoff-4 ,
        ls:runoff-5 ;
    skos:prefLabel "Runoff - enumeration"@en ;
.

