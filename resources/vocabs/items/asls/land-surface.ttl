:Microrelief-type-gilgai
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Gilgai is surface microrelief associated with soils containing shrink–swell clays. It does not include microrelief that apparently results from repeated freezing and thawing, solifluxion or faunal activity. Gilgai consist of mounds and depressions showing varying degrees of order, sometimes separated by a subplanar or slightly undulating surface."@en ;
    skos:inScheme cs: ;
    skos:member
        :microrelief-A ,
        :microrelief-C ,
        :microrelief-G ,
        :microrelief-L ,
        :microrelief-M ,
        :microrelief-N ;
    skos:prefLabel "Type of gilgai microrelief - enumeration"@en ;
.

