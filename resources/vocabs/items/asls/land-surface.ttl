    skos:definition "Same as rock outcrop"@en ;
    skos:inScheme cs: ;
    skos:notation "R" ;
    skos:prefLabel "Same as rock outcrop"@en ;
    skos:topConceptOf cs: ;
.

:lithology-SS
    a
        skos:Concept ,
        :Lithology-coarse-fragments ;
    rdfs:comment "C_LITHOLOGY" ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Shells"@en ;
    skos:inScheme cs: ;
    skos:notation "SS" ;
    skos:prefLabel "Shells"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-A
    a
        skos:Concept ,
        :Microrelief-type-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "discontinuous, elongate mounds and/or elongate depressions more or less at right angles to the contour. Usually in sloping lands, commonly between linear gilgai on lower slopes and plains."@en ;
    skos:inScheme cs: ;
    skos:notation "A" ;
    skos:prefLabel "Lattice gilgai"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-C
    a
        skos:Concept ,
        :Microrelief-type-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "irregularly distributed, small depressions and mounds separated by a more or less continuous shelf. Vertical interval usually less than 0.3 m. Horizontal interval usually 3–20 m, surface almost level."@en ;
    skos:inScheme cs: ;
    skos:notation "C" ;
    skos:note "Vertical interval usually < 0.3 m and horizontal interval 3 - 20m"@en ;
    skos:prefLabel "Crabhole gilgai"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-D
    a
        skos:Concept ,
        :Microrelief-type-hummocky ;
    rdfs:isDefinedBy cs: ;
    skos:definition "small hummocks rising above a planar surface. They vary from rounded, both planar and vertically, to flat-topped, relatively steep-sided and elongate. They are usually closely and regularly spaced, ranging from 0.06 to 0.6 m in both vertical and horizontal dimensions. They are common in northern Australia on soils with impeded internal drainage and in areas of short seasonal ponding. Many observers consider them to be formed by biological activity."@en ;
    skos:inScheme cs: ;
    skos:notation "D" ;
    skos:prefLabel "Debil-debil"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-G
    a
        skos:Concept ,
        :Microrelief-type-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "irregularly distributed, large depressions, usually greater than 3 m in diameter or greatest dimension, subcircular or irregular and varying from closely spaced in a network of elongate mounds to isolated depressions set in an undulating shelf with occasional small mounds. Some depressions may also contain sinkholes of gilgai usually greater than 0.3 m; horizontal interval usually 5–6 m; surface almost level."@en ;
    skos:inScheme cs: ;
    skos:notation "G" ;
    skos:prefLabel "Contour gilgai"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-H
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Depression associated with water flowing from rock or soil without the agency of man."@en ;
    skos:inScheme cs: ;
    skos:notation "H" ;
    skos:prefLabel "Spring hollow"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-I
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "closed depression with vertical or funnel-shaped sides."@en ;
    skos:inScheme cs: ;
    skos:notation "I" ;
    skos:prefLabel "Sinkhole"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-K
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "depressions in limestone country."@en ;
    skos:inScheme cs: ;
    skos:notation "K" ;
    skos:prefLabel "Karst microrelief"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-L
    a
        skos:Concept ,
        :Microrelief-type-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "long, narrow, parallel, elongate mounds and broader elongate depressions more or less at right angles to the contour. Usually in sloping lands. Vertical interval usually less than 0.3 m, horizontal interval usually 5–8 m."@en ;
    skos:inScheme cs: ;
    skos:notation "L" ;
    skos:note "Vertical interval usually < 0.3 m and horizontal interval 5 - 8 m"@en ;
    skos:prefLabel "Linear gilgai"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-M
    a
        skos:Concept ,
        :Microrelief-type-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "irregularly distributed, large depressions, usually greater than 3 m in diameter or greatest dimension, subcircular or irregular and varying from closely spaced in a network of elongate mounds to isolated depressions set in an undulating shelf with occasional small mounds. Some depressions may also contain sinkholes of gilgai usually greater than 0.3 m; horizontal interval usually 5–6 m; surface almost level."@en ;
    skos:inScheme cs: ;
    skos:notation "M" ;
    skos:prefLabel "Melonhole gilgai"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-N
    a
        skos:Concept ,
        :Microrelief-type-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "irregularly distributed, small mounds and subcircular depressions varying in size and spacing. Vertical interval usually less than 0.3 m, horizontal interval usually 3–10 m, surface almost level."@en ;
    skos:inScheme cs: ;
    skos:notation "N" ;
    skos:note "Vertical interval usually < 0.3 m and horizontal interval 3 - 10m"@en ;
    skos:prefLabel "Normal gilgai"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-O
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Other microrelief"@en ;
    skos:inScheme cs: ;
    skos:notation "O" ;
    skos:prefLabel "Other microrelief"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-P
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Mound associated with water flowing from rock or soil without the agency of man."@en ;
    skos:inScheme cs: ;
    skos:notation "P" ;
    skos:prefLabel "Spring mound"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-R
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "small terraces on slopes resulting either from soil creep or trampling by hoofed animals."@en ;
    skos:inScheme cs: ;
    skos:notation "R" ;
    skos:prefLabel "Terracettes"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-S
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "hummocky microrelief on the surface of landslides, slumps, earth flows, debris avalanches."@en ;
    skos:inScheme cs: ;
    skos:notation "S" ;
    skos:prefLabel "Mass movement microrelief"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-T
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "trenches typically 0.2 m deep and 0.6 m wide, with near vertical walls, alternating with flat-crested ridges about 1.3 m wide, which extend along the contour for several metres or tens of metres. Contour trenches are known in areas in south-eastern Australia above 350 m altitude with a high effective rainfall, where they are associated with a grassland or heathland vegetation on undulating rises (compare with McElroy 1952)."@en ;
    skos:inScheme cs: ;
    skos:notation "T" ;
    skos:prefLabel "Contour trench"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-U
    a
        skos:Concept ,
        :Microrelief-type-other ;
    rdfs:isDefinedBy cs: ;
    skos:definition "undifferentiated, irregularly distributed or isolated mounds and/or depressions set in a planar surface."@en ;
    skos:inScheme cs: ;
    skos:notation "U" ;
    skos:prefLabel "Mound/depression microrelief"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-W
    a
        skos:Concept ,
        :Microrelief-type-hummocky ;
    rdfs:isDefinedBy cs: ;
    skos:definition "steep-sided hummocks rising above a flat surface. Hummocks are frequently occupied by trees or shrubs while the lower surface may be vegetation free or occupied by sedges or reeds. They are subject to prolonged seasonal flooding. "@en ;
    skos:inScheme cs: ;
    skos:notation "W" ;
    skos:prefLabel "Swamp hummock"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-Z
    a
        skos:Concept ,
        :microrelief ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Zero or no microrelief"@en ;
    skos:inScheme cs: ;
    skos:notation "Z" ;
    skos:prefLabel "Zero or no microrelief"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-component-D
    a
        skos:Concept ,
        :Microrelief-component-sampled ;
    rdfs:isDefinedBy cs: ;
    skos:definition "concave; occurs as closed form."@en ;
    skos:inScheme cs: ;
    skos:notation "D" ;
    skos:prefLabel "Depression"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-component-E
    a
        skos:Concept ,
        :Microrelief-component-sampled ;
    rdfs:isDefinedBy cs: ;
    skos:definition "convex; long axis* more than 3 times the shorter axis."@en ;
    skos:inScheme cs: ;
    skos:notation "E" ;
    skos:prefLabel "Elongate mound"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-component-F
    a
        skos:Concept ,
        :Microrelief-component-sampled ;
    rdfs:isDefinedBy cs: ;
    skos:definition "surface in which hummocks, mounds, depressions or sinkholes are set."@en ;
    skos:inScheme cs: ;
    skos:notation "F" ;
    skos:prefLabel "Flat"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-component-K
    a
        skos:Concept ,
        :Microrelief-component-sampled ;
    rdfs:isDefinedBy cs: ;
    skos:definition "rises above a flat or planar surface. Sides vary from rounded to near vertical and tops from rounded to flat."@en ;
    skos:inScheme cs: ;
    skos:notation "K" ;
    skos:prefLabel "Hummock"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-component-L
    a
        skos:Concept ,
        :Microrelief-component-sampled ;
    rdfs:isDefinedBy cs: ;
    skos:definition "concave; occurs as open-ended form."@en ;
    skos:inScheme cs: ;
    skos:notation "L" ;
    skos:prefLabel "Elongate depression"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-component-M
    a
        skos:Concept ,
        :Microrelief-component-sampled ;
    rdfs:isDefinedBy cs: ;
    skos:definition "convex; long axis* not more than 3 times the shorter axis."@en ;
    skos:inScheme cs: ;
    skos:notation "M" ;
    skos:prefLabel "Mound"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-component-S
    a
        skos:Concept ,
        :Microrelief-component-sampled ;
    rdfs:isDefinedBy cs: ;
    skos:definition "more or less planar; occurs between mounds and depressions."@en ;
    skos:inScheme cs: ;
    skos:notation "S" ;
    skos:prefLabel "Shelf"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-horizontal-interval
    a
        skos:Concept ,
        :microrelief ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Give horizontal distance, in metres, between crests of mounds or tops of hummocks."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Horizontal interval"@en ;
    skos:topConceptOf cs: ;
.

:microrelief-vertical-interval
    a
        skos:Concept ,
        :microrelief ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Give vertical distance, in metres, between base of depression or flat and horizontal line joining crests of mounds or hummocks."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Vertical interval"@en ;
    skos:topConceptOf cs: ;
.

:rock-outcrop-abundance-0
    a
        skos:Concept ,
        :Rock-outcrop-abundance ;
    rdfs:isDefinedBy cs: ;
    skos:definition "no bedrock exposed."@en ;
    skos:inScheme cs: ;
    skos:notation "0" ;
    skos:prefLabel "No rock outcrop"@en ;
    skos:topConceptOf cs: ;
.

:rock-outcrop-abundance-1
    a
        skos:Concept ,
        :Rock-outcrop-abundance ;
    rdfs:isDefinedBy cs: ;
    skos:definition "<2% bedrock exposed."@en ;
    skos:inScheme cs: ;
    skos:notation "1" ;
    skos:prefLabel "Very slightly rocky"@en ;
    skos:topConceptOf cs: ;
.

:rock-outcrop-abundance-2
    a
        skos:Concept ,
        :Rock-outcrop-abundance ;
    rdfs:isDefinedBy cs: ;
    skos:definition "2–10% bedrock exposed."@en ;
    skos:inScheme cs: ;
    skos:notation "2" ;
    skos:prefLabel "Slightly rocky"@en ;
    skos:topConceptOf cs: ;
.

:rock-outcrop-abundance-3
    a
        skos:Concept ,
        :Rock-outcrop-abundance ;
    rdfs:isDefinedBy cs: ;
    skos:definition "10–20% bedrock exposed."@en ;
    skos:inScheme cs: ;
    skos:notation "3" ;
    skos:prefLabel "Rocky"@en ;
    skos:topConceptOf cs: ;
.

:rock-outcrop-abundance-4
    a
        skos:Concept ,
        :Rock-outcrop-abundance ;
    rdfs:isDefinedBy cs: ;
    skos:definition "20–50% bedrock exposed."@en ;
    skos:inScheme cs: ;
    skos:notation "4" ;
    skos:prefLabel "Very rocky"@en ;
    skos:topConceptOf cs: ;
.

:rock-outcrop-abundance-5
    a
        skos:Concept ,
        :Rock-outcrop-abundance ;
    rdfs:isDefinedBy cs: ;
    skos:definition ">50% bedrock exposed."@en ;
    skos:inScheme cs: ;
    skos:notation "5" ;
    skos:prefLabel "Rockland"@en ;
    skos:topConceptOf cs: ;
.

:runoff-0
    a
        skos:Concept ,
        :Runoff ;
    rdfs:isDefinedBy cs: ;
    skos:definition "No runoff."@en ;
    skos:inScheme cs: ;
    skos:notation "0" ;
    skos:prefLabel "No runoff"@en ;
    skos:topConceptOf cs: ;
.

:runoff-1
    a
        skos:Concept ,
        :Runoff ;
    rdfs:isDefinedBy cs: ;
    skos:definition "free water on surface for long periods, or water enters soil immediately. Soils usually either level to nearly level or loose and porous."@en ;
    skos:inScheme cs: ;
    skos:notation "1" ;
    skos:prefLabel "Very slow"@en ;
    skos:topConceptOf cs: ;
.

:runoff-2
    a
        skos:Concept ,
        :Runoff ;
    rdfs:isDefinedBy cs: ;
    skos:definition "free water on surface for significant periods, or water enters soil relatively rapidly. Soils usually either nearly level to gently sloping or relatively porous."@en ;
    skos:inScheme cs: ;
    skos:notation "2" ;
    skos:prefLabel "Slow"@en ;
    skos:topConceptOf cs: ;
.

:runoff-3
    a
        skos:Concept ,
        :Runoff ;
    rdfs:isDefinedBy cs: ;
    skos:definition "free water on surface for short periods only; moderate proportion of water enters soil."@en ;
    skos:inScheme cs: ;
    skos:notation "3" ;
    skos:prefLabel "Moderately rapid"@en ;
    skos:topConceptOf cs: ;
.

:runoff-4
    a
        skos:Concept ,
        :Runoff ;
    rdfs:isDefinedBy cs: ;
    skos:definition "large proportion of water runs off; small proportion enters soil. Water runs off nearly as fast as it is added. Soils usually have moderate to steep slopes and low infiltration rates."@en ;
    skos:inScheme cs: ;
    skos:notation "4" ;
    skos:prefLabel "Rapid"@en ;
    skos:topConceptOf cs: ;
.

:runoff-5
    a
        skos:Concept ,
        :Runoff ;
    rdfs:isDefinedBy cs: ;
    skos:definition "very large proportion of water runs off; very small proportion enters soil. Water runs off as fast as it is added. Soils usually have steep to very steep slopes and low infiltration rates."@en ;
    skos:inScheme cs: ;
    skos:notation "5" ;
    skos:prefLabel "Very rapid"@en ;
    skos:topConceptOf cs: ;
.

:Aggradation
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This refers to the presence of material deposited on a pre-existing surface as a result of wind and/or water erosion."@en ;
    skos:inScheme cs: ;
    skos:member
        :aggradation-0 ,
        :aggradation-1 ,
        :aggradation-X ;
    skos:prefLabel "Aggradation - enumeration"@en ;
.

:Erosion-severity-mass-movement
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This includes all relatively large downslope movement of soil, rock or mixture of both, for example landslides, slumps, earth flows, debris avalanches and solifluxion."@en ;
    skos:inScheme cs: ;
    skos:member
        :erosion-M-0 ,
        :erosion-M-1 ;
    skos:notation "M" ;
    skos:prefLabel "Mass movement - enumeration"@en ;
.

:Inundation-runon-velocity
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "As a guide, the surface velocity in a river is typically 1–2 m/s. "@en ;
