.

ls:Erosion-depth-gully
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-depth-gully"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This gives the maximum depth within the site."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-G-depth-1 ,
        ls:erosion-G-depth-2 ,
        ls:erosion-G-depth-3 ;
