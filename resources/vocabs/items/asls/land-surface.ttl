.

:Erosion-severity-rill
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A rill is a small channel up to 0.3 m deep, which can be largely obliterated by tillage operations (Houghton and Charman 1986)."@en ;
    skos:inScheme cs: ;
    skos:member
        :erosion-R-0 ,
        :erosion-R-1 ,
        :erosion-R-2 ,
        :erosion-R-3 ;
    skos:notation "R" ;
    skos:prefLabel "Rill erosion - enumeration"@en ;
.

:Inundation-depth
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Give likely maximum depth of water in an inundation event (mm). "@en ;
    skos:inScheme cs: ;
    skos:member
        :inundation-depth-1 ,
        :inundation-depth-2 ,
        :inundation-depth-3 ,
        :inundation-depth-4 ,
        :inundation-depth-5 ;
    skos:prefLabel "Depth of inundation (annual) - enumeration"@en ;
