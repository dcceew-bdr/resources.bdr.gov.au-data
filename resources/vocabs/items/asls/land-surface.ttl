    a skos:Concept ;
    rdfs:comment "C_LITHOLOGY" ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Same as substrate material"@en ;
    skos:inScheme cs: ;
    skos:notation "M" ;
    skos:prefLabel "Same as substrate material"@en ;
    skos:topConceptOf cs: ;
.

