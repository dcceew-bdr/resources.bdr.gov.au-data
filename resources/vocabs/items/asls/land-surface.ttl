    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Give presence/absence or extent of accelerated erosion."@en ;
    skos:inScheme cs: ;
    skos:member
        :erosion-W-0 ,
        :erosion-W-1 ,
        :erosion-W-2 ,
        :erosion-W-3 ,
        :erosion-W-4 ,
        :erosion-W-X ;
    skos:notation "W" ;
    skos:prefLabel "Wind erosion - enumeration"@en ;
.

