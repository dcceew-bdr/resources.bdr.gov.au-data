    a
        skos:Concept ,
        :Lithology-coarse-fragments ;
    rdfs:comment "C_LITHOLOGY" ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Ironstone (where not considered of pedogenic origin)"@en ;
    skos:inScheme cs: ;
    skos:notation "IS" ;
    skos:prefLabel "Ironstone"@en ;
    skos:topConceptOf cs: ;
.

