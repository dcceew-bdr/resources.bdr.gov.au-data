    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/aspect"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "Give as compass bearing to nearest 10 degrees. On level lands (less than 1% slope), aspect need not be recorded."@en ;
    skos:inScheme asls:land-surface ;
    skos:prefLabel "Aspect"@en ;
    skos:topConceptOf asls:land-surface ;
.

ls:biotic-microrelief
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/biotic-microrelief"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "This relief is caused by biotic agents, for example termite mounds, rabbit warrens, wombat burrows, pig wallows, man-made terraces, stump holes, vegetation mounds. No subdivision of any of the types of biotic microrelief according to the specific agent or component of relief is given here. For example, vegetation mounds are mounds of soil material found at the base of plants such as Dillon bush (Nitraria billardieri) or spinifex (Triodia species). Users may subdivide types of biotic microrelief where considered necessary, such as specifying the particular species of vegetation involved in the case of vegetation mounds. For example, termite mounds would be coded TM."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:Microrelief-agent-biotic ,
        ls:Microrelief-component-biotic ;
    skos:prefLabel "Biotic microrelief"@en ;
.

ls:drainage-height
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/drainage-height"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "This is the height of the point of soil observation above the flat, depression or stream channel that forms the effective bottom of the toposequence. Give drainage height in metres."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:drainage-height-evaluation-means ,
        ls:drainage-height-value ;
    skos:prefLabel "Drainage height"@en ;
.

ls:drainage-height-value
    a
        ls:drainage-height ,
        skos:Concept ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/drainage-height-value"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:prefLabel "Drainage height value in metres" ;
