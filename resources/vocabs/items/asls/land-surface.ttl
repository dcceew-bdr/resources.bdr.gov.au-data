ls:erosion-type-C
    a
        ls:Erosion-type ,
        skos:Concept ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/erosion-type-C"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "This is the removal of surface soil by water and/or wind, often exposing a more clayey subsoil which is devoid of vegetation and relatively impermeable to water. Scalds are most common in arid or semi-arid lands."@en ;
    skos:inScheme asls:land-surface ;
    skos:notation "C" ;
    skos:prefLabel "Scald"@en ;
    skos:topConceptOf asls:land-surface ;
.

ls:erosion-type-G
    a
        ls:Erosion-type ,
        skos:Concept ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/erosion-type-G"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "A gully (see page 31) is a channel more than 0.3 m deep."@en ;
    skos:inScheme asls:land-surface ;
    skos:notation "G" ;
    skos:prefLabel "Gully"@en ;
    skos:topConceptOf asls:land-surface ;
.

ls:erosion-type-M
    a
        ls:Erosion-type ,
        skos:Concept ;
