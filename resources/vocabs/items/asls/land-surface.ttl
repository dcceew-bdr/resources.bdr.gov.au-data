ls:elevation-value
    a skos:Concept ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/elevation-value"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:prefLabel "Elevation value in metres" ;
