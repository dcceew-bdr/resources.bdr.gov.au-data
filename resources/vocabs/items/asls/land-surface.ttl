ls:Aggradation
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Aggradation"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This refers to the presence of material deposited on a pre-existing surface as a result of wind and/or water erosion."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:aggradation-0 ,
        ls:aggradation-1 ,
        ls:aggradation-X ;
    skos:prefLabel "Aggradation - enumeration"@en ;
.

ls:Erosion-severity-mass-movement
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-mass-movement"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This includes all relatively large downslope movement of soil, rock or mixture of both, for example landslides, slumps, earth flows, debris avalanches and solifluxion."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-M-0 ,
        ls:erosion-M-1 ;
    skos:notation "M" ;
    skos:prefLabel "Mass movement - enumeration"@en ;
.

ls:Inundation-runon-velocity
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Inundation-runon-velocity"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "As a guide, the surface velocity in a river is typically 1–2 m/s. "@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:inundation-runon-velocity-H ,
        ls:inundation-runon-velocity-L ;
    skos:prefLabel "Runon velocity of inundation - enumeration"@en ;
.

ls:Microrelief-type-hummocky
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Microrelief-type-hummocky"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Hummocky microrelief is not thought to be associated with the shrink–swell process involved in gilgai microrelief."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:microrelief-D ,
        ls:microrelief-W ;
    skos:prefLabel "Type of hummocky microrelief - enumeration"@en ;
.

