        :coarse-fragments-abundance-5 ,
        :coarse-fragments-abundance-6 ;
    skos:note "The percentage is estimated by eye using the charts in the yellow book for comparison. N_CF_ABUN"@en ;
    skos:prefLabel "Abundance of coarse fragments - enumeration"@en ;
.

:Coarse-fragments-size
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The scale adopted employs class boundaries at (2 × 10n/2) mm, where n is an integer. This system is an extension of that used for particles smaller than 2 mm both in the scheme of the British Standards Institution and the Massachusetts Institute of Technology and the original Atterberg (1905) scheme on which the International Scheme was based. It is thus compatible with both the International Scheme referred to in the field texture section and the grain size criteria for substrate materials."@en ;
    skos:inScheme cs: ;
    skos:member
        :coarse-fragments-size-1 ,
        :coarse-fragments-size-2 ,
        :coarse-fragments-size-3 ,
        :coarse-fragments-size-4 ,
        :coarse-fragments-size-5 ,
        :coarse-fragments-size-6 ,
        :coarse-fragments-size-7 ;
    skos:note
        "Note that in preparing soils for laboratory analysis, the greater than 2mm size fraction is commonly recorded as 'gravel'."@en ,
        "The terms used to describe size apply to fragments of any shape: The average maximum dimension of fragments is used to determine the class interval. N_CF_SIZE"@en ;
    skos:prefLabel "Size of coarse fragments -enumeration"@en ;
.

