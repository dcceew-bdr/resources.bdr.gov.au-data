ls:microrelief
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/microrelief"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Microrelief refers to relief up to a few metres about the plane of the land surface. It includes gilgai, hummocky, biotic and other microrelief."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:Microrelief-component-sampled ,
        ls:Microrelief-proportions-gilgai ,
        ls:Microrelief-type-gilgai ,
        ls:Microrelief-type-hummocky ,
        ls:Microrelief-type-other ,
        ls:biotic-microrelief ,
        ls:microrelief-Z ,
        ls:microrelief-horizontal-interval ,
        ls:microrelief-vertical-interval ;
    skos:prefLabel "Microrelief classifiers"@en ;
.

