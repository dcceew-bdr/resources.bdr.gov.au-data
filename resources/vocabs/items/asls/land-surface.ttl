    skos:topConceptOf cs: ;
.

:erosion-state-A
    a
        skos:Concept ,
        :Erosion-state ;
    rdfs:isDefinedBy cs: ;
    skos:definition "one or both of the following conditions apply: evidence of sediment movement; sides and/or floors of erosion form are relatively bare of vegetation."@en ;
    skos:inScheme cs: ;
    skos:notation "A" ;
    skos:prefLabel "Active"@en ;
    skos:topConceptOf cs: ;
.

:erosion-state-P
    a
        skos:Concept ,
        :Erosion-state ;
    rdfs:isDefinedBy cs: ;
    skos:definition "evidence of some active erosion and some evidence of stabilisation."@en ;
    skos:inScheme cs: ;
    skos:notation "P" ;
    skos:prefLabel "Partly stabilised"@en ;
    skos:topConceptOf cs: ;
.

:erosion-state-S
    a
        skos:Concept ,
        :Erosion-state ;
    rdfs:isDefinedBy cs: ;
    skos:definition "one or both of the following conditions apply: no evidence of sediment movement; sides and/or floors of erosion form are revegetated."@en ;
    skos:inScheme cs: ;
    skos:notation "S" ;
    skos:prefLabel "Stabilised"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-B
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "This is the removal of soil from a stream bank, typically during periods of high stream flow."@en ;
    skos:inScheme cs: ;
    skos:notation "B" ;
    skos:prefLabel "Stream bank"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-C
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "This is the removal of surface soil by water and/or wind, often exposing a more clayey subsoil which is devoid of vegetation and relatively impermeable to water. Scalds are most common in arid or semi-arid lands."@en ;
    skos:inScheme cs: ;
    skos:notation "C" ;
    skos:prefLabel "Scald"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-G
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A gully (see page 31) is a channel more than 0.3 m deep."@en ;
    skos:inScheme cs: ;
    skos:notation "G" ;
    skos:prefLabel "Gully"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-M
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "This includes all relatively large downslope movement of soil, rock or mixture of both, for example landslides, slumps, earth flows, debris avalanches and solifluxion."@en ;
    skos:inScheme cs: ;
    skos:notation "M" ;
    skos:prefLabel "Mass movement"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-R
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A rill is a small channel up to 0.3 m deep, which can be largely obliterated by tillage operations (Houghton and Charman 1986)."@en ;
    skos:inScheme cs: ;
    skos:notation "R" ;
    skos:prefLabel "Rill"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-S
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition """This is the relatively uniform removal of soil from an area without the development of conspicuous channels.
Indicators of sheet erosion include soil deposits in downslope sediment traps, such as fencelines or farm dams, and pedestalling, root exposure or exposure of subsoils."""@en ;
    skos:inScheme cs: ;
    skos:notation "S" ;
    skos:prefLabel "Sheet"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-T
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "This is the removal of subsoil by water while the surface soil remains relatively intact (Crouch 1976)."@en ;
    skos:inScheme cs: ;
    skos:notation "T" ;
    skos:prefLabel "Tunnel"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-V
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Erosion of beaches, beach ridges and/or dunes. This is the removal of sand or soil from the margins of beaches, beach ridges, dunes, lakes or dams by wave action."@en ;
    skos:inScheme cs: ;
    skos:notation "V" ;
    skos:prefLabel "Wave"@en ;
    skos:topConceptOf cs: ;
.

:erosion-type-W
    a
        skos:Concept ,
        :Erosion-type ;
    rdfs:isDefinedBy cs: ;
    skos:definition "wind erosion."@en ;
    skos:inScheme cs: ;
    skos:notation "W" ;
    skos:prefLabel "Wind"@en ;
    skos:topConceptOf cs: ;
.

:gilgai-microrelief-proportions-A
    a
        skos:Concept ,
        :Microrelief-proportions-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Equal mounds and depressions; no shelf present."@en ;
    skos:inScheme cs: ;
    skos:notation "A" ;
    skos:prefLabel "Equal mounds and depressions; no shelf present"@en ;
    skos:topConceptOf cs: ;
.

:gilgai-microrelief-proportions-B
    a
        skos:Concept ,
        :Microrelief-proportions-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "More mounds than depressions; no shelf present."@en ;
    skos:inScheme cs: ;
    skos:notation "B" ;
    skos:prefLabel "More mounds than depressions; no shelf present"@en ;
    skos:topConceptOf cs: ;
.

:gilgai-microrelief-proportions-C
    a
        skos:Concept ,
        :Microrelief-proportions-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Fewer mounds than depressions; no shelf present."@en ;
    skos:inScheme cs: ;
    skos:notation "C" ;
    skos:prefLabel "Fewer mounds than depressions; no shelf present"@en ;
    skos:topConceptOf cs: ;
.

:gilgai-microrelief-proportions-D
    a
        skos:Concept ,
        :Microrelief-proportions-gilgai ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Mound, shelf and depressions; shelf forms prominent part of gilgai."@en ;
    skos:inScheme cs: ;
    skos:notation "D" ;
    skos:prefLabel "Mound, shelf and depressions; shelf forms prominent part of gilgai"@en ;
    skos:topConceptOf cs: ;
.

