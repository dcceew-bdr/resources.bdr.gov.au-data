ls:Erosion-severity-scald
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-scald"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This is the removal of surface soil by water and/or wind, often exposing a more clayey subsoil which is devoid of vegetation and relatively impermeable to water. Scalds are most common in arid or semi-arid lands."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-C-0 ,
        ls:erosion-C-1 ,
        ls:erosion-C-2 ,
        ls:erosion-C-3 ;
    skos:notation "C" ;
    skos:prefLabel "Scald erosion - enumeration"@en ;
.

ls:Erosion-severity-stream-bank
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-stream-bank"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This is the removal of soil from a stream bank, typically during periods of high stream flow."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-B-0 ,
        ls:erosion-B-1 ,
        ls:erosion-B-X ;
    skos:notation "B" ;
    skos:prefLabel "Stream bank erosion - enumeration"@en ;
.

ls:Erosion-severity-tunnel
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-tunnel"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This is the removal of subsoil by water while the surface soil remains relatively intact (Crouch 1976)."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-T-0 ,
        ls:erosion-T-1 ,
        ls:erosion-T-X ;
    skos:notation "T" ;
    skos:prefLabel "Tunnel erosion - enumeration"@en ;
.

ls:Erosion-severity-wave
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-wave"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Erosion of beaches, beach ridges and/or dunes. This is the removal of sand or soil from the margins of beaches, beach ridges, dunes, lakes or dams by wave action."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-V-0 ,
        ls:erosion-V-1 ,
        ls:erosion-V-X ;
    skos:notation "V" ;
    skos:prefLabel "Wave erosion - enumeration"@en ;
.

