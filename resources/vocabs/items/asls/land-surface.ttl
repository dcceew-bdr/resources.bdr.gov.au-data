    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-gully"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A gully is a channel more than 0.3 m deep."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-G-0 ,
        ls:erosion-G-1 ,
        ls:erosion-G-2 ,
        ls:erosion-G-3 ;
    skos:notation "G" ;
    skos:prefLabel "Gully erosion - enumeration"@en ;
.

ls:Erosion-severity-sheet
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-sheet"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This is the relatively uniform removal of soil from an area without the development of conspicuous channels. Indicators of sheet erosion include soil deposits in downslope sediment traps, such as fencelines or farm dams, and pedestalling, root exposure or exposure of subsoils."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:erosion-S-0 ,
        ls:erosion-S-1 ,
        ls:erosion-S-2 ,
        ls:erosion-S-3 ,
        ls:erosion-S-X ;
    skos:notation "S" ;
    skos:prefLabel "Sheet erosion - enumeration"@en ;
.

ls:Erosion-severity-wind
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-severity-wind"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Give presence/absence or extent of accelerated erosion."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
