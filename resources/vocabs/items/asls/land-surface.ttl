PREFIX asls: <http://anzsoil.org/def/au/asls/>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX ls: <http://anzsoil.org/def/au/asls/land-surface/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX subst: <http://anzsoil.org/def/au/asls/substrate/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ls:coarse-fragments
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/coarse-fragments"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition """Coarse fragments are particles coarser than 2 mm. They include unattached rock fragments and other fragments such as charcoal and shells. Coarse fragments are distinguished from segregations of pedogenic origin in that they are not, or not considered to be, of pedogenic origin.  
Both coarse fragments and segregations of pedogenic origin can occur on the surface. Where segregations of pedogenic origin occur on the surface, they should be described as per soil-profile."""@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:Coarse-fragments-abundance ,
        ls:Coarse-fragments-shape ,
        ls:Coarse-fragments-size ,
        ls:Coarse-fragments-strength ,
        ls:Lithology-coarse-fragments ;
    skos:prefLabel "Coarse fragments"@en ;
.

ls:depth-free-water
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/depth-free-water"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "Give depth to free water at the site of soil observation, in metres, either above or below the soil surface, excluding litter and living vegetation. "@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:depth-free-water-0 ,
        ls:depth-free-water-above ,
        ls:depth-free-water-below ;
    skos:prefLabel "Depth to free water - enumeration"@en ;
.

ls:elevation
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/elevation"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "Give in metres above sea-level."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:Elevation-evaluation-means ,
        ls:elevation-value ;
    skos:prefLabel "Elevation in metres above sea-level"@en ;
.

ls:erosion
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/erosion"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition """This section is concerned with accelerated erosion rather than natural erosion. Natural or geologic erosion is the type and rate of movement of land surface material in its undisturbed natural environment. Accelerated erosion is the more rapid erosion that follows the destruction or loss of protective cover often resulting from people’s influence on the soil, vegetation or landform. It is not always easy to distinguish between accelerated and natural erosion in some landscapes where both are closely interrelated, nor is it always clear whether wind or water is the dominant agent. This is particularly so in the case of scald formation (Warren 1965).
The complexity of erosion forms creates difficulties in both defining and quantitatively estimating the extent of erosion within the dimensions of the site. Hence, the observer is advised to record the following simple parameters. Assess the erosion observed at the time of the description, not the likelihood of erosion."""@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:Erosion-gully ,
        ls:Erosion-severity ,
        ls:Erosion-state ,
        ls:Erosion-type ,
        ls:erosion-water ;
    skos:note "For erosion, aggradation and inundation assessment, the extent of the site is 20 m radius."@en ;
    skos:prefLabel "Erosion"@en ;
.

ls:inundation
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/inundation"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "Inundation includes flooding from over-bank flow, inundation from local runon and overland flow. Although the importance of this information is considerable, in most instances it cannot be assessed at each site. Some evidence may be available from past events, for example accumulation of debris in trees or on fences. Otherwise information is usually obtained from local enquiry."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:Inundation-depth ,
        ls:Inundation-duration ,
        ls:Inundation-frequency ,
        ls:Inundation-runon-velocity ;
    skos:prefLabel "Inundation"@en ;
.

ls:rock-outcrop
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/rock-outcrop"^^xsd:anyURI ;
    rdfs:isDefinedBy asls:land-surface ;
    skos:definition "This refers to any exposed area of rock that is inferred to be continuous with underlying bedrock."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        ls:Lithology-rock-outcrop ,
        ls:Rock-outcrop-abundance ;
    skos:prefLabel "Rock outcrop"@en ;
.

ls:Coarse-fragments-strength
    a
        owl:Class ,
        skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Coarse-fragments-strength"^^xsd:anyURI ;
    rdfs:comment "C_CF_STRENGTH"@en ;
    rdfs:isDefinedBy asls:land-surface ;
    rdfs:subClassOf skos:Concept ;
    owl:equivalentClass subst:Material-strength ;
    skos:altLabel "Strength of material"@en ;
    skos:definition "Strength of coarse fragments is the same as for 'Strength of material'. The strength of a specimen of soil substrate material may be crudely estimated in the field by striking it with the head-end or the pick-end of a geological hammer or by trying to cut it with a knife, and then referring to Table 32 (ASLS Field Handbook). These estimates refer to the unconfined (or uniaxial) compressive strength. The strength is that of the intact material rather than that of the mass, the strength of which has generally been reduced by the development of fractures and other phenomena."@en ;
    skos:inScheme asls:land-surface ;
    skos:member
        subst:material-strength-M ,
        subst:material-strength-S ,
        subst:material-strength-VS ,
        subst:material-strength-VW ,
        subst:material-strength-W ;
    skos:prefLabel "Strength of coarse fragments - enumeration"@en ;
.

ls:Erosion-gully
    a skos:Collection ;
    dcterms:identifier "http://anzsoil.org/def/au/asls/land-surface/Erosion-gully"^^xsd:anyURI ;
