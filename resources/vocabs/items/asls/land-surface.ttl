:Runoff
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Runoff is the relative rate at which water runs off the soil surface. It is largely determined by slope, surface cover and soil infiltration rate. "@en ;
    skos:inScheme cs: ;
    skos:member
        :runoff-0 ,
        :runoff-1 ,
        :runoff-2 ,
        :runoff-3 ,
        :runoff-4 ,
        :runoff-5 ;
    skos:prefLabel "Runoff - enumeration"@en ;
.

:Erosion-severity-gully
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A gully is a channel more than 0.3 m deep."@en ;
    skos:inScheme cs: ;
    skos:member
        :erosion-G-0 ,
        :erosion-G-1 ,
        :erosion-G-2 ,
        :erosion-G-3 ;
    skos:notation "G" ;
    skos:prefLabel "Gully erosion - enumeration"@en ;
.

:Erosion-severity-sheet
    a
        owl:Class ,
        skos:Collection ;
    rdfs:isDefinedBy cs: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "This is the relatively uniform removal of soil from an area without the development of conspicuous channels. Indicators of sheet erosion include soil deposits in downslope sediment traps, such as fencelines or farm dams, and pedestalling, root exposure or exposure of subsoils."@en ;
    skos:inScheme cs: ;
    skos:member
        :erosion-S-0 ,
        :erosion-S-1 ,
        :erosion-S-2 ,
        :erosion-S-3 ,
        :erosion-S-X ;
    skos:notation "S" ;
    skos:prefLabel "Sheet erosion - enumeration"@en ;
.

