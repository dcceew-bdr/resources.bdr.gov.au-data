    skos:definition "The observer should state the degree of confidence that the observed substrate material is in fact the parent material of the observed soil profile or the major part of that profile, that is, of the B horizon."@en ;
    skos:inScheme cs: ;
    skos:member
        :confidence-certain ,
        :confidence-doubtful ,
        :confidence-not-parent ,
        :confidence-probable ;
    skos:prefLabel "Confidence that substrate is parent material - enumeration"@en ;
