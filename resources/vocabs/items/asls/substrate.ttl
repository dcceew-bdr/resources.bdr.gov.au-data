:material-strength-M
    a
        skos:Concept ,
        :Material-strength ;
    rdfs:isDefinedBy cs: ;
    skos:definition "50-100 MPa based on field estimate of strength class after striking or cutting the rock material - Knife:Nil or slight mark, Pick:indents shallowly, Hammer (single blow):Breaks readily into a few large and some small fragments"@en ;
    skos:notation "M" ;
    skos:prefLabel "Moderately strong rock"@en ;
    skos:topConceptOf cs: ;
.

:material-strength-S
    a
        skos:Concept ,
        :Material-strength ;
    rdfs:isDefinedBy cs: ;
    skos:definition "100-200 MPa based on field estimate of strength class after striking or cutting the rock material - Knife:Nil, Pick:Nil, Hammer (single blow):Breaks into one or two large fragments"@en ;
    skos:notation "S" ;
    skos:prefLabel "Strong rock"@en ;
    skos:topConceptOf cs: ;
.

:material-strength-VS
    a
        skos:Concept ,
        :Material-strength ;
    rdfs:isDefinedBy cs: ;
    skos:definition ">200 MPa based on field estimate of strength class after striking or cutting the rock material - Knife:Nil, Pick:Nil, Hammer (single blow):Nil"@en ;
    skos:notation "VS" ;
    skos:prefLabel "Very strong rock"@en ;
    skos:topConceptOf cs: ;
.

:material-strength-VW
    a
        skos:Concept ,
        :Material-strength ;
    rdfs:isDefinedBy cs: ;
    skos:definition "1-25 MPa based on field estimate of strength class after striking or cutting the rock material - Knife:Deep cut, Pick:crumbles, Hammer (single blow):Flattened or powdered"@en ;
    skos:notation "VW" ;
    skos:prefLabel "Very weak rock"@en ;
    skos:topConceptOf cs: ;
.

:material-strength-W
