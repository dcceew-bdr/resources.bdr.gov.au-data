        skos:Concept ,
        :Confidence ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Dubious, doubtful"@en ;
    skos:notation "D" ;
    skos:prefLabel "Dubious, doubtful"@en ;
    skos:topConceptOf cs: ;
.

:confidence-not-parent
    a
        skos:Concept ,
        :Confidence ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Not parent material"@en ;
    skos:notation "N" ;
    skos:prefLabel "Not parent material"@en ;
    skos:topConceptOf cs: ;
.

:confidence-probable
    a
        skos:Concept ,
        :Confidence ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Probable"@en ;
    skos:notation "P" ;
    skos:prefLabel "Probable"@en ;
    skos:topConceptOf cs: ;
.

:discontinuity-spacing-B
    a
        skos:Concept ,
        :Substrate-discontinuity-spacing ;
    rdfs:isDefinedBy cs: ;
    skos:definition "300 mm – 1 m"@en ;
    skos:notation "B" ;
    skos:prefLabel "blocky; moderately jointed."@en ;
    skos:topConceptOf cs: ;
.

:discontinuity-spacing-C
    a
        skos:Concept ,
        :Substrate-discontinuity-spacing ;
    rdfs:isDefinedBy cs: ;
    skos:definition "<50 mm"@en ;
    skos:notation "C" ;
    skos:prefLabel "crushed or shattered."@en ;
    skos:topConceptOf cs: ;
.

:discontinuity-spacing-F
    a
        skos:Concept ,
        :Substrate-discontinuity-spacing ;
    rdfs:isDefinedBy cs: ;
    skos:definition "50-300 mm"@en ;
    skos:notation "F" ;
    skos:prefLabel "fractured; intensely jointed."@en ;
    skos:topConceptOf cs: ;
.

:discontinuity-spacing-M
    a
        skos:Concept ,
        :Substrate-discontinuity-spacing ;
    rdfs:isDefinedBy cs: ;
    skos:definition "1-3 m"@en ;
    skos:notation "M" ;
    skos:prefLabel "massive; few joints."@en ;
    skos:topConceptOf cs: ;
.

:discontinuity-spacing-S
    a
        skos:Concept ,
        :Substrate-discontinuity-spacing ;
    rdfs:isDefinedBy cs: ;
    skos:definition ">3 m"@en ;
    skos:notation "S" ;
    skos:prefLabel "solid; virtually unjointed"@en ;
    skos:topConceptOf cs: ;
.

:genesis-AC
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-chemical ;
    rdfs:isDefinedBy cs: ;
    skos:definition "indurated material rich in aluminium hydroxides. Commonly consists of cemented pisoliths and usually known as bauxite."@en ;
    skos:notation "AC" ;
    skos:prefLabel "Alcrete (bauxite)"@en ;
    skos:topConceptOf cs: ;
.

:genesis-AL
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sediment mass deposited from transport by channelled stream flow or over-bank stream flow."@en ;
    skos:notation "AL" ;
    skos:prefLabel "Alluvium"@en ;
    skos:topConceptOf cs: ;
.

:genesis-AT
    a
        skos:Concept ,
        :Rock-genesis-hardened-artificial ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Other artificially hardened materials"@en ;
    skos:notation "AT" ;
    skos:prefLabel "Other artificially hardened materials"@en ;
    skos:topConceptOf cs: ;
.

:genesis-BE
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sediment mass deposited from transport by waves or tides at the shore of a sea or lake."@en ;
    skos:notation "BE" ;
    skos:prefLabel "Beach sediment"@en ;
    skos:topConceptOf cs: ;
.

:genesis-CD
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "colluvium slowly displaced a short distance downslope as a result of small irregular movements, with the net movement increasing towards the land surface."@en ;
    skos:notation "CD" ;
    skos:prefLabel "Creep deposit"@en ;
    skos:topConceptOf cs: ;
.

:genesis-CN
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-artificial ;
    rdfs:isDefinedBy cs: ;
    skos:definition "artificial conglomerate rock mass of selected size grade material that has been hardened using Portland cement or other kinds of cement. Concrete is a weak rock (ca. 35 MPa unconfined compressive strength) usually reinforced with steel to increase its tensile strength."@en ;
    skos:notation "CN" ;
    skos:prefLabel "Concrete"@en ;
    skos:topConceptOf cs: ;
.

:genesis-CO
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sediment mass deposited from transport down a slope by gravity (scree), landslide (landslide deposit), mudflow (mudflow deposit), creep (creep deposit) or sheet flow (sheet flow deposit), but not by stream flow. Compared with alluvium, colluvium lacks bedding structure; is more variable in grain size (that is, more poorly sorted); contains much local material; and is generally much more angular. Coarse particles may have particular alignments."@en ;
    skos:notation "CO" ;
    skos:prefLabel "Colluvium"@en ;
    skos:topConceptOf cs: ;
.

:genesis-DR
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-weathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "weathered material (typically soft and clay-rich) produced by thorough decomposition of rock masses due to exposure to land surface processes, but with no transport. It generally lacks any structures that may have been present in the unweathered rock (see also saprolite and partially weathered rock)."@en ;
    skos:notation "DR" ;
    skos:prefLabel "Decomposed rock"@en ;
    skos:topConceptOf cs: ;
.

:genesis-ED
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sediment mass deposited from transport by the wind."@en ;
    skos:notation "ED" ;
    skos:prefLabel "Eolian sediment"@en ;
    skos:topConceptOf cs: ;
.

:genesis-ES
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "eolian sediment of sand size, often taking the form of dunes, with characteristic bedding structures."@en ;
    skos:notation "ES" ;
    skos:prefLabel "Eolian sand"@en ;
    skos:topConceptOf cs: ;
.

:genesis-ET
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "consolidated sedimentary rock consisting of clastic material deposited by the wind.* Includes bioclastic calcarenites."@en ;
    skos:notation "ET" ;
    skos:prefLabel "Eolianite"@en ;
    skos:topConceptOf cs: ;
.

:genesis-EV
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-evaporite ;
    rdfs:isDefinedBy cs: ;
    skos:definition "weak sedimentary rock or sediment formed by the precipitation of solutes from water bodies on the land surface, typically as lacustrine sediments. Includes halite and gypsum."@en ;
    skos:notation "EV" ;
    skos:prefLabel "Evaporite"@en ;
    skos:topConceptOf cs: ;
.

:genesis-FC
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-chemical ;
    rdfs:isDefinedBy cs: ;
    skos:definition "indurated material rich in hydrated oxides of iron (usually goethite and hematite) occurring as cemented nodules and/or concretions, or as massive sheets. This material has been commonly referred to in local usage around Australia as laterite, duricrust or ironstone."@en ;
    skos:notation "FC" ;
    skos:prefLabel "Ferricrete"@en ;
    skos:topConceptOf cs: ;
.

:genesis-FI
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "mass of artificial sediment formed by earth-moving works. Fill is sometimes compacted to the status of a very weak rock mass (stabilised soil), but typically remains an earth mass (Table 36). Garbage forms a very low-density, low-strength fill."@en ;
    skos:notation "FI" ;
    skos:prefLabel "Fill"@en ;
    skos:topConceptOf cs: ;
.

:genesis-HA
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-evaporite ;
    rdfs:isDefinedBy cs: ;
    skos:definition "evaporite consisting of sodium chloride."@en ;
    skos:notation "HA" ;
    skos:prefLabel "Halite (rock salt)"@en ;
    skos:topConceptOf cs: ;
.

:genesis-IG
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "strong or very strong rock masses formed by solidification of molten rock matter (magma) derived from below the Earth’s surface. The rocks are mainly composed of interlocking crystals. Types are distinguished in Table 34. Plutonic rocks and volcanic rocks are included."@en ;
    skos:notation "IG" ;
    skos:prefLabel "Igneous rocks"@en ;
    skos:topConceptOf cs: ;
.

:genesis-IN
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "very weak to strong volcanic rock mass deposited from a flow of ash, the stronger forms being welded together by residual heat during deposition."@en ;
    skos:notation "IN" ;
    skos:prefLabel "Ignimbrite"@en ;
    skos:topConceptOf cs: ;
.

:genesis-KC
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-chemical ;
    rdfs:isDefinedBy cs: ;
    skos:definition "any cemented, terrestrial carbonate accumulation that may vary significantly in morphology and degree of cementation. Also known as carbonate pan, calcareous pan, caliche, kunkar, secondary limestone, travertine. All show slight to strong effervescence with 1-molar HCl."@en ;
    skos:notation "KC" ;
    skos:prefLabel "Calcrete"@en ;
    skos:topConceptOf cs: ;
.

:genesis-LA
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sediment mass deposited from transport by waves and from sediment solution and suspension in still water in a closed depression on land."@en ;
    skos:notation "LA" ;
    skos:prefLabel "Lacustrine sediment"@en ;
    skos:topConceptOf cs: ;
.

:genesis-LC
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-chemical ;
    rdfs:isDefinedBy cs: ;
    skos:definition "strongly indurated siliceous material cemented by, and largely composed of, forms of silica, including quartz, chalcedony, opal and chert."@en ;
    skos:notation "LC" ;
    skos:prefLabel "Silcrete"@en ;
    skos:topConceptOf cs: ;
.

:genesis-LD
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "colluvium rapidly displaced many metres downslope by failure of a mass of earth or rock. If the mass is not already a part of the regolith, the landslide incorporates it in the regolith. Original rock structures are fragmented and disorganised by the action of the landslide."@en ;
    skos:notation "LD" ;
    skos:prefLabel "Landslide deposit"@en ;
    skos:topConceptOf cs: ;
.

:genesis-LO
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "eolian sediment of silt size."@en ;
    skos:notation "LO" ;
    skos:prefLabel "Loess"@en ;
    skos:topConceptOf cs: ;
.

:genesis-MA
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sediment mass deposited from transport by waves and from solution and suspension in sea water."@en ;
    skos:notation "MA" ;
    skos:prefLabel "Marine sediment"@en ;
    skos:topConceptOf cs: ;
.

:genesis-MD
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "colluvium mixed with water to form dense fluid, and rapidly displaced metres or kilometres downslope. The material is more thoroughly disaggregated than that of a landslide deposit and lacks the bedding and sorting of grain sizes seen in alluvium."@en ;
    skos:notation "MD" ;
    skos:prefLabel "Mudflow deposit"@en ;
    skos:topConceptOf cs: ;
.

:genesis-ME
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "moderately strong to very strong rock masses formed by the chemical and physical alterations of igneous or sedimentary rocks under high temperatures and/or very high pressures within the Earth’s crust. Types are distinguished in Table 34."@en ;
    skos:notation "ME" ;
    skos:prefLabel "Metamorphic rocks"@en ;
    skos:topConceptOf cs: ;
.

:genesis-PA
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "fine-grained calcareous eolian sediment consisting of 30–70% clay."@en ;
    skos:notation "PA" ;
    skos:prefLabel "Parna"@en ;
    skos:topConceptOf cs: ;
.

:genesis-PC
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-chemical ;
    rdfs:isDefinedBy cs: ;
    skos:definition "dense argillaceous rock of varying degree of silicification with a conchoidal fracture and general appearance of unglazed porcelain."@en ;
    skos:notation "PC" ;
    skos:prefLabel "Porcellanite"@en ;
    skos:topConceptOf cs: ;
.

:genesis-PL
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "igneous rocks solidified at depth within the Earth’s crust."@en ;
    skos:notation "PL" ;
    skos:prefLabel "Plutonic rocks"@en ;
    skos:topConceptOf cs: ;
.

:genesis-PW
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-weathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "weathered material produced by exposure of rock masses to land surface processes but with no transport. Partial decomposition results in changes in colour, texture, composition, strength or form of the parent rock mass (see also decomposed rock and saprolite)."@en ;
    skos:notation "PW" ;
    skos:prefLabel "Partially weathered rock"@en ;
    skos:topConceptOf cs: ;
.

:genesis-RB
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-chemical ;
    rdfs:isDefinedBy cs: ;
    skos:definition "an informal name used for a particular indurated earthy material (see ‘Pans’, page 143). In many instances it is not known if the red-brown hardpan is a paleosol or a cemented sediment.*"@en ;
    skos:notation "RB" ;
    skos:prefLabel "Red-brown hardpan"@en ;
    skos:topConceptOf cs: ;
.

:genesis-SA
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-weathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "a particular form of decomposed rock. It is characterised by the preservation of structures (including ‘texture’ in the petrological sense) that were present in the unweathered rock."@en ;
    skos:notation "SA" ;
    skos:prefLabel "Saprolite"@en ;
    skos:topConceptOf cs: ;
.

:genesis-SC
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sedimentary rocks in which mineral grains or fragments are not important constituents. The group includes coal, chert and non-fragmental limestones as well as saline rocks (evaporites) such as halite (rock salt) and gypsum. Chemical and organic sedimentary rocks are common in the regolith zone."@en ;
    skos:notation "SC" ;
    skos:prefLabel "Chemical and organic sedimentary rocks"@en ;
    skos:topConceptOf cs: ;
.

:genesis-SD
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sedimentary rocks composed of mineral grains or fragments derived from pre-existing rocks. Types are distinguished in Table 34."@en ;
    skos:notation "SD" ;
    skos:prefLabel "Detrital sedimentary rocks"@en ;
    skos:topConceptOf cs: ;
.

:genesis-SE
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "colluvium deposited after falling or rolling from cliffed or steep slopes, consisting of loose rock fragments of gravel size or larger and generally lacking a fine interstitial component."@en ;
    skos:notation "SE" ;
    skos:prefLabel "Scree"@en ;
    skos:topConceptOf cs: ;
.

:genesis-SH
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "colluvium deposited from transport by a very shallow flow of water as a sheet, or network of rills on the land surface. Sheet flow deposits are very thin except at the foot of a slope and beneath sheet-flood fans."@en ;
    skos:notation "SH" ;
    skos:prefLabel "Sheet flow deposit"@en ;
    skos:topConceptOf cs: ;
.

:genesis-SP
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sedimentary rocks resulting from the deposition of airborne materials produced by volcanic eruptions."@en ;
    skos:notation "SP" ;
    skos:prefLabel "Pyroclastic rocks"@en ;
    skos:topConceptOf cs: ;
.

:genesis-SR
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "weak or moderately strong rock masses formed by the hardening of sediments due to compaction, recrystallisation or cementation. These processes can occur within the regolith but are promoted by burial within the Earth’s crust. Major categories of sedimentary rocks are detrital sedimentary rocks, pyroclastic rocks, and chemical and organic sedimentary rocks."@en ;
    skos:notation "SR" ;
    skos:prefLabel "Sedimentary rocks"@en ;
    skos:topConceptOf cs: ;
.

:genesis-ST
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-hardened-artificial ;
    rdfs:isDefinedBy cs: ;
    skos:definition "artificial mass with the strength grade of very weak rock. It results from the ‘stabilisation’ of an earth mass by a variety of processes: compaction; the admixture of lime, Portland cement, bitumen or other substances; heating; freezing; or electro-hardening. Cement stabilisation can produce a mass as strong as 10 MPa unconfined compressive strength.*"@en ;
    skos:notation "ST" ;
    skos:prefLabel "Stabilised soil"@en ;
    skos:topConceptOf cs: ;
.

:genesis-TI
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "sediment mass deposited from transport in ice, as in a glacier. Till is neither bedded nor sorted; it has a matrix of clay or silt enclosing larger particles of unweathered rock ranging up to large boulders."@en ;
    skos:notation "TI" ;
    skos:prefLabel "Till"@en ;
    skos:topConceptOf cs: ;
.

:genesis-VA
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-sediments ;
    rdfs:isDefinedBy cs: ;
    skos:definition "eolian sediment consisting of relatively fine (<2 mm) pyroclastic material. It often contains a proportion of highly weatherable glass."@en ;
    skos:notation "VA" ;
    skos:prefLabel "Volcanic ash"@en ;
    skos:topConceptOf cs: ;
.

:genesis-VO
    a
        skos:Concept ,
        :Mass-genetic-type ,
        :Rock-genesis-unweathered ;
    rdfs:isDefinedBy cs: ;
    skos:definition "igneous rocks solidified after eruption on to the land surface."@en ;
    skos:notation "VO" ;
    skos:prefLabel "Volcanic rocks"@en ;
    skos:topConceptOf cs: ;
.

:grain-size-1
    a
        skos:Concept ,
        :Substrate-grain-size ;
    rdfs:isDefinedBy cs: ;
    skos:definition "<0.06 mm:	silt- or clay-sized; grains not visible; for example chert, shale, basalt, silt, coal."@en ;
    skos:notation "1" ;
    skos:prefLabel "<0.06 mm"@en ;
    skos:topConceptOf cs: ;
.

:grain-size-2
    a
        skos:Concept ,
        :Substrate-grain-size ;
    rdfs:isDefinedBy cs: ;
    skos:definition "0.06–2 mm:	sand-sized; grains visible; for example sand, sandstone, dolerite, porphyry, sandy tuff, graywacke, micro-granite, schist, quartzite."@en ;
    skos:notation "2" ;
    skos:prefLabel "0.06-2 mm"@en ;
    skos:topConceptOf cs: ;
.

:grain-size-3
    a
        skos:Concept ,
        :Substrate-grain-size ;
    rdfs:isDefinedBy cs: ;
    skos:definition ">2 mm:	gravel-sized; for example gravel, conglomerate, breccia, pebbles, cobbles, stones, boulders, pegmatite, granite, agglomerate."@en ;
    skos:notation "3" ;
    skos:prefLabel ">2 mm"@en ;
    skos:topConceptOf cs: ;
.

