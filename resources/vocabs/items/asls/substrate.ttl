:alteration-F
    a
        skos:Concept ,
        :Rock-alteration ;
    rdfs:isDefinedBy cs: ;
    skos:definition "iron enriched."@en ;
    skos:notation "F" ;
    skos:prefLabel "Ferruginised"@en ;
    skos:topConceptOf cs: ;
.

:alteration-K
    a
        skos:Concept ,
        :Rock-alteration ;
    rdfs:isDefinedBy cs: ;
    skos:definition "calcium carbonate enriched."@en ;
    skos:notation "K" ;
    skos:prefLabel "Calcified"@en ;
    skos:topConceptOf cs: ;
.

:alteration-L
    a
        skos:Concept ,
        :Rock-alteration ;
    rdfs:isDefinedBy cs: ;
    skos:definition "clay enriched, usually pale coloured, for example the pallid zone of a laterite profile."@en ;
    skos:notation "L" ;
    skos:prefLabel "Kaolinised"@en ;
    skos:topConceptOf cs: ;
.

:alteration-O
    a
        skos:Concept ,
        :Rock-alteration ;
    rdfs:isDefinedBy cs: ;
    skos:definition "deeply weathered but no specific nature."@en ;
    skos:notation "O" ;
    skos:prefLabel "Other"@en ;
    skos:topConceptOf cs: ;
.

:alteration-S
    a
        skos:Concept ,
        :Rock-alteration ;
    rdfs:isDefinedBy cs: ;
    skos:definition "silica enriched."@en ;
    skos:notation "S" ;
    skos:prefLabel "Silicified"@en ;
    skos:topConceptOf cs: ;
.

:confidence-certain
    a
        skos:Concept ,
        :Confidence ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Almost certain or certain"@en ;
    skos:notation "A" ;
    skos:prefLabel "Almost certain or certain"@en ;
    skos:topConceptOf cs: ;
.

:confidence-doubtful
