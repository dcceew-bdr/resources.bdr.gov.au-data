:cover-class-D
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Crowns touching to overlapping 	Crown separation ratio<0	Crown cover %>80%	Foliage cover %>70%"@en ;
    skos:notation "D" ;
    skos:prefLabel "Closed or dense"@en ;
    skos:topConceptOf cs: ;
.

:cover-class-E
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Emergent 	Crown separation ratio >3	Crown cover % <0.5% of total crown cover	Foliage cover % <3% of total foliage cover"@en ;
    skos:notation "E" ;
    skos:prefLabel "Emergent"@en ;
    skos:topConceptOf cs: ;
.

:cover-class-I
    a skos:Concept ;
