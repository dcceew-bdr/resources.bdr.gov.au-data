        <http://linked.data.gov.au/def/tern-cv/647cc9ca-3d55-4336-840d-d0a0b6d36231> ,
        <http://linked.data.gov.au/def/tern-cv/8d116443-a711-4c47-816c-71a099e113e9> ,
        <http://linked.data.gov.au/def/tern-cv/b3b56ae7-bd42-46e3-9391-cac2352a306f> ,
        <http://linked.data.gov.au/def/tern-cv/fe3b31bf-43af-4735-9d7d-8830fa27e559> ;
    skos:prefLabel "Sex"@en ;
    schema:codeRepository <https://github.com/dcceew-bdr/resources.bdr.gov.au-data/> ;
    schema:creator <https://linked.data.gov.au/org/bdr-team> ;
