PREFIX cs: <https://linked.data.gov.au/dataset/bdr/bdr-cv/parameter/sex>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<http://linked.data.gov.au/def/tern-cv/647cc9ca-3d55-4336-840d-d0a0b6d36231>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "F"@en ,
        "♀"@en ;
    skos:definition "Female (♀) is the sex of an organism, or a part of an organism, which produces mobile ova (egg cells)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "FEMALE"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/8d116443-a711-4c47-816c-71a099e113e9>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "UNDET."@en ,
        "UNKNOWN"@en ;
    skos:definition "If the sex of an organism can't be determined for some reason."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "UNDETERMINED"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/b3b56ae7-bd42-46e3-9391-cac2352a306f>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "M"@en ,
        "♂"@en ;
    skos:definition "Male (♂) refers to the sex of an organism, or part of an organism, which produces small mobile gametes, called spermatozoa."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "MALE"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/fe3b31bf-43af-4735-9d7d-8830fa27e559>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ZWITTER"@en ;
    skos:definition "One organism having both male and female sexual characteristics and organs; at birth an unambiguous assignment of male or female cannot be made"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "HERMAPHRODITE"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition """A type of sex.

This is an open-ended vocabulary

Proposed as narrower terms of http://linked.data.gov.au/def/tern-cv/05cbf534-c233-4aa8-a08c-00b28976ed36

This vocabulary was generated from application code used to convert CSV data to ABIS RDF in the repository https://github.com/dcceew-bdr/abis-mapping."""@en ;
