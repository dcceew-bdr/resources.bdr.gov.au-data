PREFIX cs: <https://linked.data.gov.au/dataset/bdr/bdr-cv/attribute/relationshipToRelatedSite>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

schema:isPartOf
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "When a site is a subset of another site."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "PART OF"@en ;
    skos:topConceptOf cs: ;
.

schema:sameAs
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "When two sites are the same."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SAME AS"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition """Vocabulary for relationship to related site.

This is a closed vocabulary

This vocabulary was generated from application code used to convert CSV data to ABIS RDF in the repository https://github.com/dcceew-bdr/abis-mapping."""@en ;
    skos:hasTopConcept
        schema:isPartOf ,
        schema:sameAs ;
    skos:prefLabel "Relationship To Related Site"@en ;
    schema:codeRepository <https://github.com/dcceew-bdr/resources.bdr.gov.au-data/> ;
    schema:creator <https://linked.data.gov.au/org/bdr-team> ;
    schema:dateCreated "2026-09-20"^^xsd:date ;
    schema:dateModified "2026-09-20"^^xsd:date ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:publisher <https://linked.data.gov.au/org/dcceew> ;
.
