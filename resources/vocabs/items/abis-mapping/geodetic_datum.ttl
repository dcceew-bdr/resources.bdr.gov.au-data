PREFIX cs: <https://linked.data.gov.au/dataset/bdr/bdr-cv/attribute/geodeticDatum>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<http://www.opengis.net/def/crs/EPSG/0/4202>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "EPSG:4202"@en ;
    skos:definition "Australian Geodetic Datum 1966"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "AGD66"@en ;
    skos:topConceptOf cs: ;
.

<http://www.opengis.net/def/crs/EPSG/0/4203>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "EPSG:4203"@en ;
    skos:definition "Australian Geodetic Datum 1984"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "AGD84"@en ;
    skos:topConceptOf cs: ;
.

<http://www.opengis.net/def/crs/EPSG/0/4283>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "EPSG:4283"@en ;
    skos:definition "Geocentric Datum of Australia 1994"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GDA94"@en ;
    skos:topConceptOf cs: ;
.

<http://www.opengis.net/def/crs/EPSG/0/4326>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "EPSG:4326"@en ;
    skos:definition "World Geodetic System 1984, used in GPS"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "WGS84"@en ;
    skos:topConceptOf cs: ;
.

<http://www.opengis.net/def/crs/EPSG/0/7844>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "EPSG:7844"@en ;
    skos:definition "Geocentric Datum of Australia 2020"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GDA2020"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition """Vocabulary for geodetic datum.

This is a closed vocabulary

This vocabulary was generated from application code used to convert CSV data to ABIS RDF in the repository https://github.com/dcceew-bdr/abis-mapping."""@en ;
    skos:hasTopConcept
        <http://www.opengis.net/def/crs/EPSG/0/4202> ,
        <http://www.opengis.net/def/crs/EPSG/0/4203> ,
        <http://www.opengis.net/def/crs/EPSG/0/4283> ,
        <http://www.opengis.net/def/crs/EPSG/0/4326> ,
        <http://www.opengis.net/def/crs/EPSG/0/7844> ;
    skos:prefLabel "Geodetic Datum"@en ;
    schema:codeRepository <https://github.com/dcceew-bdr/resources.bdr.gov.au-data/> ;
    schema:creator <https://linked.data.gov.au/org/bdr-team> ;
    schema:dateCreated "2026-09-20"^^xsd:date ;
    schema:dateModified "2026-09-20"^^xsd:date ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:publisher <https://linked.data.gov.au/org/dcceew> ;
.
