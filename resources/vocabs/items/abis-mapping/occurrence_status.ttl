cs:
    a skos:ConceptScheme ;
    skos:definition """A type of occurrenceStatus.

This is an open-ended vocabulary

Proposed as narrower terms of http://linked.data.gov.au/def/tern-cv/835d7166-2a4d-4335-9d39-8082ff201811

This vocabulary was generated from application code used to convert CSV data to ABIS RDF in the repository https://github.com/dcceew-bdr/abis-mapping."""@en ;
    skos:hasTopConcept
        <http://linked.data.gov.au/def/tern-cv/2ca99992-75ff-4b48-b426-ca86a0b5d40f> ,
        <http://linked.data.gov.au/def/tern-cv/a2fb93cd-ad72-4c15-b23b-14882c2418c2> ;
    skos:prefLabel "Occurrence Status"@en ;
    schema:codeRepository <https://github.com/dcceew-bdr/resources.bdr.gov.au-data/> ;
    schema:creator <https://linked.data.gov.au/org/bdr-team> ;
