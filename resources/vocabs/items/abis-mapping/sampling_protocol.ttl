.

<http://linked.data.gov.au/def/tern-cv/fd083167-3cbf-4f7e-a611-4550a5926a8b>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The method used was not included in the data."@en ;
