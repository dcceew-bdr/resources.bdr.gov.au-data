    skos:inScheme cs: ;
    skos:prefLabel "WOODLAND"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/e28adc38-5e40-5795-93d1-6582d0013f7e>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the NVIS dominant vegetation structural formation class, with a percent cover of about 0.25-20% of grasses."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPARSE GRASSLAND"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/e692ff93-02cd-5bdf-bc4e-8f76de59089a>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the NVIS dominant vegetation structural formation class, with a percent cover of about 0-5% members of Fern and Fern-allies."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ISOLATED CLUMPS OF FERNS"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/eba388b7-bf44-5c65-b468-aebb1afbc5e2>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the NVIS dominant vegetation structural formation class, with a percent cover of about 0.25-20% of tussock grass (e.g., Poa species)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPARSE TUSSOCK GRASSLAND"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/f03afa59-394c-50e6-ba58-3b7dc38a1363>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the NVIS dominant vegetation structural formation class, with a percent cover of about <0.25% of forbs or herbs other than grasses."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ISOLATED FORBS"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/f20b4449-da26-5423-ad11-eeed042e4072>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the type of habitat characterised by well separated or very sparse crown stragglers or woody vines."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPARSE VINELAND"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/f2c496b6-ea23-546b-83f2-14ebb6f5ca82>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the type of habitat characterised by isolated clumps of sod grass."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ISOLATED CLUMP OF SOD GRASSES"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/f51c20dd-6026-5b24-9f5f-a705b8d88a95>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the type of habitat characterised by isolated clumps of tussock grasses (e.g., Poa spp)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ISOLATED CLUMP OF TUSSOCK GRASSES"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/f5a80ba0-7b0b-51ee-bfd3-8e96199e8298>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the type of habitat characterised by isolated clumps of lichens."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ISOLATED CLUP OF LICHENS"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/f5e68c19-0e4c-5aa9-8076-7879f2a6cce4>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the NVIS dominant vegetation structural formation class, with a percent cover of about 50-80% of shrub mallee (e.g., individuals of some Eucalypts multistemmed from base)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "MALLEE SHRUBLAND"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/f62e2bf1-408f-536e-9da1-82d7e980498c>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the type of habitat characterised by isolated clumps of hummocky grass (e.g., Triodia spp., Spinifex spp.)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ISOLATED CLUMP OF HUMMOCK GRASSES"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/def/nrm/f8c0c37c-3021-5f90-bb23-658966b5326d>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Refers to the type of habitat characterised by isolated clumps of vines."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ISOLATED CLUMP OF VINES"@en ;
    skos:topConceptOf cs: ;
.

