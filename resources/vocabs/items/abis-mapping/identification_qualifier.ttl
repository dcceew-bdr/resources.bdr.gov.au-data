PREFIX cs: <https://linked.data.gov.au/dataset/bdr/bdr-cv/attribute/identificationQualifier>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<http://linked.data.gov.au/def/tern-cv/0325eb2d-e89d-4976-8e3e-9a6ff8c0d460>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "SP."@en ;
    skos:definition "The specimen has not been identified, nor it has been related to any known species; the uncertainty is potentially provisional: it could be due to the lack of suitable dichotomous keys, or to the occurrence of a species not previously described. Also used in the sense of species indeterminabilis and stetit (these usages are discouraged."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPECIES"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/1eca8b2f-0d8a-4638-ba85-6f380005901b>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "SP. INC."@en ;
    skos:definition "The identification is uncertain; it usually indicates a higher reliability with ?, sp. Inc respect to confer. The sign \"sp. inc.\" is also used in the sense of species, species indeterminabilis and species inquirenda (these usages are discouraged)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPECIES INCERTA"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/2586fc89-269d-468a-9f43-87de53408519>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "N. SP."@en ,
        "NOV. SP."@en ,
        "NOV. SPEC."@en ,
        "SP. N."@en ,
        "SP. NOV."@en ,
        "SPEC. NOV."@en ;
    skos:definition "The specimen is considered to belong to a new, previously undescribed (1) When describing a new species, the use of the qualifier is required by the ICZN (1999) to explicitly indicate the taxa name as intentionally new. (2) Used as ON qualifier to refer to a new, still unnamed species before the formal publication of the description."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPECIES NOVA"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/3af18778-ea6e-4e5e-8ec0-da9d59f4d075>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "EX GR."@en ,
        "GR."@en ;
    skos:definition "\"Of the group including\". The specimen has some affinity to a known species or it belongs to a species group or species complex; see also affinis and species proxima."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "EX GREGE"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/4b2f5fc9-3dc9-499c-b334-3563f757cf0a>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "CF."@en ,
        "CFR."@en ,
        "CONF."@en ,
        "SP. CF."@en ;
    skos:definition "\"Compare with\". Specimens should be compared to reference material, since most of the diagnostic characters correspond to a given species but some are unclear. Also used in the sense of affinis and species incerta (these usages are discouraged)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "CONFER"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/4e24b030-b2a2-476a-9c9b-bac2b636eb98>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "G. N."@en ,
        "G. NOV."@en ,
        "GEN. N."@en ,
        "GEN. NOV."@en ,
        "NOV. GEN"@en ;
    skos:definition "The specimen is considered to belong to a new species and a new genus; for more details, see species nova"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GENUS NOVUM"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/591a8af1-dd89-4b79-a663-2ef18d3a5258>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "G. SP."@en ,
        "GEN. SP."@en ;
    skos:definition "The specimen has not been related to any known species nor genus; also species."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GENUS SPECIES"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/81f8cfa5-f4f5-4434-b140-04402835d346>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "IND."@en ,
        "INDET."@en ,
        "SP. IND."@en ,
        "SP. INDET."@en ;
    skos:definition "The specimen is indeterminable beyond a certain taxonomic level due to the deterioration or lack of diagnostic characters. Also used in the sense of species and stetit (these usages are discouraged."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPECIES INDETERMINABILIS"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/86586db3-6e5e-4e3f-8e67-9e9c39161fe3>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "A.C."@en ;
    skos:definition "It groups all the unidentified specimens that are not listed as separate taxa. The term cetera (abbreviated c. or cet.) may be applied to a given high-rank taxon, meaning that identification at a lower taxonomic level has not been attempted (see also stetit) but explicitly not including subordinate taxa that may have been identified."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "ANIMALIA CETERA"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/8ff9701a-af67-435b-a1bf-030125235fc2>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "STET."@en ;
    skos:definition "Identification at a lower taxonomic level has not been attempted, even if allowed by the sample conditions. It may also be used when more records with different ON qualifiers need to be merged at a safe taxonomic level."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "STETIT"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/a7239472-6773-4ba0-b420-4b233fc7c13a>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "GEN. ET SP."@en ,
        "GEN. NOV."@en ,
        "NOV. GEN. ET SP."@en ,
        "SP. NOV."@en ;
    skos:definition "The specimen is considered to belong to a new species and a new genus; for more details, see species nova."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "GENUS ET SPECIES NOVA"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/aa8f0f92-83d1-4b54-9a09-16b26a407f70>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "SSP."@en ,
        "SUBSP."@en ;
    skos:definition "The only infraspecific rank regulated by the ICZN (1999). As ON qualifier, it indicates that the specimen probably belongs to a subspecies but it has not been related to any known one; see also species."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SUBSPECIES"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/b9a121e0-591f-4f49-9004-1ff46523bf26>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "FAM. GEN. SP."@en ;
    skos:definition "The specimen has not been attributed to any known species nor family; see also species."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "FAMILIA GENUS SPECIES"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/e09b5da0-8a77-4b33-b051-a616a3ccf087>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "NR."@en ,
        "PROX."@en ,
        "SP. PROX."@en ,
        "SP.NR."@en ;
    skos:definition "The specimen is near to a known species but it is not identical to it; see also affinis and ex grege."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPECIES PROXIMA"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/f17e64f8-02c1-40c5-9ad2-51155c92e0a3>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "AFF."@en ,
        "SP. AFF."@en ;
    skos:definition "\"Has affinity with\". The specimen has some affinity to a known species but it is not identical to it; it generally implies distinction more than a possible identity, in contrast with the qualifier confer; see also species Proxima and ex grege. It is often used in combination with the ON qualifier species nova. Also used in the sense of confer (this usage is discouraged)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SPECIES AFFINIS"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition """A type of identificationQualifier.

This is an open-ended vocabulary

Proposed as narrower terms of http://linked.data.gov.au/def/tern-cv/88f031cb-fed1-46fd-985d-f31ba0fd603e

This vocabulary was generated from application code used to convert CSV data to ABIS RDF in the repository https://github.com/dcceew-bdr/abis-mapping."""@en ;
