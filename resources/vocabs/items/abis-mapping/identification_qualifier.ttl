        <http://linked.data.gov.au/def/tern-cv/86586db3-6e5e-4e3f-8e67-9e9c39161fe3> ,
        <http://linked.data.gov.au/def/tern-cv/8ff9701a-af67-435b-a1bf-030125235fc2> ,
        <http://linked.data.gov.au/def/tern-cv/a7239472-6773-4ba0-b420-4b233fc7c13a> ,
        <http://linked.data.gov.au/def/tern-cv/aa8f0f92-83d1-4b54-9a09-16b26a407f70> ,
        <http://linked.data.gov.au/def/tern-cv/b9a121e0-591f-4f49-9004-1ff46523bf26> ,
        <http://linked.data.gov.au/def/tern-cv/e09b5da0-8a77-4b33-b051-a616a3ccf087> ,
        <http://linked.data.gov.au/def/tern-cv/f17e64f8-02c1-40c5-9ad2-51155c92e0a3> ;
    skos:prefLabel "Identification Qualifier"@en ;
