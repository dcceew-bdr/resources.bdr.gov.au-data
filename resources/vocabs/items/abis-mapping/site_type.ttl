<http://linked.data.gov.au/def/tern-cv/4362c8f2-b3cc-4816-b5a2-fb7bb4c0cff5>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A transportable frame (usually a square made out of PVC tube, metal rod or wood) used to isolate a standard unit of area for study of the distribution of item(s) over a large area (e.g. a plot)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "QUADRAT"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/5bf7ae21-a454-440b-bdd7-f2fe982d8de4>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A place in which study/protocol/sampling activities are conducted."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "SITE"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/8cadf069-01d7-4420-b454-cae37740c2a2>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Land area selected from within a survey region which abiotic and biotic properties are sampled."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "PLOT"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/de46fa49-d1c9-4bef-8462-d7ee5174e1e1>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A line along which biotic and abiotic characteristics are sampled"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "TRANSECT"@en ;
    skos:topConceptOf cs: ;
.

<http://linked.data.gov.au/def/tern-cv/ffbe3c8c-23f1-4fc4-8aaf-dfba9f12576c>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Parent site."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "PARENT SITE"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition """A type of site.

