cs:
    a skos:ConceptScheme ;
    skos:definition """A type of sensitivityAuthority.

This is an open-ended vocabulary

Proposed as narrower terms of https://linked.data.gov.au/dataset/bdr/bdr-cv/attribute/sensitivityAuthority

This vocabulary was generated from application code used to convert CSV data to ABIS RDF in the repository https://github.com/dcceew-bdr/abis-mapping."""@en ;
    skos:prefLabel "Sensitivity Authority"@en ;
    schema:codeRepository <https://github.com/dcceew-bdr/resources.bdr.gov.au-data/> ;
    schema:creator <https://linked.data.gov.au/org/bdr-team> ;
    schema:dateCreated "2026-09-20"^^xsd:date ;
    schema:dateModified "2026-09-20"^^xsd:date ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:publisher <https://linked.data.gov.au/org/dcceew> ;
    skos:hasTopConcept <https://linked.data.gov.au/dataset/bdr/bdr-cv/methods/sensitivityAuthority/placeholder> ;
.

<https://linked.data.gov.au/dataset/bdr/bdr-cv/methods/sensitivityAuthority/placeholder>
    a skos:Concept ;
