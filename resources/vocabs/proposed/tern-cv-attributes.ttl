<https://linked.data.gov.au/def/tern-cv/61311a0e-5b09-406c-9f64-b0637271ecf2>
    a skos:Concept ;
    dcterms:created "2021-04-20"^^xsd:date ;
    dcterms:modified "2025-09-09"^^xsd:date ;
    rdfs:isDefinedBy <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:definition "A smaller sampling unit established within a larger plot, used to collect more detailed or specific measurements of abiotic or biotic properties. Subplots help capture variability within the main plot and support finer-scale analysis. The plot that is part of the main survey plot."@en ;
    skos:historyNote "Updated on 10/09/2025: added this concept to Site type scheme, updated the definition so that it fits in both Attribute and Site Type scheme." ;
    skos:inScheme cs: ;
    skos:prefLabel "subplot"@en ;
    skos:topConceptOf cs: ;
.

