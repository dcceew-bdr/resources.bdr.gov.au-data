<https://linked.data.gov.au/def/tern-cv/9b2ab960-da97-473a-81af-d50ab6041739>
    a skos:Concept ;
    dcterms:modified "2025-12-08"^^xsd:date ;
    dcterms:source "White, A, Sparrow, B, Leitch, E, Foulkes, J, Flitton, R, Lowe, A & Caddy-Retalic, S 2012, 'AusPlots Rangelands Survey Protocols Manual, Version 1.2. 9 2012, p.36', University of Adelaide Press, South Australia." ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/tern-cv/5699eca7-9ef0-47a6-bcfb-9306e0e2b85e> ;
    skos:altLabel "canopy point intercept"@en ;
    skos:broader <https://linked.data.gov.au/def/tern-cv/1337fc2b-3dd2-4c69-ac38-9e05ae7ef1e9> ;
    skos:definition "A vertical line of sight from beneath a tree or shrub canopy that passes through open space within the canopy boundary without intersecting any foliage or branches. This is recorded when the densitometer sighting falls within the canopy perimeter but no vegetation is intercepted by the crosshairs."@en ;
    skos:historyNote "In earlier version, the definition was 'If foliage or branches are not intercepted, it is recorded as 'in-canopy sky'. If foliage or branches are   intercepted, the species is recorded as a canopy hit and an estimate of the height is recorded'. The 14/08/2025 update refined the definition." ;
    skos:inScheme cs: ;
    skos:prefLabel "in-canopy sky"@en ;
    skos:topConceptOf cs: ;
.

