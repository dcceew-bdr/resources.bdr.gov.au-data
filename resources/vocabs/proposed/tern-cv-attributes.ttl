<https://linked.data.gov.au/def/tern-cv/add0c5d2-6db5-48e4-9ad3-d789ba9fe0a2>
    a skos:Concept ;
    dcterms:modified "2025-12-09"^^xsd:date ;
    dcterms:source "1: Neldner, V.J., Wilson, B.A., Dillewaard, H.A., Ryan, T.S., Butler, D.W., McDonald, W.J.F, Addicott, E.P. and Appelman, C.N. (2020) Methodology for survey and mapping of regional ecosystems and vegetation communities in Queensland. Version 5.1. Updated March 2020. Page 68. Queensland Herbarium, Queensland Department of Environment and Science, Brisbane. 2: Karan, M. (2015). SuperSites Vegetation Monitoring Protocols v 1.21 p23. TERN Australian SuperSite Network. Cairns, Australia." ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/tern-cv/5699eca7-9ef0-47a6-bcfb-9306e0e2b85e> ;
    skos:broader <https://linked.data.gov.au/def/tern-cv/1c8949fe-dede-41ed-a766-ef45342a08ef> ;
    skos:closeMatch <http://vocabs.lter-europe.net/EnvThes/20286> ;
    skos:definition "1: A description of the community represented by the site in terms of the predominant species and structure and if appropriate, associated environment (such as landform geology). 2: A set of images captured at the site annually or less frequently using the same protocol, to provide information about the vegetation community represented at the site and any changes that occur over time."@en ;
    skos:inScheme cs: ;
    skos:mappingRelation <http://vocabs.lter-europe.net/EnvThes/20286> ;
    skos:prefLabel "vegetation community site context"@en ;
.

