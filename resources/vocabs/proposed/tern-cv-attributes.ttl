    skos:broader <https://linked.data.gov.au/def/tern-cv/0b6619d6-0b4b-4540-ae14-150616a3da85> ;
    skos:definition "The mathematical relationship between the angle formed by the aperture of the sights on the TERN Basal Wedge and the distance it is held from the observer’s eye."@en ;
    skos:historyNote
        "09/09/2025 updated to include tern:hasInstrumentType." ,
        "In earlier versions, the definition was 'Factor gauge or wedge size selected when estimating basal area with an angle gauge size', with source Carron (1968). Updated on 27 August 2025 to update the source and include notation" ;
    skos:inScheme cs: ;
    skos:notation "BAF" ;
    skos:prefLabel "basal area factor"@en ;
    tern:hasInstrumentType <https://linked.data.gov.au/def/tern-cv/8f799772-ddd8-4b61-bf09-83279e1d461d> ;
    tern:hasMethod <https://linked.data.gov.au/def/ausplots-cv/872d0b1d-3ed0-4e25-a31a-f3ee4336acc6> ;
.

