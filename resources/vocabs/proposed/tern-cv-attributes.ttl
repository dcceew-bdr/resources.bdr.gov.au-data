<https://linked.data.gov.au/def/tern-cv/56195246-ec5d-4050-a1c6-af786fbec715>
    a skos:Concept ;
    dcterms:created "2021-02-01"^^xsd:date ;
    dcterms:description "A scientific name is a formal, standardized biological name given to an organism of interest and may represent a taxonomic rank (e.g., family, genus, species, etc.). The names are usually compliant with the most recent nomenclature codes. This is not to be confused with 'taxon', which represents a group of organisms listed under hierarchical taxonomic ranks." ;
    dcterms:modified "2025-12-08"^^xsd:date ;
    dcterms:source "Darwin Core Maintenance Group. 2021. List of Darwin Core terms. Biodiversity Information Standards (TDWG). http://rs.tdwg.org/dwc/doc/list/2021-07-15" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/tern-cv/5699eca7-9ef0-47a6-bcfb-9306e0e2b85e> ;
