        <https://linked.data.gov.au/def/tern-cv/56195246-ec5d-4050-a1c6-af786fbec715> ;
    skos:definition "The formal biological name, with authorship and date information, if known. When forming part of an identification, this should be the name in lowest level taxonomic rank that can be determined."@en ;
    skos:exactMatch
        <https://dwc.tdwg.org/list/#dwc_scientificName> ,
        <https://linked.data.gov.au/def/tern-cv/56195246-ec5d-4050-a1c6-af786fbec715> ;
    skos:inScheme cs: ;
    skos:mappingRelation
        <https://dwc.tdwg.org/list/#dwc_scientificName> ,
