<https://linked.data.gov.au/def/tern-cv/43ed01cc-0089-4a6b-8754-0990dd0f697b>
    a skos:Concept ;
    dcterms:description "The stratum type here refers to the stratum where dominant/codominant species occur. Dominant/codominant species are defined as species that dominate the tallest stratum with a canopy cover greater than or equal to 5%.  If there are no layers that have a canopy cover of greater than or equal to 5% then the dominant/codominant overstorey species are defined as species that dominate the tallest layer which has the maximum recorded cover/abundance.  An emergent species is defined as a species that emerges above the overstorey and occupies a stratum that has a canopy cover less than 5%.  Emergents are always in a layer taller than the dominant structure and therefore cannot be a part of the dominant structural layer e.g., Banksia ornata shrubland with <em>Eucalyptus arenacea</em> emergents."^^rdf:HTML ;
    dcterms:modified "2025-12-08"^^xsd:date ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/tern-cv/5699eca7-9ef0-47a6-bcfb-9306e0e2b85e> ;
    skos:altLabel "dominant stratum type" ;
    skos:broader <https://linked.data.gov.au/def/tern-cv/1337fc2b-3dd2-4c69-ac38-9e05ae7ef1e9> ;
    skos:definition "Vertical layer of vegetation (e.g. shrubs, ground layer, top canopy)."@en ;
    skos:historyNote "Updated on 10/09/2025 with adding hasCategoricalCollection." ;
    skos:inScheme cs: ;
    skos:prefLabel "stratum type"@en ;
    skos:topConceptOf cs: ;
    tern:hasCategoricalCollection
        <https://linked.data.gov.au/def/tern-cv/6e5ce9f0-0774-4c04-b167-09527b196d86> ,
        <https://linked.data.gov.au/def/tern-cv/da937d30-faa0-4a72-a948-dab4d239606a> ;
.

