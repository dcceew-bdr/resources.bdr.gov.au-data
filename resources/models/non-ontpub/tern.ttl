tern:Calibration
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    skos:definition "An activity to calibrate properties of a System (such as a Sensor or Sampler) to ensure accurate measurements and proper functioning of the device."@en ;
    skos:example "For example, calibrating a temperature sensor against a reference thermometer to ensure accurate temperature readings, or calibrating a pH meter using standard buffer solutions." ;
    skos:prefLabel "Calibration"@en ;
.

tern:MobilePlatform
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Platform ;
    skos:definition "A moving mobile platform on land, in water or in space."@en ;
    skos:prefLabel "Mobile Platform"@en ;
.

tern:Observation
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        prov:Activity ,
        sosa:Observation ;
    skos:definition "Act of carrying out an (`Observation`) `Procedure` to estimate or calculate a value of a property of a `FeatureOfInterest`. Links to a `Sensor` to describe what made the `Observation` and how; links to an `ObservableProperty` to describe what the result is an estimate of, and to a `FeatureOfInterest` to detail what that property was associated with."@en ;
    skos:example """The activity of measuring properties such as wind speed and direction by
an anemometer sensor. The results of the observation are the measurement values
of the properties estimated by the sensor.""" ;
    skos:prefLabel "Observation"@en ;
.

tern:Result
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf sosa:Result ;
    skos:definition "The result of an `Observation`, `Actuation`, or act of `Sampling`. To store an observation's simple result value one can use the `hasSimpleResult` property."@en ;
    skos:example """The value 20 as the height of a certain
tree together with the unit, e.g., Meter.""" ;
    skos:prefLabel "Result"@en ;
.

tern:Sampling
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        prov:Activity ,
        sosa:Sampling ;
    skos:definition "An activity of `Sampling` carries out a (`Sampling`) `Procedure` to create or transform one or more `Samples`."@en ;
    skos:prefLabel "Sampling"@en ;
    skos:scopeNote """Crushing a rock sample in a ball mill to create sub-samples of the rock.
Digging a pit through a soil sequence.
Dividing a field site into quadrants.
Drawing blood from a patient.
Drilling an observation well.
Establishing a station for environmental monitoring.
Registering an image of the landscape.
Sieving a powder to separate the subset finer than 100-mesh.
Selecting a subset of a population.
Splitting a piece of drill-core to create two new samples.
Taking a diamond-drill core from a rock outcrop.""" ;
.

tern:SiteVisit
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Survey ;
    skos:definition "A Site Visit is a `Survey` that visits a `Site`."@en ;
    skos:prefLabel "Site Visit"@en ;
.

tern:Survey
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf prov:Activity ;
    skos:definition "A Survey is an `Activity` during which `Sampling` or `Observation` Activities occur."@en ;
    skos:prefLabel "Survey"@en ;
.

tern:globalMatch
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    owl:inverseOf tern:isGlobalMatchOf ;
    skos:definition "Link a concept to an upper concept (in the closed system)."@en ;
    skos:prefLabel "global match"@en ;
    skos:scopeNote "Use in between controlled vocabularies." ;
.

tern:hasAttribute
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Attribute ;
    rdfs:subPropertyOf ssn:hasProperty ;
    owl:inverseOf tern:isAttributeOf ;
    skos:definition "Link to an Attribute."@en ;
    skos:prefLabel "has attribute"@en ;
.

tern:hasMethod
    a rdf:Property ;
    rdfs:subPropertyOf skos:relatedMatch ;
    skos:definition "A property that links a `Concept` or `Procedure` to a `Method`."@en ;
    skos:prefLabel "has method"@en ;
.

tern:hasSamplingPoint
    a rdf:Property ;
    owl:inverseOf tern:isSamplingPointOf ;
    skos:definition "A property that links, e.g., a Sampling to a SamplingPoint."@en ;
    skos:prefLabel "has sampling point"@en ;
.

tern:hasSite
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Site ;
    skos:definition "A property that links, e.g., a Site Visit to a Site."@en ;
    skos:prefLabel "has site"@en ;
.

tern:isAttributeOf
    a owl:ObjectProperty ;
    rdfs:domain tern:Attribute ;
    rdfs:isDefinedBy ont: ;
    owl:inverseOf tern:hasAttribute ;
    skos:definition "Link from an [Attribute](https://w3id.org/tern/ontologies/tern/Attribute) to some individual."@en ;
    skos:prefLabel "is attribute of"@en ;
.

tern:isGlobalMatchOf
    a rdf:Property ;
    rdfs:subPropertyOf skos:exactMatch ;
    owl:inverseOf tern:globalMatch ;
    skos:definition "An inverse property of [globalMatch](#globalMatch); Links an upper concept to a concept (in the closed system)."@en ;
    skos:prefLabel "is global match of"@en ;
    skos:scopeNote "Use in between controlled vocabularies." ;
.

tern:isSamplingPointOf
    a rdf:Property ;
    owl:inverseOf tern:hasSamplingPoint ;
    skos:definition "The inverse property [hasSamplingPoint](#hasSamplingPoint)."@en ;
    skos:prefLabel "is sampling point of"@en ;
.

tern:isSiteVisitOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    owl:inverseOf tern:isSiteVisitOf ;
    skos:prefLabel "is site visit of"@en ;
.

<https://w3id.org/tern/resources/19f47957-556a-41aa-bd38-a9e63c111fcb>
    a sdo:Person ;
    sdo:affiliation <https://linked.data.gov.au/org/tern> ;
    sdo:email "j.sanchezgonzalez@uq.edu.au"^^xsd:anyURI ;
    sdo:name "Javier Sanchez Gonalez" ;
.

<https://w3id.org/tern/resources/1c1b4f10-23a9-474d-8f45-2d4c27db863e>
    a sdo:Person ;
    sdo:affiliation <https://linked.data.gov.au/org/tern> ;
    sdo:email "mosheh.eliyahu@adelaide.edu.au"^^xsd:anyURI ;
    sdo:name "Mosheh Eliyahu" ;
.

<https://w3id.org/tern/resources/cbd72114-5fa0-410a-b6c1-73a3fd8f111e>
    a sdo:Person ;
    sdo:affiliation <https://linked.data.gov.au/org/tern> ;
    sdo:email "junrong.yu@uq.edu.au"^^xsd:anyURI ;
    sdo:name "Junrong Yu" ;
.

tern:Attribute
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf ssn:Property ;
    skos:definition "A property-value pair to capture attributes of an individual where observations are not suitable."@en ;
    skos:prefLabel "Attribute"@en ;
    skos:scopeNote "Follows a similar modelling pattern to link:https://schema.org/PropertyValue[`schema:PropertyValue`]." ;
.

tern:FeatureOfInterest
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    skos:definition "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling."@en ;
    skos:example "When measuring the height of a tree, the height is the observed ObservableProperty, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuator."@en ;
    skos:prefLabel "Feature of Interest"@en ;
.

tern:FixedPlatform
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Platform ;
    skos:definition "A fixed platform based on land."@en ;
    skos:prefLabel "Fixed Platform"@en ;
.

tern:Site
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        tern:Platform ,
        tern:Sample ;
    skos:definition "An ecological monitoring site where observations and samplings occur. This `Site` class is a subclass of `Sample` since ecological sites are designed to be representative of an environmental system (which may be an ecosystem or bioregion) or zone (which may be a zone such as a parcel or tract)."@en ;
    skos:prefLabel "Site"@en ;
    skos:scopeNote "Ausplots Rangelands Site 59858 (Site Name: WAACOO0011)" ;
.

tern:System
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf ssn:System ;
    skos:definition "System is a unit of abstraction for pieces of infrastructure that implement Procedures. A System may have components, its subsystems, which are other Systems."@en ;
    skos:prefLabel "System"@en ;
.

<https://w3id.org/tern/resources/a083902d-d821-41be-b663-1d7cb33eea66>
    a sdo:Organization ;
    sdo:identifier <https://w3id.org/tern/resources/a083902d-d821-41be-b663-1d7cb33eea66> ;
    sdo:name "TERN" ;
    sdo:url "https://www.tern.org.au"^^xsd:anyURI ;
.

tern:IGSN
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    skos:definition "A globally unique identifier assigned to physical samples to enable traceability, citation, and reuse in scientific research, adhering to FAIR data principles."@en ;
    skos:example "The IGSN 'AU1234567' represents a rock sample collected from a geological survey in Australia, with metadata detailing its location, collection date, and characteristics." ;
    skos:prefLabel "IGSN"@en ;
.

tern:Platform
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf sosa:Platform ;
    skos:definition "An entity that hosts other entities, particularly Sensors, Samplers, and other Platforms."@en ;
    skos:example """Ocean buoy is an example of platform that is equipped with
an array of sensors such as GPS, current meters, atmospheric sensors and water
quality monitors. Sensors measuring weather variables are attached to
a weather station (a platform)""" ;
    skos:prefLabel "Platform"@en ;
.

tern:Sample
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        sosa:Sample ,
        tern:FeatureOfInterest ,
        tern:Result ;
    skos:definition "A feature which is intended to be representative of a `FeatureOfInterest` on which `Observations` may be made."@en ;
    skos:prefLabel "Sample"@en ;
    skos:scopeNote "A sample may be a physical sample or a sub-divided section of some larger feature of interest. For example, land surface, plant population, ground cover are all common sub-samples of a site (feature of interest) in ecological surveys." ;
.

<https://linked.data.gov.au/org/tern>
    a sdo:Organization ;
    sdo:name "TERN" ;
    sdo:sameAs
        <https://grid.ac/institutes/grid.507696.b> ,
        <https://ror.org/03wxseg04> ,
        <https://w3id.org/tern/resources/a083902d-d821-41be-b663-1d7cb33eea66> ;
    sdo:url "https://www.tern.org.au"^^xsd:anyURI ;
.

tern:Value
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "A value of an `Attribute` or an `Observation`. "@en ;
    skos:prefLabel "Value"@en ;
    skos:scopeNote "This is an 'abstract' class and is not intended to be used directly to create individuals." ;
.

ont:
    a owl:Ontology ;
    dcterms:provenance "A domain model for exchanging and representing ecological field survey data. A profile of SSN/SOSA, PROV and schema.org." ;
    owl:imports
        <http://datashapes.org/dash> ,
        <http://qudt.org/schema/qudt/> ,
        <http://rdfs.org/ns/void> ,
        owl: ,
        skos: ,
        time: ,
        dcat: ,
        prov: ,
        sosa: ,
        ssn: ,
        <https://raw.githubusercontent.com/w3c/sdw/gh-pages/ssn-extensions/rdf/ssn-ext.ttl> ;
    owl:versionIRI tern:0.8.0 ;
    owl:versionInfo "0.8.0" ;
    skos:definition "The TERN Ontology comprises a set of vocabularies for representing plot-based ecological data. It was developed primarily based on the SOSA (Sensor, Observation, Sample, and Actuator) ontology. The TERN Ontology's classes and properties have been tailored to describe terrestrial ecology survey data including flora, vegetation and soil, following the methodologies outlined in the Australian Soil and Land Survey Field Handbook."@en ;
    skos:prefLabel "TERN Ontology"@en ;
    sdo:codeRepository "https://github.com/ternaustralia/ontology_tern"^^xsd:anyURI ;
    sdo:contributor
        <https://orcid.org/0000-0002-7083-0005> ,
        <https://orcid.org/0000-0002-8481-9069> ,
        <https://orcid.org/0000-0003-0870-3192> ,
        <https://w3id.org/tern/resources/19f47957-556a-41aa-bd38-a9e63c111fcb> ,
        <https://w3id.org/tern/resources/1c1b4f10-23a9-474d-8f45-2d4c27db863e> ,
        <https://w3id.org/tern/resources/cbd72114-5fa0-410a-b6c1-73a3fd8f111e> ;
    sdo:copyrightHolder <https://linked.data.gov.au/org/tern> ;
    sdo:creator
        <https://orcid.org/0000-0002-3884-3420> ,
        <https://orcid.org/0000-0002-3903-254X> ,
        <https://orcid.org/0000-0002-6047-9864> ;
    sdo:dateCreated "2020-09-07"^^xsd:date ;
    sdo:dateIssued "2020-09-07"^^xsd:date ;
    sdo:dateModified "2022-04-26"^^xsd:date ;
    sdo:license "https://creativecommons.org/licenses/by/4.0/"^^xsd:anyURI ;
    sdo:publisher <https://linked.data.gov.au/org/tern> ;
.

[]    a owl:Class ;
    owl:unionOf (
        xsd:string
        xsd:int
    ) ;
.

[]    a owl:Class ;
    owl:unionOf (
        xsd:string
        xsd:int
    ) ;
.
