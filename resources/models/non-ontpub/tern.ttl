# baseURI: https://w3id.org/tern/ontologies/tern/
# imports: http://datashapes.org/dash
# imports: http://qudt.org/schema/qudt/
# imports: http://rdfs.org/ns/void
# imports: http://www.w3.org/2002/07/owl#
# imports: http://www.w3.org/2004/02/skos/core#
# imports: http://www.w3.org/2006/time#
# imports: http://www.w3.org/ns/dcat#
# imports: http://www.w3.org/ns/prov#
# imports: http://www.w3.org/ns/sosa/
# imports: http://www.w3.org/ns/ssn/
# imports: https://raw.githubusercontent.com/w3c/sdw/gh-pages/ssn-extensions/rdf/ssn-ext.ttl
# prefix: tern
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dwc: <http://rs.tdwg.org/dwc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX ont: <https://w3id.org/tern/ontologies/tern>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX reg: <http://purl.org/linked-data/registry#>
PREFIX sdo: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX ssn: <http://www.w3.org/ns/ssn/>
PREFIX ssn-system: <http://www.w3.org/ns/ssn/systems/>
PREFIX tern: <https://w3id.org/tern/ontologies/tern/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

dwc:materialSampleID
    a rdf:Property ;
    rdfs:comment "An identifier for the MaterialSample (as opposed to a particular digital record of the material sample). In the absence of a persistent global unique identifier, construct one from a combination of identifiers in the record that will most closely make the materialSampleID globally unique." ;
    rdfs:isDefinedBy dwc: ;
    skos:example "IGSN:ASR000001 (Resulting URI: http://igsn.org/ASR000001) is a globally unique and persistent identifier of a soil sample." ;
    skos:prefLabel "material sample ID"@en ;
.

time:Duration
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy
        time: ,
        ont: ;
    skos:definition "Duration of a temporal extent expressed as a number scaled by a temporal unit"@en ;
    skos:prefLabel "Duration"@en ;
.

time:Instant
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy
        time: ,
        ont: ;
    skos:definition "A temporal entity with zero extent or duration."@en ;
    skos:prefLabel "Instant"@en ;
.

time:Interval
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy
        time: ,
        ont: ;
    skos:definition "A temporal entity with an extent or duration."@en ;
    skos:prefLabel "Interval"@en ;
.

dcat:DatasetSeries
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy dcat: ;
    rdfs:subClassOf dcat:Dataset ;
    skos:definition "A collection of datasets that are published separately, but share some characteristics that group them."@en ;
    skos:prefLabel "Dataset series"@en ;
.

prov:Association
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy prov: ;
    skos:definition "An activity association is an assignment of responsibility to an agent for an activity, indicating that the agent had a role in the activity. It further allows for a plan to be specified, which is the plan intended by the agent to achieve some goals in the context of this activity."@en ;
    skos:prefLabel "Association"@en ;
    skos:scopeNote "Associate an agent to an activity (`tern:Sampling`, `tern:Observation`) with a role from link:http://def.isotc211.org/iso19115/-1/2018/CitationAndResponsiblePartyInformation/code/CI_RoleCode[ISO 19115-1's CI Role Code]." ;
.

prov:Attribution
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy prov: ;
    skos:definition "Attribution is the ascribing of an entity to an agent. When an entity `e` is attributed to agent `ag`, entity `e` was generated by some unspecified activity that in turn was associated to agent `ag`. Thus, this relation is useful when the activity is not known, or irrelevant."@en ;
    skos:prefLabel "Attribution"@en ;
    skos:scopeNote "Associate an agent to an entity (`tern:Sample`, `tern:FeatureOfInterest`, `tern:Site`) with a role from link:http://def.isotc211.org/iso19115/-1/2018/CitationAndResponsiblePartyInformation/code/CI_RoleCode[ISO 19115-1's CI Role Code]." ;
.

sosa:isSampleOf
    a owl:TransitiveProperty ;
.

tern:Boolean
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Value ;
    skos:definition "Class to encapsulate a true-or-false value."@en ;
    skos:prefLabel "Boolean"@en ;
.

tern:CategoricalValue
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf skos:Concept ;
    skos:prefLabel "Categorical Value"@en ;
.

tern:CosmOzStation
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:seeAlso <https://cosmoz.csiro.au> ;
    rdfs:subClassOf tern:FixedPlatform ;
    skos:definition """CosmOz is the Australian Cosmic-Ray Neutron Soil Moisture Monitoring Network
Beginning in October 2010, CSIRO Land and Water installed cosmic-ray probes at a number of locations around Australia to form the inaugural CosmOz network. These sites were established at instrumented research sites operated by CSIRO and University collaborators to test and validate the operation of this new technology.
These novel probes use cosmic rays originating from outer space to measure average soil moisture over an area of about 30 hectares to depths in the soil of between 10 to 50 cm. This constitutes a quantum leap over conventional on-ground soil moisture sensing technology that can only measure soil moisture content within small volumes of soil.
Each system is comprised of a data logger, neutron detector, satellite telemetry, tipping bucket rain gauge, temperature humidity and pressure sensors and three surface moisture (TDR) probes. The system requires minimal maintenance and is powered by a solar charging system. The entire system is installed on a single mast. Data is logged and transmitted every 60 minutes to the CosmOz database.""" ;
    skos:editorialNote "Currently used by the platforms index for SHaRED." ;
    skos:prefLabel "CosmOz Station"@en ;
.

tern:Dataset
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf dcat:Dataset ;
    skos:definition "A collection of data, published or curated by a single agent, and available for access or download in one or more representations."@en ;
    skos:prefLabel "Dataset"@en ;
    skos:scopeNote
        "This class describes the actual dataset as published by the dataset provider. In cases where a distinction between the actual dataset and its entry in the catalog is necessary (because metadata such as modification date might differ), the catalog record class can be used for the latter." ,
        "This class describes the conceptual dataset. One or more representations might be available, with differing schematic layouts and formats or serializations." ;
.

tern:Date
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Value ;
    skos:definition "A class to encapsulate an `xsd:date` value."@en ;
    skos:prefLabel "Date"@en ;
.

tern:DateTime
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Value ;
    skos:definition "A class to encapsulate an `xsd:dateTime` value."@en ;
    skos:prefLabel "Date time"@en ;
.

tern:Deployment
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf ssn:Deployment ;
    skos:definition "Describes the Deployment of one or more Systems for a particular purpose. Deployment may be done on a Platform."@en ;
    skos:example "For example, a temperature Sensor deployed on a wall, or a whole network of Sensors deployed for an Observation campaign." ;
    skos:prefLabel "Deployment"@en ;
.

tern:DigitalCamera
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "The model as defined by the manufacturer."@en ;
    skos:example "E.g. EOS 350D" ;
    skos:prefLabel "Digital Camera"@en ;
.

tern:Dimension
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    owl:deprecated true ;
    skos:definition "The dimension of a 2D square or rectangular feature. Example, the dimension of a rectangular plot Site. This class should perhaps have specialised classes to express not just square or rectangular features but also others such as circular features."@en ;
    skos:prefLabel "Dimension"@en ;
.

tern:Distribution
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf dcat:Distribution ;
    skos:definition "A specific representation of a dataset. A dataset might be available in multiple serializations that may differ in various ways, including natural language, media-type or format, schematic organization, temporal and spatial resolution, level of detail or profiles (which might specify any or all of the above)."@en ;
    skos:example """Examples of distributions include a CSV file, a [netCDF] file, a JSON document, or a data-cube, files made accessible according to different profiles, such as XML or JSON schemas or [ShEx] or [SHACL] expressions.

In some cases all distributions of a dataset will be fully informationally equivalent, in the sense that lossless transformations between the representations are possible. An example would be different serializations of an RDF graph using RDF/XML [RDF-SYNTAX-GRAMMAR], [Turtle], [N3], [JSON-LD]. However, in other cases the distributions might have different levels of fidelity to the underlying data. For example, a graphical representation about the data on a CSV file may not contain the same total information recorded in the CSV file, but they could be considered as two distributions for the same dataset as they are about the same data.

As a counter-example, budget data for different years would usually be modelled as different datasets, each with their own distributions, since all distributions of one dataset should broadly contain the same data.

Nevertheless, the question of whether different representations can be understood to be distributions of the same dataset, or distributions of different datasets, is application specific. Judgement about how to describe them is the responsibility of the provider, taking into account their understanding of the expectations of users, and practices in the relevant community.""" ;
    skos:prefLabel "Distribution"@en ;
    skos:scopeNote "This represents a general availability of a dataset. It implies no information about the actual access method of the data, i.e. whether by direct download, API, or through a Web page. The use of dcat:downloadURL property indicates directly downloadable distributions." ;
.

tern:EarthObservationSatellite
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:seeAlso <https://gcmd.earthdata.nasa.gov/kms/concept/3466eed1-2fbb-49bf-ab0b-dc08731d502b> ;
    rdfs:subClassOf tern:MobilePlatform ;
    skos:definition "Earth observation satellites are satellites specifically designed to observe Earth from orbit, similar to spy satellites but intended for non-military uses such as environmental monitoring, meteorology, map making etc. Source: Wikipedia, http://en.wikipedia.org/wiki/Earth_observation_satellite Group: Platform_Details Entry_ID: Earth Observation Satellites Group: Platform_Identification Platform_Category: Earth Observation Satellites Short_Name: Earth Observation Satellites End_Group End_Group"@en ;
    skos:prefLabel "Earth Observation Satellite"@en ;
.

tern:EcosystemProcessesSite
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Site ;
    skos:definition "An ecological Site that usually hosts a Flux Tower."@en ;
    skos:prefLabel "Ecosystem Processes Site"@en ;
.

tern:Float
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:seeAlso sdo:Float ;
    rdfs:subClassOf tern:Value ;
    skos:definition "A class to encapsulate a float."@en ;
    skos:prefLabel "Float"@en ;
.

tern:FluxTower
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:FixedPlatform ;
    skos:definition "Across the globe, towers stand among the landscape, with sensors monitoring these eddies for carbon dioxide, water vapor and other gasses.  These so-called flux towers collect data on carbon dioxide exchange rates between the earth and atmosphere."@en ;
    skos:example
        <https://w3id.org/tern/resources/fd2809a2-e705-4961-b09c-7e9ae1ffa87e> ,
        "Alice Springs Mulga flux tower" ;
    skos:prefLabel "Flux Tower"@en ;
.

tern:IRI
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Value ;
    skos:definition "A class to encapsulate an IRI value."@en ;
    skos:prefLabel "IRI"@en ;
.

tern:Input
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf ssn:Input ;
    skos:definition "*Input* - Any information that is provided to a Procedure for its use."@en ;
    skos:example """A **wedge prism** or **relascope** can be used to estimate the Basal Area per hectare.
The number of counted trees and the Basal Area Factor are inputs to estimate the Basal Area.""" ;
    skos:prefLabel "Input"@en ;
.

tern:Integer
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:seeAlso sdo:Integer ;
    rdfs:subClassOf tern:Value ;
    skos:definition "A class to encapsulate an integer value."@en ;
    skos:prefLabel "Integer"@en ;
.

tern:Intervention
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        prov:Activity ,
        sosa:Actuation ;
    skos:definition "An `Intervention` is a human-induced activity that carries out a `Procedure` to observe or change the properties of a `Feature Of Interest`."@en ;
    skos:example "Controlled burns, breeding programs, weed and debris removal, installation of new structures, etc." ;
    skos:prefLabel "Intervention"@en ;
    skos:scopeNote "An intervention is a management process to maintain, restore or improve an ecosystem within a spatial area." ;
.

tern:ManagedFeature
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    skos:prefLabel "Feature which is managed for TERN purposes"@en ;
.

tern:MaterialSample
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        dwc:MaterialSample ,
        tern:Sample ;
    skos:definition "A physical result of a sampling (or subsampling) event. In biological collections, the material sample is typically collected, and either preserved or destructively processed."@en ;
    skos:example "A whole organism preserved in a collection. A part of an organism isolated for some purpose. A soil sample. A marine microbial sample." ;
    skos:prefLabel "Material sample"@en ;
.

tern:MeasurementRange
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        ssn-system:MeasurementRange ,
        ssn-system:SystemProperty ;
    skos:definition "The set of values that the Sensor can return as the Result of an Observation under the defined Conditions with the defined system properties."@en ;
    skos:example "For example, a temperature sensor that can measure temperatures between -40°C and +80°C, or a humidity sensor that can measure relative humidity from 0% to 100%." ;
    skos:prefLabel "Measurement Range"@en ;
.

tern:Method
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:scopeNote "We recommend representing the method information following [ISO 9001 Processes, Procedures and Work Instructions](https://the9000store.com/wp-content/uploads/2016/08/iso-9001-procedure.pdf)" ;
    rdfs:seeAlso
        <https://apps.usgs.gov/thesaurus/term-simple.php?thcode=2&code=376> ,
        <https://the9000store.com/iso-9001-2015-requirements/iso-9001-2015-context-of-the-organization/processes-procedures-work-instructions/> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A Method describes in detailed steps how a workflow, protocol, plan or algorithm is carried out to make an Observation or a Sample. It explains the steps to be carried out to arrive at reproducible Result."@en ;
    skos:example """Borehole logging is a field method in which
in situ physical measurements (e.g., temperature) are made down the
length of a borehole by lowering measurement instruments down the borehole via cable. (Credit: PaST Thesaurus)""" ;
    skos:prefLabel "Method"@en ;
.

tern:ObservableProperty
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf sosa:ObservableProperty ;
    skos:definition "An observable quality (property, characteristic) of a [FeatureOfInterest](http://w3.org/ns/sosa/FeatureOfInterest). A feature-of-interest refers to a feature whose properties are measured or observed. "@en ;
    skos:example """Sampling depth, bulk density, pH are examples of properties of a
soil sample, and the soil sample is the feature-of-interest,
representative of the area from which it is collected.""" ;
    skos:prefLabel "Observable Property"@en ;
.

tern:ObservationCollection
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf sosa:ObservationCollection ;
    skos:definition "Collection of one or more observations, whose members share a common value for one or more property"@en ;
    skos:prefLabel "Observation collection"@en ;
.

tern:OnlineResource
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf rdfs:Resource ;
    skos:definition "Online resources, e.g. additional documentation for datasets."@en ;
    skos:prefLabel "Online Resource"@en ;
.

tern:Parameter
    a owl:Class ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "A [FeatureOfInterest's](http://w3.org/ns/sosa/FeatureOfInterest) property or characteristic which an Observation is measuring using some Procedure."@en ;
    skos:prefLabel "Parameter"@en ;
.

tern:Procedure
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf sosa:Procedure ;
    skos:definition "A workflow, protocol, plan, algorithm, or computational method specifying how to make an Observation, create a Sample, or make a change to the state of the world (via an [Actuator](http://w3.org/ns/sosa/Actuator). A Procedure is re-usable, and might be involved in many Observation, Sampling, or [Actuations](http://w3.org/ns/sosa/Actuation). it explains the steps to be carried out to arrive at a reproducible Result."@en ;
    skos:example """The procedure for collecting photopoints are specified in the
[AusPlots Rangelands Survey Protocols Manual](http://dx.doi.org/10.13140/2.1.4287.3607).
The DEC Nature Conservation Service Biodiversity have defined
[standard procedures](https://www.dpaw.wa.gov.au/images/documents/plants-animals/monitoring/sop/sop_establishingvegetationquadrats_20090818_v1.0.pdf)
for establishing quadrats for vegetation sampling.""" ;
    skos:prefLabel "Procedure"@en ;
    skos:scopeNote "Input can be used to capture any input values for a procedure, such as the input value of the basal wedge to estimate the basal area per hectare." ;
.

tern:RDFDataset
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        void:Dataset ,
        rdfs:Resource ;
    skos:definition "A set of RDF triples that are published, maintained or aggregated by a single provider."@en ;
    skos:prefLabel "RDFDataset"@en ;
    skos:scopeNote "This is a specialised version of the `void:Dataset` class where it may be constrained by additional property shapes in the future." ;
.

tern:Sampler
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        sosa:Sampler ,
        tern:System ;
    skos:definition "A device that is used by, or implements, a (`Sampling`) `Procedure` to create or transform one or more samples."@en ;
    skos:prefLabel "Sampler"@en ;
    skos:scopeNote "A ball mill, diamond drill, hammer, hypodermic syringe and needle, image Sensor or a soil auger can all act as sampling devices (i.e., be Samplers). However, sometimes the distinction between the Sampler and the Sensor is not evident, as they are packaged as a unit. A Sampler need not be a physical device." ;
.

tern:Sensor
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf
        sosa:Sensor ,
        tern:System ;
    skos:definition "Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms."@en ;
    skos:prefLabel "Sensor"@en ;
.

tern:Taxon
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Value ;
    skos:definition "A group of organisms (sensu http://purl.obolibrary.org/obo/OBI_0100026) considered by taxonomists to form a homogeneous unit."@en ;
    skos:prefLabel "Taxon"@en ;
    skos:scopeNote "The genus Truncorotaloides as published by Bronnimann et al. in 1953 in the Journal of Paleontology Vol. 27(6) p. 817-820." ;
.

tern:Text
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Value ;
    skos:definition "Class to encapsulate a textual value."@en ;
    skos:prefLabel "Text"@en ;
.

tern:Transect
    a owl:Class ;
    reg:status reg:statusStable ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf tern:Sample ;
    skos:definition "A transect is a path where observations and samplings may occur."@en ;
    skos:prefLabel "Transect"@en ;
    skos:scopeNote "There are several types of transects in ecology such as strip transects, line transects, belt transects, point transects and curved line transects." ;
.

tern:VerticalExtent
    a owl:Class ;
    reg:status reg:statusExperimental ;
    rdfs:isDefinedBy ont: ;
    rdfs:subClassOf <http://sweetontology.net/propSpaceHeight/VerticalExtent> ;
    skos:definition "A class representing the vertical extent of an object or phenomenon in a given context."@en ;
    skos:example "The vertical extent of a mountain range." ;
    skos:prefLabel "Vertical Extent"@en ;
.

tern:area
    a rdf:Property ;
    skos:definition "The extent of a Site area, e.g., in m2"@en ;
    skos:example " The area of the Mitchell Grass Rangeland SuperSite Supersite is approximately 47 M (million) ha." ;
    skos:prefLabel "area"@en ;
.

tern:attribute
    a rdf:Property ;
    rdfs:range skos:Concept ;
    skos:definition "Point to a concept representing the attribute."@en ;
    skos:prefLabel "attribute"@en ;
.

tern:calibratedBy
    a rdf:Property ;
    skos:definition "The entity that calibrates a System."@en ;
    skos:example "The temperature sensor was calibrated by TERN's calibration laboratory on 2024-01-15." ;
    skos:prefLabel "calibrated by"@en ;
.

tern:calibrationActualResult
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Value ;
    skos:definition "Links to the actual measured value obtained during calibration. This represents the value returned by the system or device being calibrated."@en ;
    skos:prefLabel "calibration actual result"@en ;
.

tern:calibrationOffset
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Value ;
    skos:definition "Links to a value representing the difference between the reference and actual results during calibration. This offset can be used for measurement corrections."@en ;
    skos:prefLabel "calibration offset"@en ;
.

tern:calibrationReferenceResult
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Value ;
    skos:definition "Links to a reference value used during calibration. This represents the known, standard, or expected value against which the actual measurement is compared."@en ;
    skos:prefLabel "calibration reference result"@en ;
.

tern:cardinalDirection
    a rdf:Property ;
    rdfs:range xsd:string ;
    skos:definition "The cardinal direction of the *thing* represented as a string and expressed by cardinal and intercardinal points. "@en ;
    skos:example "NNE, W, SE, etc." ;
    skos:prefLabel "cardinal direction"@en ;
.

tern:centroidPoint
    a rdf:Property ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_centroids> ;
    rdfs:subPropertyOf geo:hasGeometry ;
    owl:deprecated true ;
    skos:definition "The centroid point of an object-of-interest."@en ;
    skos:example """The geometric center of 1-ha vegetation plot expressed
as [sf:Point](http://www.opengis.net/ont/sf#Point).""" ;
    skos:prefLabel "centroid point"@en ;
.

tern:climateCode
    a rdf:Property ;
    rdfs:seeAlso <https://fluxnet.org/data/badm-data-templates/koppen-climate-classification/> ;
    skos:definition "The Köppen Climate Classification code that categorizes climates based on temperature, precipitation, and seasonal patterns. It was developed by Wladimir Köppen in 1884 and has been refined over time."@en ;
    skos:example "Bwh - Desert: warm winter" ;
    skos:prefLabel "Köppen climate code"@en ;
.

tern:collaborator
    a rdf:Property ;
    skos:definition "The collaborator of a project."@en ;
    skos:example "Alice Smith is one of collaborators for ant survey project." ;
    skos:prefLabel "collaborator"@en ;
.

tern:dataManager
    a rdf:Property ;
    skos:definition "The data manager of a project, platform or system."@en ;
    skos:example "Alice Smith is one of data managers for ant survey project." ;
    skos:prefLabel "data manager"@en ;
.

tern:dateCommissioned
    a rdf:Property ;
    skos:definition "The date when, e.g., a Site is ready to commence its operations, after it is successfully installed and tested."@en ;
    skos:example """1 August 2017 is the date commisioned of the
[Collie flux station](http://ozflux.org.au/monitoringsites/collie/index.html)""" ;
    skos:prefLabel "date commissioned"@en ;
    skos:scopeNote "Use ISO 8601 international standard for representing dates and times. Missing start date may be set to the first of the month." ;
.

tern:dateDecommissioned
    a rdf:Property ;
    skos:definition "The date when, e.g., a Site is decommissioned or stopped operating."@en ;
    skos:example """30 Nov 2019 is the date decommisioned of the
[Collie flux station](http://ozflux.org.au/monitoringsites/collie/index.html)""" ;
    skos:prefLabel "date decommissioned"@en ;
    skos:scopeNote "Use ISO 8601 international standard for representing dates and times. Missing end date may be set to the end of the month." ;
.

tern:dimension
    a rdf:Property ;
    skos:definition "Dimension in metres."@en ;
    skos:example "100x100" ;
    skos:prefLabel "dimension"@en ;
.

tern:domain
    a rdf:Property ;
    skos:definition "The domain of the observation."@en ;
    skos:example "Vegetation, soil, disturbance, landform, etc." ;
    skos:prefLabel "domain"@en ;
.

tern:editor
    a rdf:Property ;
    skos:definition "The editor of a dataset."@en ;
    skos:example "Alice Smith is one of editors for ant survey dataset." ;
    skos:prefLabel "editor"@en ;
.

tern:environmentDescription
    a rdf:Property ;
    skos:definition "The environment description of a dataset."@en ;
    skos:example "A dataset collected from weather monitoring stations across the country." ;
    skos:prefLabel "environment description"@en ;
.

tern:equipment
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "Describe the equipment used as text."@en ;
    skos:prefLabel "equipment"@en ;
.

tern:featureType
    a owl:ObjectProperty ;
    rdfs:domain tern:FeatureOfInterest ;
    rdfs:isDefinedBy ont: ;
    rdfs:range skos:Concept ;
    skos:definition "The feature type of a [Feature of Interest](#FeatureofInterest)."@en ;
    skos:prefLabel "feature type"@en ;
.

tern:fluxnetID
    a rdf:Property ;
    rdfs:seeAlso <https://fluxnet.org/> ;
    skos:definition "The unique identifier for flux towers registered with FLUXNET."@en ;
    skos:example "AU-ASM" ;
    skos:prefLabel "fluxnet ID"@en ;
.

tern:funder
    a rdf:Property ;
    skos:definition "The funder of a project."@en ;
    skos:example "Environment department is one of funders for ant survey project." ;
    skos:prefLabel "funder"@en ;
.

tern:globalValue
    a rdf:Property ;
    skos:definition "A property that links a concept from a vocabulary to another concept in an authoritative/endorsed vocabulary."@en ;
    skos:example """The concept dry soil colour is defined in two vocabularies,
[CORVEG](http://linked.data.gov.au/def/corveg-cv/1842b772-72a4-430f-a264-dcfd6c2c23b4) and
[Ausplots](http://linked.data.gov.au/def/ausplots-cv/aa11e5f7-aec2-4e92-95b8-6332911f0c4e).
The property global value is used to map the concept from the two vocabularies to the relevant
[concept](http://linked.data.gov.au/def/tern-cv/beceaa5a-a296-4385-a55a-3b8c8d5b2369)
specified in the main vocabulary, i.e., TERN Vocabularies.""" ;
    skos:prefLabel "global value"@en ;
.

tern:globalVocabulary
    a rdf:Property ;
    skos:definition "The global vocabulary refers to the main vocabulary, which takes precedence over other similar vocabularies to promote data harmonisation."@en ;
    skos:prefLabel "global vocabulary"@en ;
.

tern:hasCalibration
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Calibration ;
    skos:definition "A link to a [tern:Calibration](https://w3id.org/tern/ontologies/tern/Calibration) which represents a calibration activity performed on this System's properties to ensure accurate measurements and proper functioning."@en ;
    skos:prefLabel "has calibration"@en ;
.

tern:hasCategoricalCollection
    a rdf:Property ;
    skos:definition "A property that links a concept to a collection containing its categorical values."@en ;
    skos:prefLabel "has categorical collection"@en ;
.

tern:hasEnvironmentalCharacteristic
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "The subject has some environmental characteristic. Points to a set of Observations within an EnvironmentalCharacteristic."@en ;
    skos:prefLabel "has environmental characteristic"@en ;
.

tern:hasFeatureType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:subPropertyOf skos:relatedMatch ;
    skos:definition "Links a concept to a feature type."@en ;
    skos:prefLabel "has feature type"@en ;
.

tern:hasIGSN
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:IGSN ;
    skos:definition "A link to a [tern:IGSN](https://w3id.org/tern/ontologies/tern/IGSN) which represents a globally unique identifier assigned to physical samples to enable traceability, citation, and reuse in scientific research, adhering to FAIR data principles."@en ;
    skos:prefLabel "has IGSN"@en ;
.

tern:hasObservation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Observation ;
    skos:definition "Link to an Observation."@en ;
    skos:prefLabel "has observation"@en ;
.

tern:hasObservationTheme
    a rdf:Property ;
    rdfs:subPropertyOf skos:relatedMatch ;
    skos:definition "Link a concept to an observation theme."@en ;
    skos:prefLabel "has observation theme"@en ;
.

tern:hasParameter
    a rdf:Property ;
    rdfs:subPropertyOf skos:relatedMatch ;
    skos:definition "A property that links a concept to a parameter."@en ;
    skos:prefLabel "has parameter"@en ;
.

tern:hasSampling
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Sampling ;
    skos:definition "Link to a Sampling instance."@en ;
    skos:prefLabel "has sampling"@en ;
.

tern:hasSimpleValue
    a rdf:Property ;
    skos:definition "The direct link to the value either as an IRI or an RDF literal. The simple value is always equivalent to the value captured in [rdf:value](http://www.w3.org/1999/02/22-rdf-syntax-ns#value) of the tern:Value instance."@en ;
    skos:example "An IRI, true, false, 1, \"string\", or a \"string with language\"@en, etc." ;
    skos:prefLabel "has simple value"@en ;
.

tern:hasSiteVisit
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:SiteVisit ;
    skos:definition "A property that links, e.g., a Site to a [Site Visit](#EcologicalSiteVisit)."@en ;
    skos:prefLabel "has site visit"@en ;
.

tern:hasSubActivity
    a rdf:Property ;
    skos:definition "Link to an Observation or Sampling."@en ;
    skos:prefLabel "has sub activity"@en ;
.

tern:hasValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range tern:Value ;
    skos:definition "A link to a [tern:Value](https://w3id.org/tern/ontologies/tern/Value) which encapulates the value of this thing."@en ;
    skos:prefLabel "has value"@en ;
.

tern:igbpCode
    a rdf:Property ;
    rdfs:seeAlso <https://fluxnet.org/data/badm-data-templates/igbp-classification/> ;
    skos:definition "The IGBP classification code that identifies the biome type and land cover characteristics of a flux tower site."@en ;
    skos:example "GRA - Grasslands: Lands with herbaceous types of cover. Tree and shrub cover is less than 10%." ;
    skos:prefLabel "IGBP code"@en ;
.

tern:instructions
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "Describe the instructions of the procedure/method."@en ;
    skos:prefLabel "instructions"@en ;
.

tern:instrumentType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range skos:Concept ;
    skos:definition "The type of instrument used."@en ;
    skos:prefLabel "instrument type"@en ;
.

tern:interventionType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "The type of intervention act."@en ;
    skos:prefLabel "intervention type"@en ;
.

tern:isManagedBy
    a rdf:Property ;
    skos:definition "The entity that manages a platform or system."@en ;
    skos:example "TERN manages sensors." ;
    skos:prefLabel "is managed by"@en ;
.

tern:isOperatedBy
    a rdf:Property ;
    skos:definition "The entity that operates a platform or system."@en ;
    skos:example "TERN operates sensors." ;
    skos:prefLabel "is operated by"@en ;
.

tern:isSiteOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    owl:inverseOf tern:hasSite ;
    skos:prefLabel "is site of"@en ;
.

tern:isSubActivityOf
    a rdf:Property ;
    skos:definition "A property that links an activity to its parent activity."@en ;
    skos:prefLabel "is sub activity of"@en ;
.

tern:length
    a rdf:Property ;
    rdfs:seeAlso <http://qudt.org/vocab/quantitykind/Length> ;
    skos:definition "A measure of distance."@en ;
    skos:prefLabel "length"@en ;
.

tern:localValue
    a rdf:Property ;
    skos:prefLabel "local value"@en ;
.

tern:localVocabulary
    a rdf:Property ;
    rdfs:range
        [
            a owl:Class ;
            owl:unionOf (
                skos:ConceptScheme
                skos:Collection
                owl:Ontology
            ) ;
        ] ;
    skos:prefLabel "local vocabulary"@en ;
.

tern:locationDescription
    a rdf:Property ;
    skos:definition "The description of the location."@en ;
    skos:example """Location description of the AusPlots site NTABRT0004 in the Alice Mulga SuperSite:
Pine Hill Station. 25km South East of Ti-Tree. 20km East of Stuart Highway.
South west corner of the site is 200m north west of proposed supersite flux tower""" ;
    skos:prefLabel "location description"@en ;
.

tern:locationProcedure
    a rdf:Property ;
    rdfs:subPropertyOf tern:hasMethod ;
    skos:definition "Link to a procedure used to obtain the location."@en ;
    skos:prefLabel "location procedure"@en ;
.

tern:manufacturer
    a rdf:Property ;
    skos:definition "The manufacturer of a system."@en ;
    skos:example "The manufacturer of a sensor." ;
    skos:prefLabel "manufacturer"@en ;
.

tern:maxAltitude
    a rdf:Property ;
    skos:definition "The maximum altitude of a vertical extent in a given context."@en ;
    skos:example "The maximum altitude of a mountain range is 1000m." ;
    skos:prefLabel "maximum altitude"@en ;
.

tern:methodType
    a rdf:Property ;
    skos:definition "A particular method type used to conduct some survey."@en ;
    skos:prefLabel "method type"@en ;
.

tern:minAltitude
    a rdf:Property ;
    skos:definition "The minimum altitude of a vertical extent in a given context."@en ;
    skos:example "The minimum altitude of a mountain range is 100m." ;
    skos:prefLabel "minimum altitude"@en ;
.

tern:observationType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "The type of observation."@en ;
    skos:example "human observation, machine observation." ;
    skos:prefLabel "observation type"@en ;
.

tern:otherCitationDetails
    a rdf:Property ;
    skos:definition "Other citation details of a dataset."@en ;
    skos:prefLabel "other citation details"@en ;
.

tern:owner
    a rdf:Property ;
    skos:definition "The owner of something."@en ;
    skos:example "Environment department is one of owners for ant survey project." ;
    skos:prefLabel "owner"@en ;
.

tern:ozfluxID
    a rdf:Property ;
    rdfs:seeAlso <https://www.ozflux.org.au/> ;
    skos:definition "The unique identifier for flux towers in the OzFlux network, which provides observations of energy, carbon and water exchange between the atmosphere and Australian/NZ ecosystems."@en ;
    skos:example "YarIrr" ;
    skos:prefLabel "ozflux ID"@en ;
.

tern:platformType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range skos:Concept ;
    skos:definition "The type of platform to conduct surveys."@en ;
    skos:prefLabel "platform type"@en ;
.

tern:principalInvestigator
    a rdf:Property ;
    skos:definition "The principal investigator of a project, platform or system."@en ;
    skos:example "Alice Smith is one of principal investigators for ant survey project." ;
    skos:prefLabel "principal investigator"@en ;
.

tern:producer
    a rdf:Property ;
    skos:definition "The producer of a dataset."@en ;
    skos:example "Alice Smith is one of producers for ant survey dataset." ;
    skos:prefLabel "producer"@en ;
.

tern:purpose
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    skos:definition "Describe the purpose of something."@en ;
    skos:prefLabel "purpose"@en ;
.

tern:resourceSpecificUsage
    a rdf:Property ;
    skos:definition "The specific usage of resources."@en ;
    skos:example "Data analysis for marketing research." ;
    skos:prefLabel "resource specific usage"@en ;
.

tern:resultDateTime
    a owl:DatatypeProperty ;
    skos:definition "The result time is the instant of time when the Observation, Actuation or Sampling activity was completed."@en ;
    skos:note
        "A change request has been submitted to SOSA at https://github.com/w3c/sdw/issues/1338. Once the change request is submitted, this property `tern:resultDateTime` should be deprecated in favour of `sosa:resultTime`." ,
        "At the time of writing (2022-03-02), SOSA specifies `sosa:resultTime` with an `rdfs:range` of `xsd:dateTime`. This means that all values of `sosa:resultTime` must have the datatype `xsd:dateTime`. This is problematic for the BDR because most ecological surveys only have a precision of day and not date time. Ingestion of data may fail due to internal validators from TopQuadrant's EDG." ;
    skos:prefLabel "result date time"@en ;
.

tern:sampleStorageLocation
    a rdf:Property ;
    rdfs:subPropertyOf geo:hasGeometry ;
    skos:definition "A property that links a [PhysicalSpecimen](#PhysicalSpecimen) to the location [Point](http://www.opengis.net/ont/sf#Point) of where it is stored."@en ;
    skos:prefLabel "sample storage location"@en ;
.

tern:sampleSubType
    a owl:ObjectProperty ;
    rdfs:domain tern:IGSN ;
    rdfs:isDefinedBy ont: ;
    rdfs:range skos:Concept ;
    skos:definition "The sample sub type of an [IGSN](#IGSN)."@en ;
    skos:prefLabel "sample sub type"@en ;
.

tern:sampleType
    a owl:ObjectProperty ;
    rdfs:domain tern:IGSN ;
    rdfs:isDefinedBy ont: ;
    rdfs:range skos:Concept ;
    skos:definition "The sample type of an [IGSN](#IGSN)."@en ;
    skos:prefLabel "sample type"@en ;
.

tern:samplingType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "The type of sampling act."@en ;
    skos:prefLabel "sampling type"@en ;
.

tern:scope
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    skos:definition "Describe the scope of something."@en ;
    skos:prefLabel "scope"@en ;
.

tern:shortName
    a owl:AnnotationProperty ;
    skos:prefLabel "short name"@en ;
.

tern:siteDescription
    a rdf:Property ;
    skos:definition "Contextual information is collected at each site. This includes measures of slope an aspect, surface strew and lithology, and information on the grazing and fire history of the site (Credit: TERN AusPlots)."@en ;
    skos:example <http://ozflux.org.au/monitoringsites/alicesprings/alicesprings_description.html> ;
    skos:prefLabel "site description"@en ;
    skos:scopeNote "Value is usually a summary sentence of the site." ;
.

tern:soilClassification
    a rdf:Property ;
    skos:definition "The term used to classify the SoilProfile."@en ;
    skos:prefLabel "soil classification"@en ;
.

tern:soilHorizonClassifier
    a rdf:Property ;
    skos:definition "Soil horizon classifier as defined in the Australian Soil and Land Survey Field Handbook on page 148."@en ;
    skos:prefLabel "soil horizon classifier"@en ;
.

tern:stratum
    a rdf:Property ;
    rdfs:subPropertyOf dcterms:type ;
    skos:definition "A stratum is a distinct, easily seen, layer of foliage and branches of a measurable height."@en ;
    skos:prefLabel "stratum"@en ;
    skos:scopeNote "Value should be from a controlled vocabulary identified by a URI." ;
.

tern:supplementalInformation
    a rdf:Property ;
    skos:definition "The supplemental information of a dataset."@en ;
    skos:example "This dataset includes metadata about the data collection process and quality control measures." ;
    skos:prefLabel "supplemental information"@en ;
.

tern:swPoint
    a rdf:Property ;
    rdfs:subPropertyOf geo:hasGeometry ;
    owl:deprecated true ;
    skos:definition "The south-west point of the subject."@en ;
    skos:prefLabel "sw point"@en ;
.

tern:systemType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range skos:Concept ;
    skos:definition "The type of system. Values are from some controlled vocabulary."@en ;
    skos:prefLabel "system type"@en ;
.

tern:taxon
    a rdf:Property ;
    skos:definition "Taxon classification."@en ;
    skos:prefLabel "taxon"@en ;
    skos:scopeNote "Value should be from a controlled vocabulary identified by a URI." ;
.

tern:technician
    a rdf:Property ;
    skos:definition "The technician of a project, platform or system."@en ;
    skos:example "Alice Smith is one of technicians for ant survey project." ;
    skos:prefLabel "technician"@en ;
.

tern:transectDirection
    a rdf:Property ;
    rdfs:range xsd:string ;
    skos:definition "Describes the direction of the transect."@en ;
    skos:example "S-W" ;
    skos:prefLabel "transect direction"@en ;
.

tern:transectEndPoint
    a rdf:Property ;
    skos:definition "Refers to the [sf:Point](http://www.opengis.net/ont/sf#Point) representing the end of a transect."@en ;
    skos:prefLabel "transect end point"@en ;
.

tern:transectStartPoint
    a rdf:Property ;
    skos:definition "Refers to the [sf:Point](http://www.opengis.net/ont/sf#Point) representing the start of a transect."@en ;
    skos:prefLabel "transect start point"@en ;
.

tern:uncertainty
    a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:seeAlso <https://www.webassign.net/question_assets/unccolphysmechl1/measurements/manual.html> ;
    skos:definition "Uncertainty for a quantitative value."@en ;
    skos:prefLabel "uncertainty"@en ;
    skos:scopeNote "measurement = (best estimate ± uncertainty) units " ;
.

tern:undertakenAfter
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "Relation to Method that should be taken before current one."@en ;
    skos:prefLabel "undertaken after"@en ;
.

tern:undertakenBefore
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "Relation to Method that should be taken after current one."@en ;
    skos:prefLabel "undertaken before"@en ;
.

tern:undertakenComplementarily
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "Relation to Method that could be taken complementarily."@en ;
    skos:prefLabel "undertaken complementarily"@en ;
.

tern:undertakenConcurrently
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "Relation to Method that could be undertaken concurrently."@en ;
    skos:prefLabel "undertaken concurrently"@en ;
.

tern:unit
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    skos:definition "The unit of measure of the value. Use [QUDT units of measure vocabulary](http://qudt.org/vocab/unit/)."@en ;
    skos:prefLabel "unit"@en ;
.

tern:valueType
    a rdf:Property ;
    skos:definition "Relates a Property to a specialisation of tern:Value."@en ;
    skos:example "Use it to describe an instance of sosa:ObservableProperty and its recommended tern:Value type such as tern:QuantitativeMeasure, tern:Boolean, etc." ;
    skos:prefLabel "value type"@en ;
.

tern:verticalExtent
    a rdf:Property ;
    skos:definition "The vertical extent of an object or phenomenon in a given context."@en ;
    skos:example "The vertical extent of a mountain range." ;
    skos:prefLabel "vertical extent"@en ;
.

tern:vocabulary
    a owl:ObjectProperty ;
    rdfs:isDefinedBy ont: ;
    rdfs:range
        [
            a owl:Class ;
            owl:unionOf (
                skos:ConceptScheme
                skos:Collection
                owl:Ontology
            ) ;
        ] ;
    skos:definition "Controlled vocabulary, taxonomy etc."@en ;
    skos:prefLabel "vocabulary"@en ;
.

tern:width
    a rdf:Property ;
    rdfs:seeAlso <http://qudt.org/vocab/quantitykind/Width> ;
    skos:definition "The measurement or extent of something from side to side."@en ;
    skos:prefLabel "width"@en ;
.

